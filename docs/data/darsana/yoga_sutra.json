[
{"reference": "1.1", "sanskrit_iast": "atha yogānuśāsanam ||", "meaning": "अथ योगानुशासनम् ||", "text": "", "title": "prathamaḥ pādaḥ"},
{"reference": "1.2", "sanskrit_iast": "yogaś cittavṛttinirodhaḥ ||", "meaning": "योगश् चित्तवृत्तिनिरोधः ||", "text": ""},
{"reference": "1.3", "sanskrit_iast": "tadā draṣṭuḥ svarūpe 'vasthānam ||", "meaning": "तदा द्रष्टुः स्वरूपे ऽवस्थानम् ||", "text": ""},
{"reference": "1.4", "sanskrit_iast": "vṛttisārūpyam itaratra ||", "meaning": "वृत्तिसारूप्यम् इतरत्र ||", "text": ""},
{"reference": "1.5", "sanskrit_iast": "vṛttayaḥ pañcatayyaḥ kliṣṭākliṣṭāḥ ||", "meaning": "वृत्तयः पञ्चतय्यः क्लिष्टाक्लिष्टाः ||", "text": ""},
{"reference": "1.6", "sanskrit_iast": "pramāṇaviparyayavikalpanidrāsmṛtayaḥ ||", "meaning": "प्रमाणविपर्ययविकल्पनिद्रास्मृतयः ||", "text": ""},
{"reference": "1.7", "sanskrit_iast": "pratyakṣānumānāgamāḥ pramāṇāni ||", "meaning": "प्रत्यक्षानुमानागमाः प्रमाणानि ||", "text": ""},
{"reference": "1.8", "sanskrit_iast": "viparyayo mithyājñānam atadrūpapratiṣṭham ||", "meaning": "विपर्ययो मिथ्याज्ञानम् अतद्रूपप्रतिष्ठम् ||", "text": ""},
{"reference": "1.9", "sanskrit_iast": "śabdajñānānupātī vastuśūnyo vikalpaḥ ||", "meaning": "शब्दज्ञानानुपाती वस्तुशून्यो विकल्पः ||", "text": ""},
{"reference": "1.10", "sanskrit_iast": "abhāvapratyayālambanā vṛttir nidrā ||", "meaning": "अभावप्रत्ययालम्बना वृत्तिर् निद्रा ||", "text": ""},
{"reference": "1.11", "sanskrit_iast": "anubhūtaviṣayāsaṃpramoṣaḥ smṛtiḥ ||", "meaning": "अनुभूतविषयासंप्रमोषः स्मृतिः ||", "text": ""},
{"reference": "1.12", "sanskrit_iast": "abhyāsavairāgyābhyāṃ tannirodhaḥ ||", "meaning": "अभ्यासवैराग्याभ्यां तन्निरोधः ||", "text": ""},
{"reference": "1.13", "sanskrit_iast": "tatra sthitau yatno 'bhyāsaḥ ||", "meaning": "तत्र स्थितौ यत्नो ऽभ्यासः ||", "text": ""},
{"reference": "1.14", "sanskrit_iast": "sa tu dīrghakālanairantaryasatkārāsevito dṛḍhabhūmiḥ ||", "meaning": "स तु दीर्घकालनैरन्तर्यसत्कारासेवितो दृढभूमिः ||", "text": ""},
{"reference": "1.15", "sanskrit_iast": "dṛṣṭānuśravikaviṣayavitṛṣṇasya vaśīkārasaṃjñā vairāgyam ||", "meaning": "दृष्टानुश्रविकविषयवितृष्णस्य वशीकारसंज्ञा वैराग्यम् ||", "text": ""},
{"reference": "1.16", "sanskrit_iast": "tat paraṃ puruṣakhyāter guṇavaitṛṣṇyam ||", "meaning": "तत् परं पुरुषख्यातेर् गुणवैतृष्ण्यम् ||", "text": ""},
{"reference": "1.17", "sanskrit_iast": "vitarkavicārānandāsmitārūpānugamāt saṃprajñātaḥ ||", "meaning": "वितर्कविचारानन्दास्मितारूपानुगमात् संप्रज्ञातः ||", "text": ""},
{"reference": "1.18", "sanskrit_iast": "virāmapratyayābhyāsapūrvaḥ saṃskāraśeṣo 'nyaḥ ||", "meaning": "विरामप्रत्ययाभ्यासपूर्वः संस्कारशेषो ऽन्यः ||", "text": ""},
{"reference": "1.19", "sanskrit_iast": "bhavapratyayo videhaprakṛtilayānām ||", "meaning": "भवप्रत्ययो विदेहप्रकृतिलयानाम् ||", "text": ""},
{"reference": "1.20", "sanskrit_iast": "śraddhāvīryasmṛtisamādhiprajñāpūrvaka itareṣām ||", "meaning": "श्रद्धावीर्यस्मृतिसमाधिप्रज्ञापूर्वक इतरेषाम् ||", "text": ""},
{"reference": "1.21", "sanskrit_iast": "tīvrasaṃvegānām āsannaḥ ||", "meaning": "तीव्रसंवेगानाम् आसन्नः ||", "text": ""},
{"reference": "1.22", "sanskrit_iast": "mṛdumadhyādhimātratvāt tato 'pi viśeṣaḥ ||", "meaning": "मृदुमध्याधिमात्रत्वात् ततो ऽपि विशेषः ||", "text": ""},
{"reference": "1.23", "sanskrit_iast": "īśvarapraṇidhānād vā ||", "meaning": "ईश्वरप्रणिधानाद् वा ||", "text": ""},
{"reference": "1.24", "sanskrit_iast": "kleśakarmavipākāśayair aparāmṛṣṭaḥ puruṣaviśeṣa īśvaraḥ ||", "meaning": "क्लेशकर्मविपाकाशयैर् अपरामृष्टः पुरुषविशेष ईश्वरः ||", "text": ""},
{"reference": "1.25", "sanskrit_iast": "tatra niratiśayaṃ sarvajñabījam ||", "meaning": "तत्र निरतिशयं सर्वज्ञबीजम् ||", "text": ""},
{"reference": "1.26", "sanskrit_iast": "pūrveṣām api guruḥ kālenānavacchedāt ||", "meaning": "पूर्वेषाम् अपि गुरुः कालेनानवच्छेदात् ||", "text": ""},
{"reference": "1.27", "sanskrit_iast": "tasya vācakaḥ praṇavaḥ ||", "meaning": "तस्य वाचकः प्रणवः ||", "text": ""},
{"reference": "1.28", "sanskrit_iast": "tajjapas tadarthabhāvanam ||", "meaning": "तज्जपस् तदर्थभावनम् ||", "text": ""},
{"reference": "1.29", "sanskrit_iast": "tataḥ pratyakcetanādhigamo 'py antarāyābhāvaś ca ||", "meaning": "ततः प्रत्यक्चेतनाधिगमो ऽप्य् अन्तरायाभावश् च ||", "text": ""},
{"reference": "1.30", "sanskrit_iast": "vyādhistyānasaṃśayapramādālasyāviratibhrāntidarśanālabdhabhūmikatvānavasthitatvāni cittavikṣepās te 'ntarāyāḥ ||", "meaning": "व्याधिस्त्यानसंशयप्रमादालस्याविरतिभ्रान्तिदर्शनालब्धभूमिकत्वानवस्थितत्वानि चित्तविक्षेपास् ते ऽन्तरायाः ||", "text": ""},
{"reference": "1.31", "sanskrit_iast": "duḥkhadaurmanasyāṅgamejayatvaśvāsapraśvāsā vikṣepasahabhuvaḥ ||", "meaning": "दुःखदौर्मनस्याङ्गमेजयत्वश्वासप्रश्वासा विक्षेपसहभुवः ||", "text": ""},
{"reference": "1.32", "sanskrit_iast": "tatpratiṣedhārtham ekatattvābhyāsaḥ ||", "meaning": "तत्प्रतिषेधार्थम् एकतत्त्वाभ्यासः ||", "text": ""},
{"reference": "1.33", "sanskrit_iast": "maitrīkaruṇāmuditopekṣāṇāṃ sukhaduḥkhapuṇyāpuṇyaviṣayāṇāṃ bhāvanātaś cittaprasādanam ||", "meaning": "मैत्रीकरुणामुदितोपेक्षाणां सुखदुःखपुण्यापुण्यविषयाणां भावनातश् चित्तप्रसादनम् ||", "text": ""},
{"reference": "1.34", "sanskrit_iast": "pracchardanavidhāraṇābhyāṃ vā prāṇasya ||", "meaning": "प्रच्छर्दनविधारणाभ्यां वा प्राणस्य ||", "text": ""},
{"reference": "1.35", "sanskrit_iast": "viṣayavatī vā pravṛttir utpannā manasaḥ sthitinibandhanī ||", "meaning": "विषयवती वा प्रवृत्तिर् उत्पन्ना मनसः स्थितिनिबन्धनी ||", "text": ""},
{"reference": "1.36", "sanskrit_iast": "viśokā vā jyotiṣmatī ||", "meaning": "विशोका वा ज्योतिष्मती ||", "text": ""},
{"reference": "1.37", "sanskrit_iast": "vītarāgaviṣayaṃ vā cittam ||", "meaning": "वीतरागविषयं वा चित्तम् ||", "text": ""},
{"reference": "1.38", "sanskrit_iast": "svapnanidrājñānālambanaṃ vā ||", "meaning": "स्वप्ननिद्राज्ञानालम्बनं वा ||", "text": ""},
{"reference": "1.39", "sanskrit_iast": "yathābhimatadhyānād vā ||", "meaning": "यथाभिमतध्यानाद् वा ||", "text": ""},
{"reference": "1.40", "sanskrit_iast": "paramāṇuparamamahattvānto 'sya vaśīkāraḥ ||", "meaning": "परमाणुपरममहत्त्वान्तो ऽस्य वशीकारः ||", "text": ""},
{"reference": "1.41", "sanskrit_iast": "kṣīṇavṛtter abhijātasyeva maṇer grahītṛgrahaṇagrāhyeṣu tatsthatadañjanatā samāpattiḥ ||", "meaning": "क्षीणवृत्तेर् अभिजातस्येव मणेर् ग्रहीतृग्रहणग्राह्येषु तत्स्थतदञ्जनता समापत्तिः ||", "text": ""},
{"reference": "1.42", "sanskrit_iast": "tatra śabdārthajñānavikalpaiḥ saṃkīrṇā savitarkā samāpattiḥ ||", "meaning": "तत्र शब्दार्थज्ञानविकल्पैः संकीर्णा सवितर्का समापत्तिः ||", "text": ""},
{"reference": "1.43", "sanskrit_iast": "smṛtipariśuddhau svarūpaśūnyevārthamātranirbhāsā nirvitarkā ||", "meaning": "स्मृतिपरिशुद्धौ स्वरूपशून्येवार्थमात्रनिर्भासा निर्वितर्का ||", "text": ""},
{"reference": "1.44", "sanskrit_iast": "etayaiva savicārā nirvicārā ca sūkṣmaviṣayā vyākhyātā ||", "meaning": "एतयैव सविचारा निर्विचारा च सूक्ष्मविषया व्याख्याता ||", "text": ""},
{"reference": "1.45", "sanskrit_iast": "sūkṣmaviṣayatvaṃ cāliṅgaparyavasānam ||", "meaning": "सूक्ष्मविषयत्वं चालिङ्गपर्यवसानम् ||", "text": ""},
{"reference": "1.46", "sanskrit_iast": "tā eva sabījaḥ samādhiḥ ||", "meaning": "ता एव सबीजः समाधिः ||", "text": ""},
{"reference": "1.47", "sanskrit_iast": "nirvicāravaiśāradye 'dhyātmaprasādaḥ ||", "meaning": "निर्विचारवैशारद्ये ऽध्यात्मप्रसादः ||", "text": ""},
{"reference": "1.48", "sanskrit_iast": "ṛtaṃbharā tatra prajñā ||", "meaning": "ऋतंभरा तत्र प्रज्ञा ||", "text": ""},
{"reference": "1.49", "sanskrit_iast": "śrutānumānaprajñābhyām anyaviṣayā viśeṣārthatvāt ||", "meaning": "श्रुतानुमानप्रज्ञाभ्याम् अन्यविषया विशेषार्थत्वात् ||", "text": ""},
{"reference": "1.50", "sanskrit_iast": "tajjaḥ saṃskāro 'nyasaṃskārapratibandhī ||", "meaning": "तज्जः संस्कारो ऽन्यसंस्कारप्रतिबन्धी ||", "text": ""},
{"reference": "1.51", "sanskrit_iast": "tasyāpi nirodhe sarvanirodhān nirbījaḥ samādhiḥ ||", "meaning": "तस्यापि निरोधे सर्वनिरोधान् निर्बीजः समाधिः ||", "text": ""},
{"reference": "2.1", "sanskrit_iast": "tapaḥsvādhyāyeśvarapraṇidhānāni kriyāyogaḥ ||", "meaning": "तपःस्वाध्यायेश्वरप्रणिधानानि क्रियायोगः ||", "text": "", "title": "dvitīyaḥ pādaḥ"},
{"reference": "2.2", "sanskrit_iast": "samādhibhāvanārthaḥ kleśatanūkaraṇārthaś ca ||", "meaning": "समाधिभावनार्थः क्लेशतनूकरणार्थश् च ||", "text": ""},
{"reference": "2.3", "sanskrit_iast": "avidyāsmitārāgadveṣābhiniveśāḥ kleśāḥ ||", "meaning": "अविद्यास्मितारागद्वेषाभिनिवेशाः क्लेशाः ||", "text": ""},
{"reference": "2.4", "sanskrit_iast": "avidyā kṣetram uttareṣāṃ prasuptatanuvicchinnodārāṇām ||", "meaning": "अविद्या क्षेत्रम् उत्तरेषां प्रसुप्ततनुविच्छिन्नोदाराणाम् ||", "text": ""},
{"reference": "2.5", "sanskrit_iast": "anityāśuciduḥkhānātmasu nityaśucisukhātmakhyātir avidyā ||", "meaning": "अनित्याशुचिदुःखानात्मसु नित्यशुचिसुखात्मख्यातिर् अविद्या ||", "text": ""},
{"reference": "2.6", "sanskrit_iast": "dṛgdarśanaśaktyor ekātmatevāsmitā ||", "meaning": "दृग्दर्शनशक्त्योर् एकात्मतेवास्मिता ||", "text": ""},
{"reference": "2.7", "sanskrit_iast": "sukhānuśayī rāgaḥ ||", "meaning": "सुखानुशयी रागः ||", "text": ""},
{"reference": "2.8", "sanskrit_iast": "duḥkhānuśayī dveṣaḥ ||", "meaning": "दुःखानुशयी द्वेषः ||", "text": ""},
{"reference": "2.9", "sanskrit_iast": "svarasavāhī viduṣo 'pi tathā rūḍho 'bhiniveśaḥ ||", "meaning": "स्वरसवाही विदुषो ऽपि तथा रूढो ऽभिनिवेशः ||", "text": ""},
{"reference": "2.10", "sanskrit_iast": "te pratiprasavaheyāḥ sūkṣmāḥ ||", "meaning": "ते प्रतिप्रसवहेयाः सूक्ष्माः ||", "text": ""},
{"reference": "2.11", "sanskrit_iast": "dhyānaheyās tadvṛttayaḥ ||", "meaning": "ध्यानहेयास् तद्वृत्तयः ||", "text": ""},
{"reference": "2.12", "sanskrit_iast": "kleśamūlaḥ karmāśayo dṛṣṭādṛṣṭajanmavedanīyaḥ ||", "meaning": "क्लेशमूलः कर्माशयो दृष्टादृष्टजन्मवेदनीयः ||", "text": ""},
{"reference": "2.13", "sanskrit_iast": "sati mūle tadvipāko jātyāyurbhogāḥ ||", "meaning": "सति मूले तद्विपाको जात्यायुर्भोगाः ||", "text": ""},
{"reference": "2.14", "sanskrit_iast": "te hlādaparitāpaphalāḥ puṇyāpuṇyahetutvāt ||", "meaning": "ते ह्लादपरितापफलाः पुण्यापुण्यहेतुत्वात् ||", "text": ""},
{"reference": "2.15", "sanskrit_iast": "pariṇāmatāpasaṃskāraduḥkhair guṇavṛttivirodhāc ca duḥkham eva sarvaṃ vivekinaḥ ||", "meaning": "परिणामतापसंस्कारदुःखैर् गुणवृत्तिविरोधाच् च दुःखम् एव सर्वं विवेकिनः ||", "text": ""},
{"reference": "2.16", "sanskrit_iast": "heyaṃ duḥkham anāgatam ||", "meaning": "हेयं दुःखम् अनागतम् ||", "text": ""},
{"reference": "2.17", "sanskrit_iast": "draṣṭṛdṛśyayoḥ saṃyogo heyahetuḥ ||", "meaning": "द्रष्टृदृश्ययोः संयोगो हेयहेतुः ||", "text": ""},
{"reference": "2.18", "sanskrit_iast": "prakāśakriyāsthitiśīlaṃ bhūtendriyātmakaṃ bhogāpavargārthaṃ dṛśyam ||", "meaning": "प्रकाशक्रियास्थितिशीलं भूतेन्द्रियात्मकं भोगापवर्गार्थं दृश्यम् ||", "text": ""},
{"reference": "2.19", "sanskrit_iast": "viśeṣāviśeṣaliṅgamātrāliṅgāni guṇaparvāṇi ||", "meaning": "विशेषाविशेषलिङ्गमात्रालिङ्गानि गुणपर्वाणि ||", "text": ""},
{"reference": "2.20", "sanskrit_iast": "draṣṭā dṛśimātraḥ śuddho 'pi pratyayānupaśyaḥ ||", "meaning": "द्रष्टा दृशिमात्रः शुद्धो ऽपि प्रत्ययानुपश्यः ||", "text": ""},
{"reference": "2.21", "sanskrit_iast": "tadartha eva dṛśyasyātmā ||", "meaning": "तदर्थ एव दृश्यस्यात्मा ||", "text": ""},
{"reference": "2.22", "sanskrit_iast": "kṛtārthaṃ prati naṣṭam apy anaṣṭaṃ tadanyasādhāraṇatvāt ||", "meaning": "कृतार्थं प्रति नष्टम् अप्य् अनष्टं तदन्यसाधारणत्वात् ||", "text": ""},
{"reference": "2.23", "sanskrit_iast": "svasvāmiśaktyoḥ svarūpopalabdhihetuḥ saṃyogaḥ ||", "meaning": "स्वस्वामिशक्त्योः स्वरूपोपलब्धिहेतुः संयोगः ||", "text": ""},
{"reference": "2.24", "sanskrit_iast": "tasya hetur avidyā ||", "meaning": "तस्य हेतुर् अविद्या ||", "text": ""},
{"reference": "2.25", "sanskrit_iast": "tadabhāvāt saṃyogābhāvo hānaṃ taddṛśeḥ kaivalyam ||", "meaning": "तदभावात् संयोगाभावो हानं तद्दृशेः कैवल्यम् ||", "text": ""},
{"reference": "2.26", "sanskrit_iast": "vivekakhyātir aviplavā hānopāyaḥ ||", "meaning": "विवेकख्यातिर् अविप्लवा हानोपायः ||", "text": ""},
{"reference": "2.27", "sanskrit_iast": "tasya saptadhā prāntabhūmiḥ prajñā ||", "meaning": "तस्य सप्तधा प्रान्तभूमिः प्रज्ञा ||", "text": ""},
{"reference": "2.28", "sanskrit_iast": "yogāṅgānuṣṭhānād aśuddhikṣaye jñānadīptir ā vivekakhyāteḥ ||", "meaning": "योगाङ्गानुष्ठानाद् अशुद्धिक्षये ज्ञानदीप्तिर् आ विवेकख्यातेः ||", "text": ""},
{"reference": "2.29", "sanskrit_iast": "yamaniyamāsanaprāṇāyāmapratyāhāradhāraṇādhyānasamādhayo 'ṣṭāv aṅgāni ||", "meaning": "यमनियमासनप्राणायामप्रत्याहारधारणाध्यानसमाधयो ऽष्टाव् अङ्गानि ||", "text": ""},
{"reference": "2.30", "sanskrit_iast": "ahiṃsāsatyāsteyabrahmacaryāparigrahā yamāḥ ||", "meaning": "अहिंसासत्यास्तेयब्रह्मचर्यापरिग्रहा यमाः ||", "text": ""},
{"reference": "2.31", "sanskrit_iast": "jātideśakālasamayānavacchinnāḥ sārvabhaumā mahāvratam ||", "meaning": "जातिदेशकालसमयानवच्छिन्नाः सार्वभौमा महाव्रतम् ||", "text": ""},
{"reference": "2.32", "sanskrit_iast": "śaucasaṃtoṣatapaḥsvādhyāyeśvarapraṇidhānāni niyamāḥ ||", "meaning": "शौचसंतोषतपःस्वाध्यायेश्वरप्रणिधानानि नियमाः ||", "text": ""},
{"reference": "2.33", "sanskrit_iast": "vitarkabādhane pratipakṣabhāvanam ||", "meaning": "वितर्कबाधने प्रतिपक्षभावनम् ||", "text": ""},
{"reference": "2.34", "sanskrit_iast": "vitarkā hiṃsādayaḥ kṛtakāritānumoditā lobhakrodhamohapūrvakā mṛdumadhyādhimātrā duḥkhājñānānantaphalā iti pratipakṣabhāvanam ||", "meaning": "वितर्का हिंसादयः कृतकारितानुमोदिता लोभक्रोधमोहपूर्वका मृदुमध्याधिमात्रा दुःखाज्ञानानन्तफला इति प्रतिपक्षभावनम् ||", "text": ""},
{"reference": "2.35", "sanskrit_iast": "ahiṃsāpratiṣṭhāyāṃ tatsaṃnidhau vairatyāgaḥ ||", "meaning": "अहिंसाप्रतिष्ठायां तत्संनिधौ वैरत्यागः ||", "text": ""},
{"reference": "2.36", "sanskrit_iast": "satyapratiṣṭhāyāṃ kriyāphalāśrayatvam ||", "meaning": "सत्यप्रतिष्ठायां क्रियाफलाश्रयत्वम् ||", "text": ""},
{"reference": "2.37", "sanskrit_iast": "asteyapratiṣṭhāyāṃ sarvaratnopasthānam ||", "meaning": "अस्तेयप्रतिष्ठायां सर्वरत्नोपस्थानम् ||", "text": ""},
{"reference": "2.38", "sanskrit_iast": "brahmacaryapratiṣṭhāyāṃ vīryalābhaḥ ||", "meaning": "ब्रह्मचर्यप्रतिष्ठायां वीर्यलाभः ||", "text": ""},
{"reference": "2.39", "sanskrit_iast": "aparigrahasthairye janmakathaṃtāsaṃbodhaḥ ||", "meaning": "अपरिग्रहस्थैर्ये जन्मकथंतासंबोधः ||", "text": ""},
{"reference": "2.40", "sanskrit_iast": "śaucāt svāṅgajugupsā parair asaṃsargaḥ ||", "meaning": "शौचात् स्वाङ्गजुगुप्सा परैर् असंसर्गः ||", "text": ""},
{"reference": "2.41", "sanskrit_iast": "sattvaśuddhisaumanasyaikāgryendriyajayātmadarśanayogyatvāni ca ||", "meaning": "सत्त्वशुद्धिसौमनस्यैकाग्र्येन्द्रियजयात्मदर्शनयोग्यत्वानि च ||", "text": ""},
{"reference": "2.42", "sanskrit_iast": "saṃtoṣād anuttamaḥ sukhalābhaḥ ||", "meaning": "संतोषाद् अनुत्तमः सुखलाभः ||", "text": ""},
{"reference": "2.43", "sanskrit_iast": "kāyendriyasiddhir aśuddhikṣayāt tapasaḥ ||", "meaning": "कायेन्द्रियसिद्धिर् अशुद्धिक्षयात् तपसः ||", "text": ""},
{"reference": "2.44", "sanskrit_iast": "svādhyāyād iṣṭadevatāsaṃprayogaḥ ||", "meaning": "स्वाध्यायाद् इष्टदेवतासंप्रयोगः ||", "text": ""},
{"reference": "2.45", "sanskrit_iast": "samādhisiddhir īśvarapraṇidhānāt ||", "meaning": "समाधिसिद्धिर् ईश्वरप्रणिधानात् ||", "text": ""},
{"reference": "2.46", "sanskrit_iast": "sthirasukham āsanam ||", "meaning": "स्थिरसुखम् आसनम् ||", "text": ""},
{"reference": "2.47", "sanskrit_iast": "prayatnaśaithilyānantasamāpattibhyām ||", "meaning": "प्रयत्नशैथिल्यानन्तसमापत्तिभ्याम् ||", "text": ""},
{"reference": "2.48", "sanskrit_iast": "tato dvandvānabhighātaḥ ||", "meaning": "ततो द्वन्द्वानभिघातः ||", "text": ""},
{"reference": "2.49", "sanskrit_iast": "tasmin sati śvāsapraśvāsayor gativicchedaḥ prāṇāyāmaḥ ||", "meaning": "तस्मिन् सति श्वासप्रश्वासयोर् गतिविच्छेदः प्राणायामः ||", "text": ""},
{"reference": "2.50", "sanskrit_iast": "bāhyābhyantarastambhavṛttir deśakālasaṃkhyābhiḥ paridṛṣṭo dīrghasūkṣmaḥ ||", "meaning": "बाह्याभ्यन्तरस्तम्भवृत्तिर् देशकालसंख्याभिः परिदृष्टो दीर्घसूक्ष्मः ||", "text": ""},
{"reference": "2.51", "sanskrit_iast": "bāhyābhyantaraviṣayākṣepī caturthaḥ ||", "meaning": "बाह्याभ्यन्तरविषयाक्षेपी चतुर्थः ||", "text": ""},
{"reference": "2.52", "sanskrit_iast": "tataḥ kṣīyate prakāśāvaraṇam ||", "meaning": "ततः क्षीयते प्रकाशावरणम् ||", "text": ""},
{"reference": "2.53", "sanskrit_iast": "dhāraṇāsu ca yogyatā manasaḥ ||", "meaning": "धारणासु च योग्यता मनसः ||", "text": ""},
{"reference": "2.54", "sanskrit_iast": "svaviṣayāsaṃprayoge cittasvarūpānukāra ivendriyāṇāṃ pratyāhāraḥ ||", "meaning": "स्वविषयासंप्रयोगे चित्तस्वरूपानुकार इवेन्द्रियाणां प्रत्याहारः ||", "text": ""},
{"reference": "2.55", "sanskrit_iast": "tataḥ paramā vaśyatendriyāṇām ||", "meaning": "ततः परमा वश्यतेन्द्रियाणाम् ||", "text": ""},
{"reference": "3.1", "sanskrit_iast": "deśabandhaś cittasya dhāraṇā ||", "meaning": "देशबन्धश् चित्तस्य धारणा ||", "text": "", "title": "tṛtīyaḥ pādaḥ"},
{"reference": "3.2", "sanskrit_iast": "tatra pratyayaikatānatā dhyānam ||", "meaning": "तत्र प्रत्ययैकतानता ध्यानम् ||", "text": ""},
{"reference": "3.3", "sanskrit_iast": "tad evārthamātranirbhāsaṃ svarūpaśūnyam iva samādhiḥ ||", "meaning": "तद् एवार्थमात्रनिर्भासं स्वरूपशून्यम् इव समाधिः ||", "text": ""},
{"reference": "3.4", "sanskrit_iast": "trayam ekatra saṃyamaḥ ||", "meaning": "त्रयम् एकत्र संयमः ||", "text": ""},
{"reference": "3.5", "sanskrit_iast": "tajjayāt prajñālokaḥ ||", "meaning": "तज्जयात् प्रज्ञालोकः ||", "text": ""},
{"reference": "3.6", "sanskrit_iast": "tasya bhūmiṣu viniyogaḥ ||", "meaning": "तस्य भूमिषु विनियोगः ||", "text": ""},
{"reference": "3.7", "sanskrit_iast": "trayam antaraṅgaṃ pūrvebhyaḥ ||", "meaning": "त्रयम् अन्तरङ्गं पूर्वेभ्यः ||", "text": ""},
{"reference": "3.8", "sanskrit_iast": "tad api bahiraṅgaṃ nirbījasya ||", "meaning": "तद् अपि बहिरङ्गं निर्बीजस्य ||", "text": ""},
{"reference": "3.9", "sanskrit_iast": "vyutthānanirodhasaṃskārayor abhibhavaprādurbhāvau nirodhakṣaṇacittānvayo nirodhapariṇāmaḥ ||", "meaning": "व्युत्थाननिरोधसंस्कारयोर् अभिभवप्रादुर्भावौ निरोधक्षणचित्तान्वयो निरोधपरिणामः ||", "text": ""},
{"reference": "3.10", "sanskrit_iast": "tasya praśāntavāhitā saṃskārāt ||", "meaning": "तस्य प्रशान्तवाहिता संस्कारात् ||", "text": ""},
{"reference": "3.11", "sanskrit_iast": "sarvārthataikāgratayoḥ kṣayodayau cittasya samādhipariṇāmaḥ ||", "meaning": "सर्वार्थतैकाग्रतयोः क्षयोदयौ चित्तस्य समाधिपरिणामः ||", "text": ""},
{"reference": "3.12", "sanskrit_iast": "tataḥ punaḥ śāntoditau tulyapratyayau cittasyaikāgratāpariṇāmaḥ ||", "meaning": "ततः पुनः शान्तोदितौ तुल्यप्रत्ययौ चित्तस्यैकाग्रतापरिणामः ||", "text": ""},
{"reference": "3.13", "sanskrit_iast": "etena bhūtendriyeṣu dharmalakṣaṇāvasthāpariṇāmā vyākhyātāḥ ||", "meaning": "एतेन भूतेन्द्रियेषु धर्मलक्षणावस्थापरिणामा व्याख्याताः ||", "text": ""},
{"reference": "3.14", "sanskrit_iast": "śāntoditāvyapadeśyadharmānupātī dharmī ||", "meaning": "शान्तोदिताव्यपदेश्यधर्मानुपाती धर्मी ||", "text": ""},
{"reference": "3.15", "sanskrit_iast": "kramānyatvaṃ pariṇāmānyatve hetuḥ ||", "meaning": "क्रमान्यत्वं परिणामान्यत्वे हेतुः ||", "text": ""},
{"reference": "3.16", "sanskrit_iast": "pariṇāmatrayasaṃyamād atītānāgatajñānam ||", "meaning": "परिणामत्रयसंयमाद् अतीतानागतज्ञानम् ||", "text": ""},
{"reference": "3.17", "sanskrit_iast": "śabdārthapratyayānām itaretarādhyāsāt saṃkaras tatpravibhāgasaṃyamāt sarvabhūtarutajñānam ||", "meaning": "शब्दार्थप्रत्ययानाम् इतरेतराध्यासात् संकरस् तत्प्रविभागसंयमात् सर्वभूतरुतज्ञानम् ||", "text": ""},
{"reference": "3.18", "sanskrit_iast": "saṃskārasākṣātkaraṇāt pūrvajātijñānam ||", "meaning": "संस्कारसाक्षात्करणात् पूर्वजातिज्ञानम् ||", "text": ""},
{"reference": "3.19", "sanskrit_iast": "pratyayasya paracittajñānam ||", "meaning": "प्रत्ययस्य परचित्तज्ञानम् ||", "text": ""},
{"reference": "3.20", "sanskrit_iast": "na ca tat sālambanaṃ tasyāviṣayībhūtatvāt ||", "meaning": "न च तत् सालम्बनं तस्याविषयीभूतत्वात् ||", "text": ""},
{"reference": "3.21", "sanskrit_iast": "kāyarūpasaṃyamāt tadgrāhyaśaktistambhe cakṣuḥprakāśāsaṃprayoge 'ntardhānam ||", "meaning": "कायरूपसंयमात् तद्ग्राह्यशक्तिस्तम्भे चक्षुःप्रकाशासंप्रयोगे ऽन्तर्धानम् ||", "text": ""},
{"reference": "3.22", "sanskrit_iast": "sopakramaṃ nirupakramaṃ ca karma tatsaṃyamād aparāntajñānam ariṣṭebhyo vā ||", "meaning": "सोपक्रमं निरुपक्रमं च कर्म तत्संयमाद् अपरान्तज्ञानम् अरिष्टेभ्यो वा ||", "text": ""},
{"reference": "3.23", "sanskrit_iast": "maitryādiṣu balāni ||", "meaning": "मैत्र्यादिषु बलानि ||", "text": ""},
{"reference": "3.24", "sanskrit_iast": "baleṣu hastibalādīni ||", "meaning": "बलेषु हस्तिबलादीनि ||", "text": ""},
{"reference": "3.25", "sanskrit_iast": "pravṛttyālokanyāsāt sūkṣmavyavahitaviprakṛṣṭajñānam ||", "meaning": "प्रवृत्त्यालोकन्यासात् सूक्ष्मव्यवहितविप्रकृष्टज्ञानम् ||", "text": ""},
{"reference": "3.26", "sanskrit_iast": "bhuvanajñānaṃ sūrye saṃyamāt ||", "meaning": "भुवनज्ञानं सूर्ये संयमात् ||", "text": ""},
{"reference": "3.27", "sanskrit_iast": "candre tārāvyūhajñānam ||", "meaning": "चन्द्रे ताराव्यूहज्ञानम् ||", "text": ""},
{"reference": "3.28", "sanskrit_iast": "dhruve tadgatijñānam ||", "meaning": "ध्रुवे तद्गतिज्ञानम् ||", "text": ""},
{"reference": "3.29", "sanskrit_iast": "nābhicakre kāyavyūhajñānam ||", "meaning": "नाभिचक्रे कायव्यूहज्ञानम् ||", "text": ""},
{"reference": "3.30", "sanskrit_iast": "kaṇṭhakūpe kṣutpipāsānivṛttiḥ ||", "meaning": "कण्ठकूपे क्षुत्पिपासानिवृत्तिः ||", "text": ""},
{"reference": "3.31", "sanskrit_iast": "kūrmanāḍyāṃ sthairyam ||", "meaning": "कूर्मनाड्यां स्थैर्यम् ||", "text": ""},
{"reference": "3.32", "sanskrit_iast": "mūrdhajyotiṣi siddhadarśanam ||", "meaning": "मूर्धज्योतिषि सिद्धदर्शनम् ||", "text": ""},
{"reference": "3.33", "sanskrit_iast": "prātibhād vā sarvam ||", "meaning": "प्रातिभाद् वा सर्वम् ||", "text": ""},
{"reference": "3.34", "sanskrit_iast": "hṛdaye cittasaṃvit ||", "meaning": "हृदये चित्तसंवित् ||", "text": ""},
{"reference": "3.35", "sanskrit_iast": "sattvapuruṣayor atyantāsaṃkīrṇayoḥ pratyayāviśeṣo bhogaḥ parārthāt svārthasaṃyamāt puruṣajñānam ||", "meaning": "सत्त्वपुरुषयोर् अत्यन्तासंकीर्णयोः प्रत्ययाविशेषो भोगः परार्थात् स्वार्थसंयमात् पुरुषज्ञानम् ||", "text": ""},
{"reference": "3.36", "sanskrit_iast": "tataḥ prātibhaśrāvaṇavedanādarśāsvādavārtā jāyante ||", "meaning": "ततः प्रातिभश्रावणवेदनादर्शास्वादवार्ता जायन्ते ||", "text": ""},
{"reference": "3.37", "sanskrit_iast": "te samādhāv upasargā vyutthāne siddhayaḥ ||", "meaning": "ते समाधाव् उपसर्गा व्युत्थाने सिद्धयः ||", "text": ""},
{"reference": "3.38", "sanskrit_iast": "bandhakāraṇaśaithilyāt pracārasaṃvedanāc ca cittasya paraśarīrāveśaḥ ||", "meaning": "बन्धकारणशैथिल्यात् प्रचारसंवेदनाच् च चित्तस्य परशरीरावेशः ||", "text": ""},
{"reference": "3.39", "sanskrit_iast": "udānajayāj jalapaṅkakaṇṭakādiṣv asaṅga utkrāntiś ca ||", "meaning": "उदानजयाज् जलपङ्ककण्टकादिष्व् असङ्ग उत्क्रान्तिश् च ||", "text": ""},
{"reference": "3.40", "sanskrit_iast": "samānajayāj jvalanam ||", "meaning": "समानजयाज् ज्वलनम् ||", "text": ""},
{"reference": "3.41", "sanskrit_iast": "śrotrākāśayoḥ saṃbandhasaṃyamād divyaṃ śrotram ||", "meaning": "श्रोत्राकाशयोः संबन्धसंयमाद् दिव्यं श्रोत्रम् ||", "text": ""},
{"reference": "3.42", "sanskrit_iast": "kāyākāśayoḥ saṃbandhasaṃyamāl laghutūlasamāpatteś cākāśagamanam ||", "meaning": "कायाकाशयोः संबन्धसंयमाल् लघुतूलसमापत्तेश् चाकाशगमनम् ||", "text": ""},
{"reference": "3.43", "sanskrit_iast": "bahir akalpitā vṛttir mahāvidehā tataḥ prakāśāvaraṇakṣayaḥ ||", "meaning": "बहिर् अकल्पिता वृत्तिर् महाविदेहा ततः प्रकाशावरणक्षयः ||", "text": ""},
{"reference": "3.44", "sanskrit_iast": "sthūlasvarūpasūkṣmānvayārthavattvasaṃyamād bhūtajayaḥ ||", "meaning": "स्थूलस्वरूपसूक्ष्मान्वयार्थवत्त्वसंयमाद् भूतजयः ||", "text": ""},
{"reference": "3.45", "sanskrit_iast": "tato 'ṇimādiprādurbhāvaḥ kāyasaṃpat taddharmānabhighātaś ca ||", "meaning": "ततो ऽणिमादिप्रादुर्भावः कायसंपत् तद्धर्मानभिघातश् च ||", "text": ""},
{"reference": "3.46", "sanskrit_iast": "rūpalāvaṇyabalavajrasaṃhananatvāni kāyasaṃpat ||", "meaning": "रूपलावण्यबलवज्रसंहननत्वानि कायसंपत् ||", "text": ""},
{"reference": "3.47", "sanskrit_iast": "grahaṇasvarūpāsmitānvayārthavattvasaṃyamād indriyajayaḥ ||", "meaning": "ग्रहणस्वरूपास्मितान्वयार्थवत्त्वसंयमाद् इन्द्रियजयः ||", "text": ""},
{"reference": "3.48", "sanskrit_iast": "tato manojavitvaṃ vikaraṇabhāvaḥ pradhānajayaś ca ||", "meaning": "ततो मनोजवित्वं विकरणभावः प्रधानजयश् च ||", "text": ""},
{"reference": "3.49", "sanskrit_iast": "sattvapuruṣānyatākhyātimātrasya sarvabhāvādhiṣṭhātṛtvaṃ sarvajñātṛtvaṃ ca ||", "meaning": "सत्त्वपुरुषान्यताख्यातिमात्रस्य सर्वभावाधिष्ठातृत्वं सर्वज्ञातृत्वं च ||", "text": ""},
{"reference": "3.50", "sanskrit_iast": "tadvairāgyād api doṣabījakṣaye kaivalyam ||", "meaning": "तद्वैराग्याद् अपि दोषबीजक्षये कैवल्यम् ||", "text": ""},
{"reference": "3.51", "sanskrit_iast": "sthānyupanimantraṇe saṅgasmayākaraṇaṃ punar aniṣṭaprasaṅgāt ||", "meaning": "स्थान्युपनिमन्त्रणे सङ्गस्मयाकरणं पुनर् अनिष्टप्रसङ्गात् ||", "text": ""},
{"reference": "3.52", "sanskrit_iast": "kṣaṇatatkramayoḥ saṃyamād vivekajaṃ jñānam ||", "meaning": "क्षणतत्क्रमयोः संयमाद् विवेकजं ज्ञानम् ||", "text": ""},
{"reference": "3.53", "sanskrit_iast": "jātilakṣaṇadeśair anyatānavacchedāt tulyayos tataḥ pratipattiḥ ||", "meaning": "जातिलक्षणदेशैर् अन्यतानवच्छेदात् तुल्ययोस् ततः प्रतिपत्तिः ||", "text": ""},
{"reference": "3.54", "sanskrit_iast": "tārakaṃ sarvaviṣayaṃ sarvathāviṣayam akramaṃ ceti vivekajaṃ jñānam ||", "meaning": "तारकं सर्वविषयं सर्वथाविषयम् अक्रमं चेति विवेकजं ज्ञानम् ||", "text": ""},
{"reference": "3.55", "sanskrit_iast": "sattvapuruṣayoḥ śuddhisāmye kaivalyam iti ||", "meaning": "सत्त्वपुरुषयोः शुद्धिसाम्ये कैवल्यम् इति ||", "text": ""},
{"reference": "4.1", "sanskrit_iast": "janmauṣadhimantratapaḥsamādhijāḥ siddhayaḥ ||", "meaning": "जन्मौषधिमन्त्रतपःसमाधिजाः सिद्धयः ||", "text": "", "title": "caturthaḥ pādaḥ"},
{"reference": "4.2", "sanskrit_iast": "jātyantarapariṇāmaḥ prakṛtyāpūrāt ||", "meaning": "जात्यन्तरपरिणामः प्रकृत्यापूरात् ||", "text": ""},
{"reference": "4.3", "sanskrit_iast": "nimittam aprayojakaṃ prakṛtīnāṃ varaṇabhedas tu tataḥ kṣetrikavat ||", "meaning": "निमित्तम् अप्रयोजकं प्रकृतीनां वरणभेदस् तु ततः क्षेत्रिकवत् ||", "text": ""},
{"reference": "4.4", "sanskrit_iast": "nirmāṇacittāny asmitāmātrāt ||", "meaning": "निर्माणचित्तान्य् अस्मितामात्रात् ||", "text": ""},
{"reference": "4.5", "sanskrit_iast": "pravṛttibhede prayojakaṃ cittam ekam anekeṣām ||", "meaning": "प्रवृत्तिभेदे प्रयोजकं चित्तम् एकम् अनेकेषाम् ||", "text": ""},
{"reference": "4.6", "sanskrit_iast": "tatra dhyānajam anāśayam ||", "meaning": "तत्र ध्यानजम् अनाशयम् ||", "text": ""},
{"reference": "4.7", "sanskrit_iast": "karmāśuklākṛṣṇaṃ yoginas trividham itareṣām ||", "meaning": "कर्माशुक्लाकृष्णं योगिनस् त्रिविधम् इतरेषाम् ||", "text": ""},
{"reference": "4.8", "sanskrit_iast": "tatas tadvipākānuguṇānām evābhivyaktir vāsanānām ||", "meaning": "ततस् तद्विपाकानुगुणानाम् एवाभिव्यक्तिर् वासनानाम् ||", "text": ""},
{"reference": "4.9", "sanskrit_iast": "jātideśakālavyavahitānām apy ānantaryaṃ smṛtisaṃskārayor ekarūpatvāt ||", "meaning": "जातिदेशकालव्यवहितानाम् अप्य् आनन्तर्यं स्मृतिसंस्कारयोर् एकरूपत्वात् ||", "text": ""},
{"reference": "4.10", "sanskrit_iast": "tāsām anāditvaṃ cāśiṣo nityatvāt ||", "meaning": "तासाम् अनादित्वं चाशिषो नित्यत्वात् ||", "text": ""},
{"reference": "4.11", "sanskrit_iast": "hetuphalāśrayālambanaiḥ saṃgṛhītatvād eṣām abhāve tadabhāvaḥ ||", "meaning": "हेतुफलाश्रयालम्बनैः संगृहीतत्वाद् एषाम् अभावे तदभावः ||", "text": ""},
{"reference": "4.12", "sanskrit_iast": "atītānāgataṃ svarūpato 'sty adhvabhedād dharmāṇām ||", "meaning": "अतीतानागतं स्वरूपतो ऽस्त्य् अध्वभेदाद् धर्माणाम् ||", "text": ""},
{"reference": "4.13", "sanskrit_iast": "te vyaktasūkṣmā guṇātmānaḥ ||", "meaning": "ते व्यक्तसूक्ष्मा गुणात्मानः ||", "text": ""},
{"reference": "4.14", "sanskrit_iast": "pariṇāmaikatvād vastutattvam ||", "meaning": "परिणामैकत्वाद् वस्तुतत्त्वम् ||", "text": ""},
{"reference": "4.15", "sanskrit_iast": "vastusāmye cittabhedāt tayor vibhaktaḥ panthāḥ ||", "meaning": "वस्तुसाम्ये चित्तभेदात् तयोर् विभक्तः पन्थाः ||", "text": ""},
{"reference": "4.16", "sanskrit_iast": "na caikacittatantraṃ vastu tadapramāṇakaṃ tadā kiṃ syāt ||", "meaning": "न चैकचित्ततन्त्रं वस्तु तदप्रमाणकं तदा किं स्यात् ||", "text": ""},
{"reference": "4.17", "sanskrit_iast": "taduparāgāpekṣitvāc cittasya vastu jñātājñātam ||", "meaning": "तदुपरागापेक्षित्वाच् चित्तस्य वस्तु ज्ञाताज्ञातम् ||", "text": ""},
{"reference": "4.18", "sanskrit_iast": "sadā jñātāś cittavṛttayas tatprabhoḥ puruṣasyāpariṇāmitvāt ||", "meaning": "सदा ज्ञाताश् चित्तवृत्तयस् तत्प्रभोः पुरुषस्यापरिणामित्वात् ||", "text": ""},
{"reference": "4.19", "sanskrit_iast": "na tat svābhāsaṃ dṛśyatvāt ||", "meaning": "न तत् स्वाभासं दृश्यत्वात् ||", "text": ""},
{"reference": "4.20", "sanskrit_iast": "ekasamaye cobhayānavadhāraṇam ||", "meaning": "एकसमये चोभयानवधारणम् ||", "text": ""},
{"reference": "4.21", "sanskrit_iast": "cittāntaradṛśye buddhibuddher atiprasaṅgaḥ smṛtisaṃkaraś ca ||", "meaning": "चित्तान्तरदृश्ये बुद्धिबुद्धेर् अतिप्रसङ्गः स्मृतिसंकरश् च ||", "text": ""},
{"reference": "4.22", "sanskrit_iast": "citer apratisaṃkramāyās tadākārāpattau svabuddhisaṃvedanam ||", "meaning": "चितेर् अप्रतिसंक्रमायास् तदाकारापत्तौ स्वबुद्धिसंवेदनम् ||", "text": ""},
{"reference": "4.23", "sanskrit_iast": "draṣṭṛdṛśyoparaktaṃ cittaṃ sarvārtham ||", "meaning": "द्रष्टृदृश्योपरक्तं चित्तं सर्वार्थम् ||", "text": ""},
{"reference": "4.24", "sanskrit_iast": "tad asaṃkhyeyavāsanābhiś citram api parārthaṃ saṃhatyakāritvāt ||", "meaning": "तद् असंख्येयवासनाभिश् चित्रम् अपि परार्थं संहत्यकारित्वात् ||", "text": ""},
{"reference": "4.25", "sanskrit_iast": "viśeṣadarśina ātmabhāvabhāvanānivṛttiḥ ||", "meaning": "विशेषदर्शिन आत्मभावभावनानिवृत्तिः ||", "text": ""},
{"reference": "4.26", "sanskrit_iast": "tadā vivekanimnaṃ kaivalyaprāgbhāraṃ cittam ||", "meaning": "तदा विवेकनिम्नं कैवल्यप्राग्भारं चित्तम् ||", "text": ""},
{"reference": "4.27", "sanskrit_iast": "tacchidreṣu pratyayāntarāṇi saṃskārebhyaḥ ||", "meaning": "तच्छिद्रेषु प्रत्ययान्तराणि संस्कारेभ्यः ||", "text": ""},
{"reference": "4.28", "sanskrit_iast": "hānam eṣāṃ kleśavad uktam ||", "meaning": "हानम् एषां क्लेशवद् उक्तम् ||", "text": ""},
{"reference": "4.29", "sanskrit_iast": "prasaṃkhyāne 'py akusīdasya sarvathā vivekakhyāter dharmameghaḥ samādhiḥ ||", "meaning": "प्रसंख्याने ऽप्य् अकुसीदस्य सर्वथा विवेकख्यातेर् धर्ममेघः समाधिः ||", "text": ""},
{"reference": "4.30", "sanskrit_iast": "tataḥ kleśakarmanivṛttiḥ ||", "meaning": "ततः क्लेशकर्मनिवृत्तिः ||", "text": ""},
{"reference": "4.31", "sanskrit_iast": "tadā sarvāvaraṇamalāpetasya jñānasyānantyāj jñeyam alpam ||", "meaning": "तदा सर्वावरणमलापेतस्य ज्ञानस्यानन्त्याज् ज्ञेयम् अल्पम् ||", "text": ""},
{"reference": "4.32", "sanskrit_iast": "tataḥ kṛtārthānāṃ pariṇāmakramasamāptir guṇānām ||", "meaning": "ततः कृतार्थानां परिणामक्रमसमाप्तिर् गुणानाम् ||", "text": ""},
{"reference": "4.33", "sanskrit_iast": "kṣaṇapratiyogī pariṇāmāparāntanirgrāhyaḥ kramaḥ ||", "meaning": "क्षणप्रतियोगी परिणामापरान्तनिर्ग्राह्यः क्रमः ||", "text": ""},
{"reference": "4.34", "sanskrit_iast": "puruṣārthaśūnyānāṃ guṇānāṃ pratiprasavaḥ kaivalyaṃ svarūpapratiṣṭhā vā citiśaktir iti ||", "meaning": "पुरुषार्थशून्यानां गुणानां प्रतिप्रसवः कैवल्यं स्वरूपप्रतिष्ठा वा चितिशक्तिर् इति ||", "text": ""}
]
