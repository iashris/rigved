{"1":[{"r":"1.1","s":"namo brahmaṇe namo brāhmaṇebhyo nama ācāryebhyo nama ṛṣibhyo namo devebhyo nama vāyave ca mṛtyave ca viṣṇave ca namo vaiśravaṇāya ca |","d":"नमो ब्रह्मणे नमो ब्राह्मणेभ्यो नम आचार्येभ्यो नम ऋषिभ्यो नमो देवेभ्यो नम वायवे च मृत्यवे च विष्णवे च नमो वैश्रवणाय च ।","m":"Homage to Brahman! Homage to the brahmins! Homage to the teachers! Homage to the ṛṣis! Homage to the gods! Homage to Vāyu, and to Mṛtyu, and to Viṣṇu! And homage to Vaiśravaṇa!"},{"r":"1.2","s":"upajāyata śarvadattād gārgyāt śārvadatto gārgyaḥ |","d":"उपजायत शर्वदत्ताद् गार्ग्यात् शार्वदत्तो गार्ग्यः ।","m":"From Śarvadatta Gārgya was born Śārvadatta Gārgya."},{"r":"1.3","s":"śarvadatto gārgyo rudrabhūterdrāhyāyaṇāt |","d":"शर्वदत्तो गार्ग्यो रुद्रभूतेर्द्राह्यायणात् ।","m":"Śarvadatta Gārgya [learned] from Rudrabhūti Drāhyāyaṇa."},{"r":"1.4","s":"rudrabhūtirdrāhyāyaṇastrātādaiṣumāt |","d":"रुद्रभूतिर्द्राह्यायणस्त्रातादैषुमात् ।","m":"Rudrabhūti Drāhyāyaṇa from Trāta Aiṣumata."},{"r":"1.5","s":"trāta eṣumato nigaḍāt pārṇavalkeḥ |","d":"त्रात एषुमतो निगडात् पार्णवल्केः ।","m":"Trāta Aiṣumata from Nigaḍa Pārṇavalki."},{"r":"1.6","s":"nigaḍaḥ pārṇavalkiḥ giriśarmaṇaḥ kāṇṭheviddheḥ |","d":"निगडः पार्णवल्किः गिरिशर्मणः काण्ठेविद्धेः ।","m":"Nigaḍa Pārṇavalki from Giriśarman Kāṇṭheviddhi."},{"r":"1.7","s":"giriśarmā kāṇṭheviddhirbrahmavṛddheśchandogamāhakeḥ |","d":"गिरिशर्मा काण्ठेविद्धिर्ब्रह्मवृद्धेश्छन्दोगमाहकेः ।","m":"Giriśarman Kāṇṭheviddhi from Brahmavṛddhi Chandogamāhaki."},{"r":"1.8","s":"brahmavṛddhiśchandogamāhakirmitravarcasaḥ sthairakāyanāt |","d":"ब्रह्मवृद्धिश्छन्दोगमाहकिर्मित्रवर्चसः स्थैरकायनात् ।","m":"Brahmavṛddhi Chandogamāhaki from Mitravarcas Sthairakāyana.\nMitravarcas Sthairakāyana from Supratīta Aulundya."},{"r":"1.9","s":"mitravarcāḥ sthairakāyanaḥ supratītādaulundyāt |","d":"मित्रवर्चाः स्थैरकायनः सुप्रतीतादौलुन्द्यात् ।"},{"r":"1.10","s":"supratīta aulundyo bṛhaspatiguptācchāyastheḥ |","d":"सुप्रतीत औलुन्द्यो बृहस्पतिगुप्ताच्छायस्थेः ।","m":"Supratīta Aulundya from Bṛhaspatigupta Śāyasthi."},{"r":"1.11","s":"bṛhaspatiguptaḥ śāyasthirbhavatrātācchāyastheḥ |","d":"बृहस्पतिगुप्तः शायस्थिर्भवत्राताच्छायस्थेः ।","m":"Bṛhaspatigupta Śāyasthi from Bhavatrāta Śāyasthi."},{"r":"1.12","s":"bhavatrātaḥ śāyasthiḥ kustukācchārkarākṣyāt |","d":"भवत्रातः शायस्थिः कुस्तुकाच्छार्कराक्ष्यात् ।","m":"Bhavatrāta Śāyasthi from Kustuka Śārkarākṣya."},{"r":"1.13","s":"kustukaḥ śārkarāskṣyaḥ śravaṇadattāt kauhalāt |","d":"कुस्तुकः शार्करास्क्ष्यः श्रवणदत्तात् कौहलात् ।","m":"Kustuka Śārkarākṣya from Śravaṇadatta Kauhala."},{"r":"1.14","s":"śravaṇadattaḥ kauhalaḥ suśāradācchālaṅkāyanāt |","d":"श्रवणदत्तः कौहलः सुशारदाच्छालङ्कायनात् ।","m":"Śravaṇadatta Kauhala from Suśārada Śālaṅkāyana."},{"r":"1.15","s":"suśāradaḥ śālaṅkāyana ūrjayata aupamanyavāt |","d":"सुशारदः शालङ्कायन ऊर्जयत औपमन्यवात् ।","m":"Suśārada Śālaṅkāyana from Ūrjayan Aupamanyava."},{"r":"1.16","s":"ūrjayannaupamanyavo bhānumata aupamanyavāt |","d":"ऊर्जयन्नौपमन्यवो भानुमत औपमन्यवात् ।","m":"Ūrjayan Aupamanyava from Bhānumant Aupamanyava."},{"r":"1.17","s":"bhānumānaupamanyava ānandajāccāndhanāyanāt |","d":"भानुमानौपमन्यव आनन्दजाच्चान्धनायनात् ।","m":"Bhānumant Aupamanyava from Ānandaja Cāndhanāyana."},{"r":"1.18","s":"ānandajaścāndhanāyanaḥ śāmbācchārkarākṣyāt kāmbojāccopamanyavāt |","d":"आनन्दजश्चान्धनायनः शाम्बाच्छार्कराक्ष्यात् काम्बोजाच्चोपमन्यवात् ।","m":"Ānandaja Cāndhanāyana from Śāmba Śārkarākṣya and Kāmboja Aupamanyava."},{"r":"1.19","s":"śāmbaḥ śārkarākṣyaḥ kāmbojaścaupamanyavo madrakārācchauṅgāyaneḥ |","d":"शाम्बः शार्कराक्ष्यः काम्बोजश्चौपमन्यवो मद्रकाराच्छौङ्गायनेः ।","m":"Śāmba Śārkarākṣya and Kāmboja Aupamanyava from Madrakāra Śauṅgāyani."},{"r":"1.20","s":"madrakāraḥ śauṅgāyaniḥ svāterauṣṭrākṣeḥ |","d":"मद्रकारः शौङ्गायनिः स्वातेरौष्ट्राक्षेः ।","m":"Madrakāra Śauṅgāyani from Svāti Auṣṭrākṣi."},{"r":"1.21","s":"svātirauṣṭrākṣiḥ suśravaso vārṣagaṇyāt |","d":"स्वातिरौष्ट्राक्षिः सुश्रवसो वार्षगण्यात् ।","m":"Svāti Auṣṭrākṣi from Suśravas Vārṣagaṇya."},{"r":"1.22","s":"suśravā vārṣagaṇyaḥ prātarahnāt kauhalāt |","d":"सुश्रवा वार्षगण्यः प्रातरह्नात् कौहलात् ।","m":"Suśravas Vārṣagaṇya from Prātarahna Kauhala."},{"r":"1.23","s":"prātarahnaḥ kauhalaḥ ketorvādyāt |","d":"प्रातरह्नः कौहलः केतोर्वाद्यात् ।","m":"Prātarahna Kauhala from Ketu Vādya."},{"r":"1.24","s":"keturvādyo mitravindāt kauhalāt |","d":"केतुर्वाद्यो मित्रविन्दात् कौहलात् ।","m":"Ketu Vādya from Mitravinda Kauhala."},{"r":"1.25","s":"mitravindaḥ kauhalaḥ sunīthāt kāpaṭavāt |","d":"मित्रविन्दः कौहलः सुनीथात् कापटवात् ।","m":"Mitravinda Kauhala from Sunītha Kāpaṭava."},{"r":"1.26","s":"sunīthaḥ kāpaṭavaḥ sutemanasaḥ śāṇḍilyāyanāt |","d":"सुनीथः कापटवः सुतेमनसः शाण्डिल्यायनात् ।","m":"Sunītha Kāpaṭava from Sutemanas Śāṇḍilyāyana."},{"r":"1.27","s":"sutemanāḥ śāṇḍilyāyano'ṃśordhānaṃjayyāt |","d":"सुतेमनाः शाण्डिल्यायनोऽंशोर्धानंजय्यात् ।","m":"Sutemanas Śāṇḍilyāyana from Aṃśu Dhānaṃjayya."}],"2":[{"r":"2.1","s":"aṃśurdhāñjayyo'mavāsyācchāṇḍilyāyanādrādhācca gautamāt |","d":"अंशुर्धाञ्जय्योऽमवास्याच्छाण्डिल्यायनाद्राधाच्च गौतमात् ।","m":"Aṃśu Dhānaṃjayya from Amavāsyā Śāṇḍilyāyana and Rādha Gautama."},{"r":"2.2","s":"rādho gautamo gāturgautamāt pituḥ |","d":"राधो गौतमो गातुर्गौतमात् पितुः ।","m":"Rādha Gautama from Gātṛ Gautama, his father."},{"r":"2.3","s":"gātā gautamaḥ saṃvargajito lāmakāyanāt |","d":"गाता गौतमः संवर्गजितो लामकायनात् ।","m":"Gātṛ Gautama from Saṃvargajit Lāmakāyana."},{"r":"2.4","s":"saṃvargajillāmakāyanaḥ śākadāsāt bhāḍitāyanāt |","d":"संवर्गजिल्लामकायनः शाकदासात् भाडितायनात् ।","m":"Saṃvargajit Lāmakāyana from Śākadāsa Bhāḍitāyana."},{"r":"2.5","s":"śākadāso bhāḍitāyano vicakṣaṇāttāṇḍyāt |","d":"शाकदासो भाडितायनो विचक्षणात्ताण्ड्यात् ।","m":"Śākadāsa Bhāḍitāyana from Vicakṣaṇa Tāṇḍya."},{"r":"2.6","s":"vicakṣaṇastāṇḍyo gardabhīmukhācchāṇḍilyāyanāt |","d":"विचक्षणस्ताण्ड्यो गर्दभीमुखाच्छाण्डिल्यायनात् ।","m":"Vicakṣaṇa Tāṇḍya from Gardabhīmukha Śāṇḍilyāyana."},{"r":"2.7","s":"gardabhīsukhaḥ śāṇḍilyāyanaḥ udaraśāṇḍilyāt pituḥ |","d":"गर्दभीसुखः शाण्डिल्यायनः उदरशाण्डिल्यात् पितुः ।","m":"Gardabhīmukha Śāṇḍilyāyana from Udaraśāṇḍilya, his father."},{"r":"2.8","s":"udaraśāṇḍilyo'tidhanvanaśca śaunakānmaśakācca gārgyāt |","d":"उदरशाण्डिल्योऽतिधन्वनश्च शौनकान्मशकाच्च गार्ग्यात् ।","m":"Udaraśāṇḍilya from Atidhanvan Śaunaka and Maśaka Gārgya."},{"r":"2.9","s":"maśako gārgyaḥ sthirakāt gārgyāt pituḥ |","d":"मशको गार्ग्यः स्थिरकात् गार्ग्यात् पितुः ।","m":"Maśaka Gārgya from Sthiraka Gārgya, his father."},{"r":"2.10","s":"sthirako gārgyo vāsiṣṭhāccaikitāneyāt |","d":"स्थिरको गार्ग्यो वासिष्ठाच्चैकितानेयात् ।","m":"Sthiraka Gārgya from Vāsiṣṭha Caikitāneya."},{"r":"2.11","s":"vāsiṣṭhaścaikitāneyo vāsiṣṭhādārehaṇyādrājanyāt |","d":"वासिष्ठश्चैकितानेयो वासिष्ठादारेहण्याद्राजन्यात् ।","m":"Vāsiṣṭha Caikitāneya from Vāsiṣṭha Ārehaṇya, a Rājanya."},{"r":"2.12","s":"vāsiṣṭha ārehaṇyo rājanyaḥ sumantrāt bābhravāt gautamāt |","d":"वासिष्ठ आरेहण्यो राजन्यः सुमन्त्रात् बाभ्रवात् गौतमात् ।","m":"Vāsiṣṭha Ārehaṇya, the Rājanya, from Sumantra Bābhrava Gautama."},{"r":"2.13","s":"sumantro bābhravo gautamaḥ śūṣādvāhneyādbhāradvājāt |","d":"सुमन्त्रो बाभ्रवो गौतमः शूषाद्वाह्नेयाद्भारद्वाजात् ।","m":"Sumantra Bābhrava Gautama from Śūṣa Vāhneya Bhāradvāja."},{"r":"2.14","s":"śuṣo vāhnebhyo bhāradvājo'rālāddārteyācchaunakāt |","d":"शुषो वाह्नेभ्यो भारद्वाजोऽरालाद्दार्तेयाच्छौनकात् ।","m":"Śūṣa Vāhneya Bhāradvāja from Arāla Dārteya Śaunaka."},{"r":"2.15","s":"arālo darteyaḥ śaunako dṛteraindrotācchaunakāt pituḥ |","d":"अरालो दर्तेयः शौनको दृतेरैन्द्रोताच्छौनकात् पितुः ।","m":"Arāla Dārteya Śaunaka from Dṛti Aindrota Śaunaka, his father."},{"r":"2.16","s":"dṛtiraindrotaḥ śaunaka indrotācchaunakāt pitureva |","d":"दृतिरैन्द्रोतः शौनक इन्द्रोताच्छौनकात् पितुरेव ।","m":"Dṛti Aindrota Śaunaka from Indrota Śaunaka, his father indeed."},{"r":"2.17","s":"indrotaḥ śaunako vṛṣaśuṣmādvātāvatāt |","d":"इन्द्रोतः शौनको वृषशुष्माद्वातावतात् ।","m":"Indrota Śaunaka from Vṛṣaśuṣma Vātāvata."},{"r":"2.18","s":"vṛṣaśuṣmo vātāvato nikothakāt bhāyajātyāt |","d":"वृषशुष्मो वातावतो निकोथकात् भायजात्यात् ।","m":"Vṛṣaśuṣma Vātāvata from Nikothaka Bhāyajātya."},{"r":"2.19","s":"nikothako bhāyajātyaḥ pratitherdevatarathāt |","d":"निकोथको भायजात्यः प्रतिथेर्देवतरथात् ।","m":"Nikothaka Bhāyajātya from Pratithi Devataratha."},{"r":"2.20","s":"pratithirdevataratho devatarasaḥ śāvasāyanāt pituḥ |","d":"प्रतिथिर्देवतरथो देवतरसः शावसायनात् पितुः ।","m":"Pratithi Devataratha from Devataras Śāvasāyana, his father."},{"r":"2.21","s":"devatarāḥ śāvasāyanaḥ śavasaḥ pitureva |","d":"देवतराः शावसायनः शवसः पितुरेव ।","m":"Devataras Śāvasāyana from Śavas, his father indeed."},{"r":"2.22","s":"śavā agnibhuvaḥ kāśyapāt |","d":"शवा अग्निभुवः काश्यपात् ।","m":"Śavas from Agnibhū Kāśyapa."},{"r":"2.23","s":"agnibhūḥ kāśyapa indrabhuvaḥ kāśyapāt |","d":"अग्निभूः काश्यप इन्द्रभुवः काश्यपात् ।","m":"Agnibhū Kāśyapa from Indrabhū Kāśyapa."},{"r":"2.24","s":"indrabhūḥ kāśyapo mitrabhuvaḥ kāśyapāt |","d":"इन्द्रभूः काश्यपो मित्रभुवः काश्यपात् ।","m":"Indrabhū Kāśyapa from Mitrabhū Kāśyapa."},{"r":"2.25","s":"mitrabhūḥ kāśyapo vibhuṇḍakāt kāśyapāt pituḥ |","d":"मित्रभूः काश्यपो विभुण्डकात् काश्यपात् पितुः ।","m":"Mitrabhū Kāśyapa from Vibhaṇḍaka Kāśyapa, his father."},{"r":"2.26","s":"vibhaṇḍakaḥ kāśyapa ṛṣyaśṛṅgāt kāśyapāt pituḥ |","d":"विभण्डकः काश्यप ऋष्यशृङ्गात् काश्यपात् पितुः ।","m":"Vibhaṇḍaka Kāśyapa from Ṛṣyaśṛṅga Kāśyapa, his father."},{"r":"2.27","s":"ṛṣyaśṛṅgaḥ kāśyapaḥ kāśyapāt pitureva |","d":"ऋष्यशृङ्गः काश्यपः काश्यपात् पितुरेव ।","m":"Ṛṣyaśṛṅga Kāśyapa from Kaśyapa, his father indeed."},{"r":"2.28","s":"kaśyapo'gneḥ |","d":"कश्यपोऽग्नेः ।"},{"r":"2.29","s":"agnirindrāt |","d":"अग्निरिन्द्रात् ।"},{"r":"2.30","s":"indro vāyoḥ |","d":"इन्द्रो वायोः ।"},{"r":"2.31","s":"vāyurmṛtyoḥ |","d":"वायुर्मृत्योः ।"},{"r":"2.32","s":"mṛtyuḥ prajāpateḥ |","d":"मृत्युः प्रजापतेः ।"},{"r":"2.33","s":"prajāpatirbrahmaṇaḥ |","d":"प्रजापतिर्ब्रह्मणः ।"},{"r":"2.34","s":"brahmā svayambhūḥ |","d":"ब्रह्मा स्वयम्भूः ।"},{"r":"2.35","s":"tasmai namastasmai namaḥ |","d":"तस्मै नमस्तस्मै नमः ।","m":"Homage to him! Homage to him!"}],"3":[{"r":"3.1","s":"ācāryebhyo namaskṛtvātha vaṃśasya kīrtayet | svadhā pūrveṣāṃ bhavati netāyurdīrghamaśnute | ityuktvānukrāmedvaṃśamā brahmaṇaḥ |","d":"आचार्येभ्यो नमस्कृत्वाथ वंशस्य कीर्तयेत् । स्वधा पूर्वेषां भवति नेतायुर्दीर्घमश्नुते । इत्युक्त्वानुक्रामेद्वंशमा ब्रह्मणः ।","m":"Having paid homage to the teachers, one should recite the lineage:\n\nThere is funeral offering for the ancestors; the reciter attains a long life.\n\nHaving spoken thus, one should enumerate the lineage all the way to Brahmā."},{"r":"3.2","s":"nayannaryamabhūteḥ kālabavāt |","d":"नयन्नर्यमभूतेः कालबवात् ।","m":"[Tracing the lineage] leading from Aryamabhūti Kālabava:"},{"r":"3.3","s":"aryamabhūtiḥ kālabavaḥ bhadraśarmaṇaḥ kauśikāt |","d":"अर्यमभूतिः कालबवः भद्रशर्मणः कौशिकात् ।","m":"Aryamabhūti Kālabava [received it] from Bhadraśarman Kauśika;"},{"r":"3.4","s":"bhadraśarmā kauśikaḥ puṣpayaśasa audavrajeḥ |","d":"भद्रशर्मा कौशिकः पुष्पयशस औदव्रजेः ।","m":"Bhadraśarman Kauśika from Puṣpayaśas Audavraji;"},{"r":"3.5","s":"puṣpayaśā audavrajiḥ saṃkarādgautamāt |","d":"पुष्पयशा औदव्रजिः संकराद्गौतमात् ।","m":"Puṣpayaśas Audavraji from Saṃkara Gautama;"},{"r":"3.6","s":"saṃkaro gautamo'ryamarādhācca gobhilāt pūṣmitrācca gobhilāt |","d":"संकरो गौतमोऽर्यमराधाच्च गोभिलात् पूष्मित्राच्च गोभिलात् ।","m":"Saṃkara Gautama from Aryamarādha Gobhila and from Pūṣamitra Gobhila;"},{"r":"3.7","s":"pūṣāmitro gobhilo'śvamitrādgobhilāt |","d":"पूषामित्रो गोभिलोऽश्वमित्राद्गोभिलात् ।","m":"Pūṣāmitra Gobhila from Aśvamitra Gobhila;"},{"r":"3.8","s":"aśvamitro gobhilo varuṇamitrādgobhilāt |","d":"अश्वमित्रो गोभिलो वरुणमित्राद्गोभिलात् ।","m":"Aśvamitra Gobhila from Varuṇamitra Gobhila;"},{"r":"3.9","s":"varuṇamitro gobhilo mūlamitrādgobhilāt |","d":"वरुणमित्रो गोभिलो मूलमित्राद्गोभिलात् ।","m":"Varuṇamitra Gobhila from Mūlamitra Gobhila;"},{"r":"3.10","s":"mūlamitro gobhilo vatsamitrād gobhilāt |","d":"मूलमित्रो गोभिलो वत्समित्राद् गोभिलात् ।","m":"Mūlamitra Gobhila from Vatsamitra Gobhila;"},{"r":"3.11","s":"vatsamitro gobhilo gaulgulavīputrādgobhilāt |","d":"वत्समित्रो गोभिलो गौल्गुलवीपुत्राद्गोभिलात् ।","m":"Vatsamitra Gobhila from Gaulgulavīputra Gobhila;"},{"r":"3.12","s":"gaulgulavīputro gobhilo bṛhadvasoḥ pituḥ |","d":"गौल्गुलवीपुत्रो गोभिलो बृहद्वसोः पितुः ।","m":"Gaulgulavīputra Gobhila from Bṛhadvasu, his father;"},{"r":"3.13","s":"bṛhadvasurgobhilo gobhilādeva |","d":"बृहद्वसुर्गोभिलो गोभिलादेव ।","m":"Bṛhadvasu Gobhila from Gobhila himself;"},{"r":"3.14","s":"gobhilo rādhācca gautamāt |","d":"गोभिलो राधाच्च गौतमात् ।","m":"Gobhila from Rādha Gautama;"},{"r":"3.15","s":"samānaṃ paraṃ samānaṃ param |","d":"समानं परं समानं परम् ।","m":"What follows is the same; what follows is the same."}]}