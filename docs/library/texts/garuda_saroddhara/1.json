{"18":[{"r":"18.1","s":"garuḍauvāca || dharmātmāsvargatiṃbhuktvājāyatevimale\nkule || atastasyasamutpattiṃjananījaṭharevada","d":"गरुडौवाच || धर्मात्मास्वर्गतिंभुक्त्वाजायतेविमले\nकुले || अतस्तस्यसमुत्पत्तिंजननीजठरेवद"},{"r":"18.2","s":"yathāvicāraṃkurutedehe'sminsu\nkṛtījanaḥ || tathāhaṃśrotumicchāmivadamekaruṇānidhe","d":"यथाविचारंकुरुतेदेहेऽस्मिन्सु\nकृतीजनः || तथाहंश्रोतुमिच्छामिवदमेकरुणानिधे"},{"r":"18.4","s":"śrībhagavānuvāca\nsādhupṛṣṭaṃtvayātāyaparaṃgopyaṃvadāmite || yasyavijñānamātreṇasarvajñatvaṃprajāyate 3\nvakṣyāmicaśarīrasyasvarūpaṃpāramārthikam || brahmāṃḍaguṇasaṃpannaṃyogināṃdhāraṇāspa\ndam","d":"श्रीभगवानुवाच\nसाधुपृष्टंत्वयातायपरंगोप्यंवदामिते || यस्यविज्ञानमात्रेणसर्वज्ञत्वंप्रजायते 3\nवक्ष्यामिचशरीरस्यस्वरूपंपारमार्थिकम् || ब्रह्मांडगुणसंपन्नंयोगिनांधारणास्प\nदम्"},{"r":"18.5","s":"ṣaṭcakraciṃtanaṃyasminyathākurvatiyoginaḥ || brahmaraṃdhrecidānaṃdarūpa\ndhyānaṃtathāśṛṇu","d":"षट्चक्रचिंतनंयस्मिन्यथाकुर्वतियोगिनः || ब्रह्मरंध्रेचिदानंदरूप\nध्यानंतथाशृणु"},{"r":"18.6","s":"śucīnāṃśrīmatāṃgehejāyatesukṛtī yathā || tathāvidhānaṃni\nyamaṃtatpitroḥkathayāmite","d":"शुचीनांश्रीमतांगेहेजायतेसुकृती यथा || तथाविधानंनि\nयमंतत्पित्रोःकथयामिते"},{"r":"18.7","s":"ṛtukāletunārīṇāṃtyajeddinacatuṣṭayam || tāvannā\nlokayedvaktraṃpāpaṃ vapuṣisaṃbhavet","d":"ऋतुकालेतुनारीणांत्यजेद्दिनचतुष्टयम् || तावन्ना\nलोकयेद्वक्त्रंपापं वपुषिसंभवेत्"},{"r":"18.8","s":"snātvāsacailāṃsānārīcaturthe'haniśudhyati\nsaptāhātpitṛdevānāṃbhavedyogyāvratārcane","d":"स्नात्वासचैलांसानारीचतुर्थेऽहनिशुध्यति\nसप्ताहात्पितृदेवानांभवेद्योग्याव्रतार्चने"},{"r":"18.9","s":"saptāhamadhyeyogarbhaḥsabhavenma\nlināśayaḥ || prāyaśaḥsaṃbhavaṃtyatraputrāstvaṣṭāhamadhyataḥ","d":"सप्ताहमध्येयोगर्भःसभवेन्म\nलिनाशयः || प्रायशःसंभवंत्यत्रपुत्रास्त्वष्टाहमध्यतः"},{"r":"18.10","s":"yugmāsuputrājāyaṃte\nstriyo'yugmāsurātriṣu || pūrvasaptakamutsṛjyatasmādyugmāsusaṃviśet","d":"युग्मासुपुत्राजायंते\nस्त्रियोऽयुग्मासुरात्रिषु || पूर्वसप्तकमुत्सृज्यतस्माद्युग्मासुसंविशेत्"},{"r":"18.12","s":"ṣoḍaśa\nrtuniśāḥstriṇāṃsāmānyāḥsamudāhatāḥ||yāvaicaturdaśīrātrirgarbhastiṣṭhatitatravai 11\nguṇabhāgyanidhiḥputrastadājāyetadhārmikaḥ || sāniśāprākṛtairjīvairnalabhyetaka\ndācana","d":"षोडश\nर्तुनिशाःस्त्रिणांसामान्याःसमुदाहताः||यावैचतुर्दशीरात्रिर्गर्भस्तिष्ठतितत्रवै 11\nगुणभाग्यनिधिःपुत्रस्तदाजायेतधार्मिकः || सानिशाप्राकृतैर्जीवैर्नलभ्येतक\nदाचन"},{"r":"18.13","s":"paṃcame'hani nārīṇāṃkāryaṃmadhurabhojanam || kaṭukṣāraṃcatīkṣṇaṃcatyā\njyamuṣṇaṃcadūrataḥ","d":"पंचमेऽहनि नारीणांकार्यंमधुरभोजनम् || कटुक्षारंचतीक्ष्णंचत्या\nज्यमुष्णंचदूरतः"},{"r":"18.14","s":"tatkṣetramoṣadhīpātraṃbījaṃcāpyamṛtāyitam || tasminhutvā\nnaraḥsvāmīsamyakphalamavāpnuyāt","d":"तत्क्षेत्रमोषधीपात्रंबीजंचाप्यमृतायितम् || तस्मिन्हुत्वा\nनरःस्वामीसम्यक्फलमवाप्नुयात्"},{"r":"18.15","s":"tāṃbūlapuṣpaśrīkhaṃḍaiḥsaṃyuktaḥśucivastra\nbhṛt || dharmamādāyamanasisutalpaṃsaṃviśetpumān","d":"तांबूलपुष्पश्रीखंडैःसंयुक्तःशुचिवस्त्र\nभृत् || धर्ममादायमनसिसुतल्पंसंविशेत्पुमान्"},{"r":"18.16","s":"niṣekasamayeyādṛṅnaracittavikalpanā || tādṛksvabhāvasaṃbhūtirjaṃturviśatikukṣi\ngaḥ","d":"निषेकसमयेयादृङ्नरचित्तविकल्पना || तादृक्स्वभावसंभूतिर्जंतुर्विशतिकुक्षि\nगः"},{"r":"18.17","s":"caitanyaṃbījabhūtaṃhinityaṃśukrepyavasthitaṃ || kāmaścittaṃcaśukraṃcaya\ndāhyekatvamāpnuyāt","d":"चैतन्यंबीजभूतंहिनित्यंशुक्रेप्यवस्थितं || कामश्चित्तंचशुक्रंचय\nदाह्येकत्वमाप्नुयात्"},{"r":"18.18","s":"tadādrāvamavāpnotiyoṣidgarbhāśayenaraḥ || śukraśo\nṇitasaṃyogātpiṃḍotpattiḥprajāyate","d":"तदाद्रावमवाप्नोतियोषिद्गर्भाशयेनरः || शुक्रशो\nणितसंयोगात्पिंडोत्पत्तिःप्रजायते"},{"r":"18.19","s":"paramānaṃdadaḥputrobhavedgarbhagataḥkṛtī\nbhavaṃtitasyanikhilāḥkriyāḥpuṃsavanādikāḥ","d":"परमानंददःपुत्रोभवेद्गर्भगतःकृती\nभवंतितस्यनिखिलाःक्रियाःपुंसवनादिकाः"},{"r":"18.20","s":"janmaprāpnotipuṇyātmāgrahe\nṣūccagateṣuca || tajjanmasamayeviprāḥprāpnuvaṃtidhanaṃbahu","d":"जन्मप्राप्नोतिपुण्यात्माग्रहे\nषूच्चगतेषुच || तज्जन्मसमयेविप्राःप्राप्नुवंतिधनंबहु"},{"r":"18.21","s":"vidyāvinayasaṃpa\nnnovardhatepitṛveśmani || satāṃsaṃgenasabhavetsarvāgamaviśāradaḥ","d":"विद्याविनयसंप\nन्नोवर्धतेपितृवेश्मनि || सतांसंगेनसभवेत्सर्वागमविशारदः"},{"r":"18.22","s":"divyāṃganādibhoktāsyāttāruṇyedānavāndhanī || pūrvvakṛtatapastīrthamahāpuṇyaphalo\ndayāt","d":"दिव्यांगनादिभोक्तास्यात्तारुण्येदानवान्धनी || पूर्व्वकृततपस्तीर्थमहापुण्यफलो\nदयात्"},{"r":"18.23","s":"tataścayatatenityamātmānātmavicāraṇe || adhyāropāpavādā\nbhyāṃkurutebrahmaciṃtanaṃ","d":"ततश्चयततेनित्यमात्मानात्मविचारणे || अध्यारोपापवादा\nभ्यांकुरुतेब्रह्मचिंतनं"},{"r":"18.24","s":"asyāsaṃgāvabodhāyabrahmaṇonvayakāriṇaḥ || kṣi\ntyādyanātmavargasyaguṇāṃstekathayāmyaham","d":"अस्यासंगावबोधायब्रह्मणोन्वयकारिणः || क्षि\nत्याद्यनात्मवर्गस्यगुणांस्तेकथयाम्यहम्"},{"r":"18.25","s":"kṣitirvārihavirbhoktāvāyurākāśaevaca|| sthūlabhūtāimeproktāḥpiṃḍo'yapāṃcabhauti\nkaḥ","d":"क्षितिर्वारिहविर्भोक्तावायुराकाशएवच|| स्थूलभूताइमेप्रोक्ताःपिंडोऽयपांचभौति\nकः"},{"r":"18.26","s":"tvagasthināḍyoromaṇimāṃsaṃcaivakhageśvara || etepaṃcaguṇābhūmermayāte\nparikīrtitāḥ","d":"त्वगस्थिनाड्योरोमणिमांसंचैवखगेश्वर || एतेपंचगुणाभूमेर्मयाते\nपरिकीर्तिताः"},{"r":"18.27","s":"lālāmūtraṃtathāśukraṃmajjāraktaṃcapaṃcamam || apāṃpaṃcaguṇāḥ\nproktāstejaso'piniśāmaya","d":"लालामूत्रंतथाशुक्रंमज्जारक्तंचपंचमम् || अपांपंचगुणाः\nप्रोक्तास्तेजसोऽपिनिशामय"},{"r":"18.28","s":"kṣudhātṛṣātathālasyaṃnidrākāṃtistathaivaca\ntejaḥpaṃcaguṇaṃtākṣaryaproktaṃsarvatrayogibhiḥ","d":"क्षुधातृषातथालस्यंनिद्राकांतिस्तथैवच\nतेजःपंचगुणंताक्षर्यप्रोक्तंसर्वत्रयोगिभिः"},{"r":"18.29","s":"ākuṃcanaṃdhāvanaṃcalaṃghanaṃcaprasāra\nṇaṃ || ceṣṭitaṃcetipaṃcaivaguṇāvāyoḥprakīrtitāḥ","d":"आकुंचनंधावनंचलंघनंचप्रसार\nणं || चेष्टितंचेतिपंचैवगुणावायोःप्रकीर्तिताः"},{"r":"18.30","s":"ghoṣaściṃtācaśūnyatvaṃmoha\nściṃtācasaṃśayaḥ || ākāśasyaguṇāḥpaṃcajñātavyāsteprayatnataḥ","d":"घोषश्चिंताचशून्यत्वंमोह\nश्चिंताचसंशयः || आकाशस्यगुणाःपंचज्ञातव्यास्तेप्रयत्नतः"},{"r":"18.31","s":"manobuddhi\nrahaṃkāraścittaṃceticatuṣṭayam || aṃtaḥkaraṇamuddiṣṭaṃpūrvakarmādhivāsitam","d":"मनोबुद्धि\nरहंकारश्चित्तंचेतिचतुष्टयम् || अंतःकरणमुद्दिष्टंपूर्वकर्माधिवासितम्"},{"r":"18.32","s":"śrotraṃtvakcakṣuṣījihvāghrāṇaṃjñāneṃdriyāṇica || vākpāṇipādapāyūpasthānikarmeṃdri\nyāṇica","d":"श्रोत्रंत्वक्चक्षुषीजिह्वाघ्राणंज्ञानेंद्रियाणिच || वाक्पाणिपादपायूपस्थानिकर्मेंद्रि\nयाणिच"},{"r":"18.33","s":"digvātārkapracetośvivahnīṃdropeṃdramitrakāḥ|| jñānakarmeṃdriyāṇāṃcade\nvatāḥparikīrtitāḥ","d":"दिग्वातार्कप्रचेतोश्विवह्नींद्रोपेंद्रमित्रकाः|| ज्ञानकर्मेंद्रियाणांचदे\nवताःपरिकीर्तिताः"},{"r":"18.34","s":"iḍācapiṃgalācaivasuṣumnākhyātṛtīyakā || gāṃdhārīgaja\njihvācapūṣācaivayaśasvinī","d":"इडाचपिंगलाचैवसुषुम्नाख्यातृतीयका || गांधारीगज\nजिह्वाचपूषाचैवयशस्विनी"},{"r":"18.35","s":"alaṃbuṣākuhūścāpiśaṃkhinīdaśamītathā || piṃ\nḍamadhyasthitāhyetāḥpradhānādaśanāḍikāḥ","d":"अलंबुषाकुहूश्चापिशंखिनीदशमीतथा || पिं\nडमध्यस्थिताह्येताःप्रधानादशनाडिकाः"},{"r":"18.36","s":"prāṇo'pānaḥsamānākhyaudāno\nvyānaevaca || nāgaḥkūrmaścakṛkalodevattodhanaṃjayaḥ","d":"प्राणोऽपानःसमानाख्यौदानो\nव्यानएवच || नागःकूर्मश्चकृकलोदेवत्तोधनंजयः"},{"r":"18.37","s":"hṛdiprāṇogude'pānaḥsa\nmānonābhimaṃḍale || udānaḥkaṃṭhadeśesyādvyānaḥsarvaśarīragaḥ","d":"हृदिप्राणोगुदेऽपानःस\nमानोनाभिमंडले || उदानःकंठदेशेस्याद्व्यानःसर्वशरीरगः"},{"r":"18.38","s":"udgārenāgaā\nkhyātaḥkūrmaunmīlanesmṛtaḥ|| kṛkalaḥkṣutkarojñeyodevadattovijṛṃbhaṇe","d":"उद्गारेनागआ\nख्यातःकूर्मौन्मीलनेस्मृतः|| कृकलःक्षुत्करोज्ञेयोदेवदत्तोविजृंभणे"},{"r":"18.39","s":"naja\nhātimṛtaṃrvāpisarvavyāpīdhanaṃjayaḥ || kavalairbhuktamannaṃhipuṣṭidaṃsarvadehināṃ","d":"नज\nहातिमृतंर्वापिसर्वव्यापीधनंजयः || कवलैर्भुक्तमन्नंहिपुष्टिदंसर्वदेहिनां"},{"r":"18.40","s":"nayatevyānakovāyuḥsārāṃśaṃsarvanāḍiṣu ||āhārobhuktamātrohivāyunākriyatedvidhā","d":"नयतेव्यानकोवायुःसारांशंसर्वनाडिषु ||आहारोभुक्तमात्रोहिवायुनाक्रियतेद्विधा"},{"r":"18.41","s":"saṃpraviśyagudesamyakpṛthagannaṃpṛthagjalaṃ || ūrdhvamagnerjalaṃkṛtvākṛtvā'nnaṃcaja\nlopari","d":"संप्रविश्यगुदेसम्यक्पृथगन्नंपृथग्जलं || ऊर्ध्वमग्नेर्जलंकृत्वाकृत्वाऽन्नंचज\nलोपरि"},{"r":"18.42","s":"agneścādhaḥsvayaṃprāṇaḥsthitvā'gniṃdhamateśanaiḥ|| vāyunādhmāyamāno\ngniḥpṛthakkiṭṭaṃpṛthagrasan","d":"अग्नेश्चाधःस्वयंप्राणःस्थित्वाऽग्निंधमतेशनैः|| वायुनाध्मायमानो\nग्निःपृथक्किट्टंपृथग्रसन्"},{"r":"18.43","s":"kurutevyānakovāyurviṣvaksaṃprāpayedrasaṃ || dvārairdvā\ndaśabhirbhinnaṃkiṭṭaṃdehādbahiḥsravet","d":"कुरुतेव्यानकोवायुर्विष्वक्संप्रापयेद्रसं || द्वारैर्द्वा\nदशभिर्भिन्नंकिट्टंदेहाद्बहिःस्रवेत्"},{"r":"18.44","s":"karṇākṣināsikājihvādaṃtānābhirna\nkhāgudam || guhyaṃśirovapurlomamalasthānānicakṣate","d":"कर्णाक्षिनासिकाजिह्वादंतानाभिर्न\nखागुदम् || गुह्यंशिरोवपुर्लोममलस्थानानिचक्षते"},{"r":"18.45","s":"evaṃsarvepravartaṃtesva\nsvakarmaṇivāyavaḥ|| upalabhyātmanaḥsattāṃsūryālokaṃyathājanāḥ","d":"एवंसर्वेप्रवर्तंतेस्व\nस्वकर्मणिवायवः|| उपलभ्यात्मनःसत्तांसूर्यालोकंयथाजनाः"},{"r":"18.46","s":"idānīṃ naradehasya śṛṇurūpadvayaṃ khaga || vyāvahārikamekaṃca dvitīyaṃ pāramārthikam","d":"इदानीं नरदेहस्य शृणुरूपद्वयं खग || व्यावहारिकमेकंच द्वितीयं पारमार्थिकम्"},{"r":"18.47","s":"tisraḥkoṭyo'rdhakoṭīca romāṇi vyāvahārike || saptalakṣāṇikeśāḥsyurna\nkhāḥproktāstuviṃśatiḥ","d":"तिस्रःकोट्योऽर्धकोटीच रोमाणि व्यावहारिके || सप्तलक्षाणिकेशाःस्युर्न\nखाःप्रोक्तास्तुविंशतिः"},{"r":"18.48","s":"dvātriṃśadaśanāḥproktāḥsāmānyādvinatāsuta || māṃ\nsaṃpa lasahasraṃturaktaṃ palaśataṃ smṛtam","d":"द्वात्रिंशदशनाःप्रोक्ताःसामान्याद्विनतासुत || मां\nसंप लसहस्रंतुरक्तं पलशतं स्मृतम्"},{"r":"18.49","s":"palānidaśamedastu tvakpalānica sapta\ntiḥ || paladvādaśakaṃ majjāmahāraktaṃ palatrayam","d":"पलानिदशमेदस्तु त्वक्पलानिच सप्त\nतिः || पलद्वादशकं मज्जामहारक्तं पलत्रयम्"},{"r":"18.50","s":"śukraṃ dvikuḍavaṃ jñeyaṃ kuḍavaṃ śoṇi\ntaṃ smṛtam || ṣaṣṭyuttaraṃca triśatamasthnāṃdehe prakīrtitam","d":"शुक्रं द्विकुडवं ज्ञेयं कुडवं शोणि\nतं स्मृतम् || षष्ट्युत्तरंच त्रिशतमस्थ्नांदेहे प्रकीर्तितम्"},{"r":"18.51","s":"nāḍyaḥsthūlāśca\nsūkṣmāścakoṭiśaḥparikīrtitāḥ || pittaṃ palānipaṃcāśata tadadhaim̐ śleṣmaṇastathā","d":"नाड्यःस्थूलाश्च\nसूक्ष्माश्चकोटिशःपरिकीर्तिताः || पित्तं पलानिपंचाशत तदधैम्̐ श्लेष्मणस्तथा"},{"r":"18.53","s":"satataṃ jāyamānaṃtuviṇmūtraṃcāpramāṇataḥ || etadguṇasamāyuktaṃ śarīraṃvyāvahārikam 52\nbhuvanāni ca sarvāṇi parvatadvīpasāgarāḥ || ādityādyā grahāḥ saṃti śarīre pāramārthi\nke","d":"सततं जायमानंतुविण्मूत्रंचाप्रमाणतः || एतद्गुणसमायुक्तं शरीरंव्यावहारिकम् 52\nभुवनानि च सर्वाणि पर्वतद्वीपसागराः || आदित्याद्या ग्रहाः संति शरीरे पारमार्थि\nके"},{"r":"18.54","s":"pāramārthikadehe hi ṣaṭcakrāṇi bhavaṃti ca || brahmāṃḍa ye guṇāḥ proktāste\npyasminneva saṃsthitāḥ","d":"पारमार्थिकदेहे हि षट्चक्राणि भवंति च || ब्रह्मांड ये गुणाः प्रोक्तास्ते\nप्यस्मिन्नेव संस्थिताः"},{"r":"18.55","s":"tānahaṃ te pravakṣyāmi yogināṃ dhāraṇāspadān || ye\nṣāṃ bhāvanayā jaṃturbhavedvairājarūpabhāk","d":"तानहं ते प्रवक्ष्यामि योगिनां धारणास्पदान् || ये\nषां भावनया जंतुर्भवेद्वैराजरूपभाक्"},{"r":"18.56","s":"pādādhastāttalaṃ jñeyaṃ pādordhvaṃ vitalaṃ\ntathā || jānunoḥ sutalaṃ viddhisakthideśe mahātalam","d":"पादाधस्तात्तलं ज्ञेयं पादोर्ध्वं वितलं\nतथा || जानुनोः सुतलं विद्धिसक्थिदेशे महातलम्"},{"r":"18.57","s":"talātalaṃ sakthimūle\nguhyadeśe rasātalam || pātālaṃkaṭisaṃsthaṃ ca saptalokāḥ prakīrtitāḥ","d":"तलातलं सक्थिमूले\nगुह्यदेशे रसातलम् || पातालंकटिसंस्थं च सप्तलोकाः प्रकीर्तिताः"},{"r":"18.58","s":"bhūrlokaṃnābhimadhyetubhuvarlokaṃtadūrdhvake || svarlokaṃhṛdayevidyātkaṃṭhadeśemahastathā","d":"भूर्लोकंनाभिमध्येतुभुवर्लोकंतदूर्ध्वके || स्वर्लोकंहृदयेविद्यात्कंठदेशेमहस्तथा"},{"r":"18.59","s":"janalokaṃvakradeśetapolokaṃlalāṭake || satyalokaṃbrahmaraṃdhrebhuvanānicatu\nrdaśa","d":"जनलोकंवक्रदेशेतपोलोकंललाटके || सत्यलोकंब्रह्मरंध्रेभुवनानिचतु\nर्दश"},{"r":"18.60","s":"trikoṇesaṃsthitomeruradhaḥkoṇecamaṃdaraḥ || dakṣakoṇecakailāsovāma\nkoṇehimācalaḥ","d":"त्रिकोणेसंस्थितोमेरुरधःकोणेचमंदरः || दक्षकोणेचकैलासोवाम\nकोणेहिमाचलः"},{"r":"18.61","s":"niṣadhaścordhvarekhāyāṃdakṣāyāṃgaṃdhamādanaḥ || ramaṇovāma\nrekhāyāṃsaptaitekulaparvatāḥ","d":"निषधश्चोर्ध्वरेखायांदक्षायांगंधमादनः || रमणोवाम\nरेखायांसप्तैतेकुलपर्वताः"},{"r":"18.62","s":"asthisthānebhavejaṃbuḥśākomajjāsusaṃsthitaḥ\nkuśadvīpasthitomāṃsekrauṃcadvīpaḥśirāsuca","d":"अस्थिस्थानेभवेजंबुःशाकोमज्जासुसंस्थितः\nकुशद्वीपस्थितोमांसेक्रौंचद्वीपःशिरासुच"},{"r":"18.63","s":"tvacāyāṃśālmalīdvīpogome\ndoromasaṃcaye || nakhasthaṃpuṣkaraṃvidyātsāgarāstadanaṃtaram","d":"त्वचायांशाल्मलीद्वीपोगोमे\nदोरोमसंचये || नखस्थंपुष्करंविद्यात्सागरास्तदनंतरम्"},{"r":"18.64","s":"kṣārodohibha\nvenmūtrekṣīrekṣīrodasāgaraḥ || surodadhiḥśleṣmasaṃsthomajjāyāṃdhṛtasāgaraḥ","d":"क्षारोदोहिभ\nवेन्मूत्रेक्षीरेक्षीरोदसागरः || सुरोदधिःश्लेष्मसंस्थोमज्जायांधृतसागरः"},{"r":"18.65","s":"rasodadhirasevidyācchoṇitedadhisāgaraḥ || svādūdolaṃbikāsthānejānīyāddinatā\nsuta","d":"रसोदधिरसेविद्याच्छोणितेदधिसागरः || स्वादूदोलंबिकास्थानेजानीयाद्दिनता\nसुत"},{"r":"18.66","s":"nādacakresthitaḥsūryobiṃducakrecacandramāḥ || locanasthaḥkujojñeyo\nhṛdayejñaḥprakīrtitaḥ","d":"नादचक्रेस्थितःसूर्योबिंदुचक्रेचचन्द्रमाः || लोचनस्थःकुजोज्ञेयो\nहृदयेज्ञःप्रकीर्तितः"},{"r":"18.67","s":"viṣṇusthāneguruṃvidyācchukreśukrovyavasthitaḥ|| nā\nbhisthānesthitomandomukherāhuḥprakīrtitaḥ","d":"विष्णुस्थानेगुरुंविद्याच्छुक्रेशुक्रोव्यवस्थितः|| ना\nभिस्थानेस्थितोमन्दोमुखेराहुःप्रकीर्तितः"},{"r":"18.68","s":"vāyusthānesthitaḥketuḥśarīregra\nhamaṇḍalam || evaṃsarvasvarūpeṇaciṃtayedātmanastanum","d":"वायुस्थानेस्थितःकेतुःशरीरेग्र\nहमण्डलम् || एवंसर्वस्वरूपेणचिंतयेदात्मनस्तनुम्"},{"r":"18.69","s":"sadāprabhātasamaye\nbaddhapadmāsanaḥsthitaḥ || ṣaṭcakraciṃtanaṃkuryādyathoktamajapākramam","d":"सदाप्रभातसमये\nबद्धपद्मासनःस्थितः || षट्चक्रचिंतनंकुर्याद्यथोक्तमजपाक्रमम्"},{"r":"18.70","s":"ajapānāmagāyatrīmunīnāṃmokṣadāyinī || asyāḥsaṃkalpamātreṇasarvapāpaiḥpramucya\nte","d":"अजपानामगायत्रीमुनीनांमोक्षदायिनी || अस्याःसंकल्पमात्रेणसर्वपापैःप्रमुच्य\nते"},{"r":"18.71","s":"śṛṇutā kṣyaṃ pravakṣye'hamajapākramamuttamam || yaṃkṛtvāsarvadājīvojīvabhā\nvaṃvimuṃcati","d":"शृणुता क्ष्यं प्रवक्ष्येऽहमजपाक्रममुत्तमम् || यंकृत्वासर्वदाजीवोजीवभा\nवंविमुंचति"},{"r":"18.73","s":"mūlādhāraḥsvādhiṣṭhānaṃmaṇipūrakamevaca || anāhataṃviśuddhyā\nkhyamājñāṣaṭcakramucyate ||72||mūlādhāreliṃgadeśenābhyāṃhṛdicakaṃṭhage||bhruvormadhye\nbrahmarandhrekramāccakrāṇiciṃtayet","d":"मूलाधारःस्वाधिष्ठानंमणिपूरकमेवच || अनाहतंविशुद्ध्या\nख्यमाज्ञाषट्चक्रमुच्यते ||72||मूलाधारेलिंगदेशेनाभ्यांहृदिचकंठगे||भ्रुवोर्मध्ये\nब्रह्मरन्ध्रेक्रमाच्चक्राणिचिंतयेत्"},{"r":"18.74","s":"ādhāraṃtucaturdalānalasamaṃvāsāṃtavarṇāśra\nyaṃsvādhiṣṭhānamapiprabhākarasamaṃbālāṃtaṣaṭpatrakam || raktābhaṃmaṇipūrakaṃdaśadalaṃr̤ā\ndyaṃphakārāṃtakaṃpatrairdvādaśabhīranāhatapuraṃhaimaṃkaṭhāṃtāvṛtam","d":"आधारंतुचतुर्दलानलसमंवासांतवर्णाश्र\nयंस्वाधिष्ठानमपिप्रभाकरसमंबालांतषट्पत्रकम् || रक्ताभंमणिपूरकंदशदलंर्̤आ\nद्यंफकारांतकंपत्रैर्द्वादशभीरनाहतपुरंहैमंकठांतावृतम्"},{"r":"18.75","s":"patraiḥsasvaraṣoḍa\nśaiḥśaśadharajyotirviśuddhāṃbujaṃhaṃsetyakṣarayugmakaṃdvayadalaṃraktābhamātrāṃbujam || ta\nsmādūrdhvagataṃprabhāsitamidaṃpadmaṃsahasracchadaṃsatyānandamayaṃsadāśivamayaṃ jyotirmayaṃ\nśāśvatam","d":"पत्रैःसस्वरषोड\nशैःशशधरज्योतिर्विशुद्धांबुजंहंसेत्यक्षरयुग्मकंद्वयदलंरक्ताभमात्रांबुजम् || त\nस्मादूर्ध्वगतंप्रभासितमिदंपद्मंसहस्रच्छदंसत्यानन्दमयंसदाशिवमयं ज्योतिर्मयं\nशाश्वतम्"},{"r":"18.76","s":"gaṇeśaṃcavidhiṃviṣṇuṃśivaṃjīvaṃguruṃtataḥ || vyāpakaṃcaparaṃbrahmakramāccakreṣuciṃtayet","d":"गणेशंचविधिंविष्णुंशिवंजीवंगुरुंततः || व्यापकंचपरंब्रह्मक्रमाच्चक्रेषुचिंतयेत्"},{"r":"18.77","s":"ekaviṃśatsahasrāṇiṣaṭśatānyadhikānica || ahorātreṇaśvāsasyaga\ntiḥsūkṣmāsmṛtā budhaiḥ","d":"एकविंशत्सहस्राणिषट्शतान्यधिकानिच || अहोरात्रेणश्वासस्यग\nतिःसूक्ष्मास्मृता बुधैः"},{"r":"18.78","s":"hakāreṇabahiryātisakāreṇaviśetpunaḥ || haṃsohaṃ\nsetimaṃtreṇajīvojapati tattvataḥ","d":"हकारेणबहिर्यातिसकारेणविशेत्पुनः || हंसोहं\nसेतिमंत्रेणजीवोजपति तत्त्वतः"},{"r":"18.79","s":"ṣaṭśataṃgaṇanāthāyaṣaṭsahasraṃtuvedhase\nṣaṭsahasraṃcaharayeṣaṭsahasraṃharāyaca","d":"षट्शतंगणनाथायषट्सहस्रंतुवेधसे\nषट्सहस्रंचहरयेषट्सहस्रंहरायच"},{"r":"18.80","s":"jīvātmane sahasraṃcasahasraṃguravetathā\ncidātmane sahasraṃcajapasaṃkhyāṃnivedayet","d":"जीवात्मने सहस्रंचसहस्रंगुरवेतथा\nचिदात्मने सहस्रंचजपसंख्यांनिवेदयेत्"},{"r":"18.81","s":"etāṃścakragatānbrahmamayūkhānmu\nnayomarān || satsaṃpradāyavettāraścitayaṃtyāruṇādayaḥ","d":"एतांश्चक्रगतान्ब्रह्ममयूखान्मु\nनयोमरान् || सत्संप्रदायवेत्तारश्चितयंत्यारुणादयः"},{"r":"18.82","s":"śukādayo'pimunayaḥ śiṣyānupadiśaṃtica||ataḥpravṛttiṃ mahatā dhyātvādhyāyetsadābu\ndhaḥ","d":"शुकादयोऽपिमुनयः शिष्यानुपदिशंतिच||अतःप्रवृत्तिं महता ध्यात्वाध्यायेत्सदाबु\nधः"},{"r":"18.83","s":"kṛtvācamānasīṃpūjāṃsarvacakreṣvananyadhīḥ || tatogurūpadeśenagāyatrī\nmajapāṃjapet","d":"कृत्वाचमानसींपूजांसर्वचक्रेष्वनन्यधीः || ततोगुरूपदेशेनगायत्री\nमजपांजपेत्"},{"r":"18.84","s":"adhomukhetatorandhresahasradalapaṃkaje || haṃsagaṃśrīguruṃdhyāye\ndvarābhayakarāṃbujam","d":"अधोमुखेततोरन्ध्रेसहस्रदलपंकजे || हंसगंश्रीगुरुंध्याये\nद्वराभयकरांबुजम्"},{"r":"18.85","s":"kṣālitaṃciṃtayeddehaṃtatpādāmṛtadhārayā || paṃcopacāraiḥ\nsaṃpūjyapraṇamettatstavenaca","d":"क्षालितंचिंतयेद्देहंतत्पादामृतधारया || पंचोपचारैः\nसंपूज्यप्रणमेत्तत्स्तवेनच"},{"r":"18.86","s":"tataḥ kuṃḍalinīṃ dhyāyedārohādavarohataḥ || ṣaṭcakrakṛtasaṃcārāṃ sārdhatrivalayāṃsthi\ntām","d":"ततः कुंडलिनीं ध्यायेदारोहादवरोहतः || षट्चक्रकृतसंचारां सार्धत्रिवलयांस्थि\nताम्"},{"r":"18.87","s":"tato dhyāyetsuṣumnākhyaṃ dhāmaraṃdhrādvahirgatam || tathā tena gatāyāṃ ti\ntadviṣṇoḥ paramaṃ padam","d":"ततो ध्यायेत्सुषुम्नाख्यं धामरंध्राद्वहिर्गतम् || तथा तेन गतायां ति\nतद्विष्णोः परमं पदम्"},{"r":"18.88","s":"tatomacciṃtitaṃ rūpaṃ svayaṃjyotiḥ sanātanam || sadānaṃdaṃ sadā dhyāyenmuhūrte brāhmasaṃjña\nke","d":"ततोमच्चिंतितं रूपं स्वयंज्योतिः सनातनम् || सदानंदं सदा ध्यायेन्मुहूर्ते ब्राह्मसंज्ञ\nके"},{"r":"18.89","s":"evaṃgurūpadeśena manoniścalatāṃ nayet || na tu svena prayatnena tadvināpatanaṃ\nbhavet","d":"एवंगुरूपदेशेन मनोनिश्चलतां नयेत् || न तु स्वेन प्रयत्नेन तद्विनापतनं\nभवेत्"},{"r":"18.90","s":"aṃtaryāgaṃ vidhāyaivaṃ bahiryāgaṃ samācaret || snānasaṃdhyādikaṃkṛtvāku\nryāddhariharārcanam","d":"अंतर्यागं विधायैवं बहिर्यागं समाचरेत् || स्नानसंध्यादिकंकृत्वाकु\nर्याद्धरिहरार्चनम्"},{"r":"18.91","s":"dehābhimāninā maṃtarmukhīvṛttirna jāyate || atasteṣāṃ\ntumadbhaktiḥ sukarā mokṣadāyinī","d":"देहाभिमानिना मंतर्मुखीवृत्तिर्न जायते || अतस्तेषां\nतुमद्भक्तिः सुकरा मोक्षदायिनी"},{"r":"18.92","s":"tapoyogādayomokṣamārgāḥsaṃtitathāpica || samīcīnastumadbhaktimārgaḥsaṃsaratā\nmiha","d":"तपोयोगादयोमोक्षमार्गाःसंतितथापिच || समीचीनस्तुमद्भक्तिमार्गःसंसरता\nमिह"},{"r":"18.93","s":"brahmādibhiścasarvajñairayamevaviniścitaḥ || trivāraṃvedaśāstrāṇivi\ncāryacapunaḥpunaḥ","d":"ब्रह्मादिभिश्चसर्वज्ञैरयमेवविनिश्चितः || त्रिवारंवेदशास्त्राणिवि\nचार्यचपुनःपुनः"},{"r":"18.94","s":"yajñādayo'pisaddharmāścittaśodhanakārakāḥ|| phalarūpācama\ndbhaktistāṃlabdhvānāvasīdati","d":"यज्ञादयोऽपिसद्धर्माश्चित्तशोधनकारकाः|| फलरूपाचम\nद्भक्तिस्तांलब्ध्वानावसीदति"},{"r":"18.95","s":"evamācaraṇaṃtākṣryakarotisukṛtīnaraḥ\nsaṃyogenacamadbhaktyāmokṣaṃyātisanātanam","d":"एवमाचरणंताक्ष्र्यकरोतिसुकृतीनरः\nसंयोगेनचमद्भक्त्यामोक्षंयातिसनातनम्"}],"19":[{"r":"19.1","s":"garuḍauvāca || śrutāmayādayāsiṃdhohyajñānājīvasaṃsṛtiḥ || adhunāśrotumicchā\nmimokṣopāyaṃsanātanam","d":"गरुडौवाच || श्रुतामयादयासिंधोह्यज्ञानाजीवसंसृतिः || अधुनाश्रोतुमिच्छा\nमिमोक्षोपायंसनातनम्"},{"r":"19.2","s":"bhagavandevadeveśaśaraṇāgatavatsala || asāreghora\nsaṃsāresarvaduḥkhamalīmase","d":"भगवन्देवदेवेशशरणागतवत्सल || असारेघोर\nसंसारेसर्वदुःखमलीमसे"},{"r":"19.3","s":"nānāvidhaśarīrasthāanaṃtājīvarāśayaḥ || jāyaṃte\ncamriyaṃtecateṣāmaṃtonavidyate","d":"नानाविधशरीरस्थाअनंताजीवराशयः || जायंते\nचम्रियंतेचतेषामंतोनविद्यते"},{"r":"19.4","s":"sadāduḥkhāturāevanasukhīvidyatekacit || ke\nnopāyenamokṣeśamucyaṃtevadmeprabho","d":"सदादुःखातुराएवनसुखीविद्यतेकचित् || के\nनोपायेनमोक्षेशमुच्यंतेवद्मेप्रभो"},{"r":"19.5","s":"śrībhagavānuvāca || śṛṇutākṣyaṃpravakṣyā\nmiyanmāṃ tvaṃparipṛcchasi || yasyaśravaṇamātreṇasaṃsārānmucyatenaraḥ","d":"श्रीभगवानुवाच || शृणुताक्ष्यंप्रवक्ष्या\nमियन्मां त्वंपरिपृच्छसि || यस्यश्रवणमात्रेणसंसारान्मुच्यतेनरः"},{"r":"19.6","s":"astidevaḥparabrahmasvarūpīniṣkakaḥśivaḥ || sarvajñaḥsarvakartācasarveśonirmalo'dva\nyaḥ","d":"अस्तिदेवःपरब्रह्मस्वरूपीनिष्ककःशिवः || सर्वज्ञःसर्वकर्ताचसर्वेशोनिर्मलोऽद्व\nयः"},{"r":"19.7","s":"svayaṃjyotiranādyaṃtonirvikāraḥparātparaḥ || nirguṇaḥsaccidānaṃdastadaṃ\nśājjīvasaṃjñakaḥ","d":"स्वयंज्योतिरनाद्यंतोनिर्विकारःपरात्परः || निर्गुणःसच्चिदानंदस्तदं\nशाज्जीवसंज्ञकः"},{"r":"19.8","s":"anādyavidyopahatāyathāgnauvisphuliṃgakāḥ || dehādyupā\ndhisaṃbhinnāstekarmabhiranādibhiḥ","d":"अनाद्यविद्योपहतायथाग्नौविस्फुलिंगकाः || देहाद्युपा\nधिसंभिन्नास्तेकर्मभिरनादिभिः"},{"r":"19.9","s":"sukhaduḥkhapradaiḥpuṇyapāparūpairniyaṃtritāḥ || tattajjātiyutaṃdehamāyurbhogaṃcakarmajam","d":"सुखदुःखप्रदैःपुण्यपापरूपैर्नियंत्रिताः || तत्तज्जातियुतंदेहमायुर्भोगंचकर्मजम्"},{"r":"19.10","s":"pratijanmaprapadyaṃteteṣāmapiparaṃpunaḥ || sasūkṣmaliṃgaśārīramāmokṣādakṣaraṃ\nkhaga","d":"प्रतिजन्मप्रपद्यंतेतेषामपिपरंपुनः || ससूक्ष्मलिंगशारीरमामोक्षादक्षरं\nखग"},{"r":"19.11","s":"sthāvarāḥkṛmayaścājāḥpakṣiṇaḥpaśavonarāḥ || dhārmikāstridaśāsta\ndvanmokṣiṇaścayathākramam","d":"स्थावराःकृमयश्चाजाःपक्षिणःपशवोनराः || धार्मिकास्त्रिदशास्त\nद्वन्मोक्षिणश्चयथाक्रमम्"},{"r":"19.12","s":"caturvidhaśarīrāṇidhṛtvāmuktvāsahasraśaḥ\nsukṛtānmānavobhūtvājñānīcenmokṣamāpnuyāt","d":"चतुर्विधशरीराणिधृत्वामुक्त्वासहस्रशः\nसुकृतान्मानवोभूत्वाज्ञानीचेन्मोक्षमाप्नुयात्"},{"r":"19.13","s":"caturāśītilakkheṣuśarīreṣuśarīriṇām || namānuṣaṃvinānyatratattvajñānaṃtulabhyate","d":"चतुराशीतिलक्खेषुशरीरेषुशरीरिणाम् || नमानुषंविनान्यत्रतत्त्वज्ञानंतुलभ्यते"},{"r":"19.14","s":"atrajanmasahasrāṇāṃsahasrairapikoṭibhiḥ || kadācillabhatejaṃturmānuṣyaṃpuṇya\nsaṃcayāt","d":"अत्रजन्मसहस्राणांसहस्रैरपिकोटिभिः || कदाचिल्लभतेजंतुर्मानुष्यंपुण्य\nसंचयात्"},{"r":"19.15","s":"sopānabhūtaṃmokṣasyamānuṣyaṃprāpyadurlabham || yastārayatinātmā\nnaṃtasmātpāpataro'trakaḥ","d":"सोपानभूतंमोक्षस्यमानुष्यंप्राप्यदुर्लभम् || यस्तारयतिनात्मा\nनंतस्मात्पापतरोऽत्रकः"},{"r":"19.16","s":"naraḥprāpyetaraṃjanmalabdhvāceṃdriyasauṣṭhavam || na\nvettyātmahitaṃyastusabhavedbrahmaghātakaḥ","d":"नरःप्राप्येतरंजन्मलब्ध्वाचेंद्रियसौष्ठवम् || न\nवेत्त्यात्महितंयस्तुसभवेद्ब्रह्मघातकः"},{"r":"19.17","s":"vinādehenakasyāpipuruṣārthonavidyate || tasmāddehaṃdhanaṃrakṣetpuṇyakarmāṇisādhayet","d":"विनादेहेनकस्यापिपुरुषार्थोनविद्यते || तस्माद्देहंधनंरक्षेत्पुण्यकर्माणिसाधयेत्"},{"r":"19.18","s":"rakṣayetsarvadātmānamātmāsarvasyabhājanam || rakṣaṇeyatnamātiṣṭhejjīvanbha\ndrāṇipaśyati","d":"रक्षयेत्सर्वदात्मानमात्मासर्वस्यभाजनम् || रक्षणेयत्नमातिष्ठेज्जीवन्भ\nद्राणिपश्यति"},{"r":"19.19","s":"punargrāmaḥpunaḥkṣetraṃpunarvittaṃpunargṛham || punaḥśubhāśubhaṃka\nrmanaśarīraṃpunaḥpunaḥ","d":"पुनर्ग्रामःपुनःक्षेत्रंपुनर्वित्तंपुनर्गृहम् || पुनःशुभाशुभंक\nर्मनशरीरंपुनःपुनः"},{"r":"19.20","s":"śarīrarakṣaṇopāyāḥ kriyaṃtesarvadābudhaiḥ || necchaṃtica\npunastyāgamapikuṣṭhādirogiṇaḥ","d":"शरीररक्षणोपायाः क्रियंतेसर्वदाबुधैः || नेच्छंतिच\nपुनस्त्यागमपिकुष्ठादिरोगिणः"},{"r":"19.21","s":"tadropitaṃsyāddharmārthadharmojñānārthamevaca || jñānaṃtudhyānayogārthamacirātpravimucya\nte","d":"तद्रोपितंस्याद्धर्मार्थधर्मोज्ञानार्थमेवच || ज्ञानंतुध्यानयोगार्थमचिरात्प्रविमुच्य\nते"},{"r":"19.22","s":"ātmaivayadinātmānamahitebhyonivārayet || ko'nyohitakarastasmā\ndātmānaṃtārayiṣyati","d":"आत्मैवयदिनात्मानमहितेभ्योनिवारयेत् || कोऽन्योहितकरस्तस्मा\nदात्मानंतारयिष्यति"},{"r":"19.23","s":"ihaivanarakavyādheścikitsāṃnakarotiyaḥ || gatvā\nnirauṣadhaṃdeśaṃvyādhisthaḥkiṃkariṣyati","d":"इहैवनरकव्याधेश्चिकित्सांनकरोतियः || गत्वा\nनिरौषधंदेशंव्याधिस्थःकिंकरिष्यति"},{"r":"19.24","s":"vyāghrīvāstejarācāyuryātibhi\nnnaghaṭāṃbuvat || nighnaṃtiripuvadrogāstasmācchreyaḥsamabhyaset","d":"व्याघ्रीवास्तेजराचायुर्यातिभि\nन्नघटांबुवत् || निघ्नंतिरिपुवद्रोगास्तस्माच्छ्रेयःसमभ्यसेत्"},{"r":"19.25","s":"yāvannāśrayateduḥkhaṃyāvannāyāṃticāpadaḥ || yāvannendriyavaikalyaṃtāvacchreyaḥsamabhyase\nt","d":"यावन्नाश्रयतेदुःखंयावन्नायांतिचापदः || यावन्नेन्द्रियवैकल्यंतावच्छ्रेयःसमभ्यसे\nत्"},{"r":"19.26","s":"yāvattiṣṭhatideho'yaṃtāvattattvaṃsamabhyaset || saṃdīptekoṇabhavanekūpaṃkha\nnatidurmatiḥ","d":"यावत्तिष्ठतिदेहोऽयंतावत्तत्त्वंसमभ्यसेत् || संदीप्तेकोणभवनेकूपंख\nनतिदुर्मतिः"},{"r":"19.27","s":"kālonajñāyatenānākāryaiḥsaṃsārasaṃbhavaiḥ || sukhaṃduḥkhaṃjano\nhaṃtanavettihitamātmanaḥ","d":"कालोनज्ञायतेनानाकार्यैःसंसारसंभवैः || सुखंदुःखंजनो\nहंतनवेत्तिहितमात्मनः"},{"r":"19.28","s":"jātānātrtānmṛtānāpadgrastāndṛṣṭvācaduḥkhitān || lokomohasurāṃpītvānabibheti\nkadācana","d":"जातानात्र्तान्मृतानापद्ग्रस्तान्दृष्ट्वाचदुःखितान् || लोकोमोहसुरांपीत्वानबिभेति\nकदाचन"},{"r":"19.29","s":"saṃpadaḥsvaprasaṃkāśādyauvanaṃkusumopamam || taḍiccapalamāyuṣyaṃka\nsyasyājjānatodhṛtiḥ","d":"संपदःस्वप्रसंकाशाद्यौवनंकुसुमोपमम् || तडिच्चपलमायुष्यंक\nस्यस्याज्जानतोधृतिः"},{"r":"19.30","s":"śataṃjīvitamatyalpaṃnidrālasyaistadardhakam || bā\nlyarogajarāduḥkhairalpaṃtadapiniṣphalam","d":"शतंजीवितमत्यल्पंनिद्रालस्यैस्तदर्धकम् || बा\nल्यरोगजरादुःखैरल्पंतदपिनिष्फलम्"},{"r":"19.31","s":"prārabdhavyenirudyogojāgartavyeprasuptakaḥ || viśvastavyobhayasthānehā naraḥkonaha\nnyate","d":"प्रारब्धव्येनिरुद्योगोजागर्तव्येप्रसुप्तकः || विश्वस्तव्योभयस्थानेहा नरःकोनह\nन्यते"},{"r":"19.32","s":"toyaphenasamedehejīvenākramyasaṃsthite || anityapriyasaṃvāsekathaṃti\nṣṭhatinirbhayaḥ","d":"तोयफेनसमेदेहेजीवेनाक्रम्यसंस्थिते || अनित्यप्रियसंवासेकथंति\nष्ठतिनिर्भयः"},{"r":"19.33","s":"ahitehitasaṃjñaḥsyādadhruvedhruvasaṃjñakaḥ || anarthecārthavijñānaḥ\nsvamarthayonavettisaḥ","d":"अहितेहितसंज्ञःस्यादध्रुवेध्रुवसंज्ञकः || अनर्थेचार्थविज्ञानः\nस्वमर्थयोनवेत्तिसः"},{"r":"19.34","s":"paśyannapipraskhalatiśṛṇvannapinabudhyati || paṭhanna\npinajānātidevamāyāvimohitaḥ","d":"पश्यन्नपिप्रस्खलतिशृण्वन्नपिनबुध्यति || पठन्न\nपिनजानातिदेवमायाविमोहितः"},{"r":"19.35","s":"tannimajjajagadidaṃgaṃbhīrekālasāgare || mṛtyurogajarāgrāhairnakaścidapibudhyate","d":"तन्निमज्जजगदिदंगंभीरेकालसागरे || मृत्युरोगजराग्राहैर्नकश्चिदपिबुध्यते"},{"r":"19.36","s":"pratikṣaṇamayaṃkālaḥ kṣīyamāṇonalakṣyate || āmakuṃbhaivāṃbhasthoviśīrṇo\nnavibhāvyate","d":"प्रतिक्षणमयंकालः क्षीयमाणोनलक्ष्यते || आमकुंभैवांभस्थोविशीर्णो\nनविभाव्यते"},{"r":"19.37","s":"yujyateveṣṭanaṃvāyorākāśasyacakhaṃḍanam || grathanaṃcataraṃgāṇā\nmāsthānāyuṣiyujyate","d":"युज्यतेवेष्टनंवायोराकाशस्यचखंडनम् || ग्रथनंचतरंगाणा\nमास्थानायुषियुज्यते"},{"r":"19.38","s":"pṛthivīdahyateyena meruścāpiviśīryate || śuṣyatesā\ngarajalaṃ śarīrasyacakākathā","d":"पृथिवीदह्यतेयेन मेरुश्चापिविशीर्यते || शुष्यतेसा\nगरजलं शरीरस्यचकाकथा"},{"r":"19.39","s":"apatyaṃmekalatraṃmedhanaṃmebāṃdhavāścame || jalpaṃta\nmitimartyojahaṃtikālavṛkobalāt","d":"अपत्यंमेकलत्रंमेधनंमेबांधवाश्चमे || जल्पंत\nमितिमर्त्योजहंतिकालवृकोबलात्"},{"r":"19.40","s":"idaṃkṛtamidaṃkāryamidamanyatkṛtākṛtam || ekamīhāsamāyuktaṃkṛtāṃtaḥkurutevaśam","d":"इदंकृतमिदंकार्यमिदमन्यत्कृताकृतम् || एकमीहासमायुक्तंकृतांतःकुरुतेवशम्"},{"r":"19.41","s":"śvaḥkāryamadyakurvītapūrvāhnecāparāhikam || nahimṛtyuḥpratīkṣetakṛtaṃvā\npyathavākṛtam","d":"श्वःकार्यमद्यकुर्वीतपूर्वाह्नेचापराहिकम् || नहिमृत्युःप्रतीक्षेतकृतंवा\nप्यथवाकृतम्"},{"r":"19.42","s":"jarādarśitapaṃthānaṃpracaṃḍavyādhisainikam || mṛtyuśatrumadhi\nṣṭho'sitrātāraṃkinnapaśyati","d":"जरादर्शितपंथानंप्रचंडव्याधिसैनिकम् || मृत्युशत्रुमधि\nष्ठोऽसित्रातारंकिन्नपश्यति"},{"r":"19.43","s":"tṛṣṇāsūcīvinirbhinnaṃsiktaṃviṣayasarpiṣā || rā\ngadveṣānalepakvamṛtyuraśnātimānavam","d":"तृष्णासूचीविनिर्भिन्नंसिक्तंविषयसर्पिषा || रा\nगद्वेषानलेपक्वमृत्युरश्नातिमानवम्"},{"r":"19.44","s":"bālāṃścayauvanasthāṃścavṛddhāngarbha gatā\nnapi || sarvānnaviśatemṛtyurevaṃbhūtamidaṃjagat","d":"बालांश्चयौवनस्थांश्चवृद्धान्गर्भ गता\nनपि || सर्वान्नविशतेमृत्युरेवंभूतमिदंजगत्"},{"r":"19.45","s":"svadehamapijīvo'yamuktvāyātiyamālayam || strīmātṛpitṛputrādisaṃbaṃdhaḥ kenahetunā","d":"स्वदेहमपिजीवोऽयमुक्त्वायातियमालयम् || स्त्रीमातृपितृपुत्रादिसंबंधः केनहेतुना"},{"r":"19.46","s":"duḥkhamūlaṃhisaṃsāraḥ saprasyāstisaduḥkhitaḥ || tasyatyāgaḥ kṛtoyenasasukhī\nnāparaḥkvacit","d":"दुःखमूलंहिसंसारः सप्रस्यास्तिसदुःखितः || तस्यत्यागः कृतोयेनससुखी\nनापरःक्वचित्"},{"r":"19.47","s":"prabhavaṃsarvaduḥkhānāmālayaṃsakalāpadām || āśrayaṃsarvapā\npānāṃsaṃsāraṃvarjayetkṣaṇāt","d":"प्रभवंसर्वदुःखानामालयंसकलापदाम् || आश्रयंसर्वपा\nपानांसंसारंवर्जयेत्क्षणात्"},{"r":"19.48","s":"lohadārumayaiḥ pāśaiḥpumānbaddhovimucyate || pu\ntradāramayaiḥ pāśairmucyatenakadācana","d":"लोहदारुमयैः पाशैःपुमान्बद्धोविमुच्यते || पु\nत्रदारमयैः पाशैर्मुच्यतेनकदाचन"},{"r":"19.50","s":"yāvaṃtaḥkurutejaṃtuḥsaṃbaṃdhānmanasaḥpriyān ||tāvaṃto'syanikhanyaṃtehṛdaye śoka śaṃkavaḥ\n49||vaṃcitāśeṣavittaistairnityaṃ loko vināśitaḥ || hārhaṃta viṣayāhārairdehasthairiṃdriya\ntaskaraiḥ","d":"यावंतःकुरुतेजंतुःसंबंधान्मनसःप्रियान् ||तावंतोऽस्यनिखन्यंतेहृदये शोक शंकवः\n49||वंचिताशेषवित्तैस्तैर्नित्यं लोको विनाशितः || हार्हंत विषयाहारैर्देहस्थैरिंद्रिय\nतस्करैः"},{"r":"19.51","s":"māṃsalubdhoyathāmatsyolohaśaṃkuṃnapaśyati || sukhalubdhasta\nthādehīyamabādhāṃnapaśyati","d":"मांसलुब्धोयथामत्स्योलोहशंकुंनपश्यति || सुखलुब्धस्त\nथादेहीयमबाधांनपश्यति"},{"r":"19.52","s":"hitāhitaṃnajānaṃtonityamunmārgagāminaḥ\nkukṣipūraṇaniṣṭhā ye tenarā nārakāḥ khaga","d":"हिताहितंनजानंतोनित्यमुन्मार्गगामिनः\nकुक्षिपूरणनिष्ठा ये तेनरा नारकाः खग"},{"r":"19.53","s":"nidrādimaithunāhārāḥsarveṣāṃprāṇināṃsamāḥ || jñānavānmānavaḥproktojñānahīnaḥpaśuḥ\nsmṛtaḥ","d":"निद्रादिमैथुनाहाराःसर्वेषांप्राणिनांसमाः || ज्ञानवान्मानवःप्रोक्तोज्ञानहीनःपशुः\nस्मृतः"},{"r":"19.54","s":"prabhātemalamūtrābhyāṃkṣuttṛḍbhyāṃmadhyegeravau || rātraumadananidrābhyā\nbādhyaṃtemūḍhamānavāḥ","d":"प्रभातेमलमूत्राभ्यांक्षुत्तृड्भ्यांमध्येगेरवौ || रात्रौमदननिद्राभ्या\nबाध्यंतेमूढमानवाः"},{"r":"19.55","s":"svadehadhanadārādiniratāḥsarvajaṃtavaḥ || jāyaṃtecamriyaṃ\ntecahāhaṃtājñānamohitāḥ","d":"स्वदेहधनदारादिनिरताःसर्वजंतवः || जायंतेचम्रियं\nतेचहाहंताज्ञानमोहिताः"},{"r":"19.56","s":"tasmātsaṃgaḥsadātyājyaḥsarvastyaktaṃnaśakya\nte || mahadbhiḥsahakartavyaḥsaṃtaḥsaṃgasyabheṣajam","d":"तस्मात्संगःसदात्याज्यःसर्वस्त्यक्तंनशक्य\nते || महद्भिःसहकर्तव्यःसंतःसंगस्यभेषजम्"},{"r":"19.57","s":"satsaṃgaścavivekaścanirmalaṃnayanadvayam|| yasyanāstinaraḥsoṃ'dhaḥkathaṃnasyādamārgagaḥ","d":"सत्संगश्चविवेकश्चनिर्मलंनयनद्वयम्|| यस्यनास्तिनरःसोंऽधःकथंनस्यादमार्गगः"},{"r":"19.58","s":"svasvavarṇāśramācāraniratāḥsarvamānavāḥ || najānaṃtiparaṃdharmavṛthānaśyaṃ\ntidāṃbhikāḥ","d":"स्वस्ववर्णाश्रमाचारनिरताःसर्वमानवाः || नजानंतिपरंधर्मवृथानश्यं\nतिदांभिकाः"},{"r":"19.59","s":"kriyāyāsaparāḥkecidvratacaryādisaṃyutāḥ|| ajñānasaṃvṛtā\ntmānaḥsaṃcaraṃtipracārakāḥ","d":"क्रियायासपराःकेचिद्व्रतचर्यादिसंयुताः|| अज्ञानसंवृता\nत्मानःसंचरंतिप्रचारकाः"},{"r":"19.60","s":"nāmamātreṇasaṃtuṣṭāḥkarmakāṃḍagatānarāḥ || maṃtroccāraṇahomādyairbhramitāḥkratuvista\nraiḥ","d":"नाममात्रेणसंतुष्टाःकर्मकांडगतानराः || मंत्रोच्चारणहोमाद्यैर्भ्रमिताःक्रतुविस्त\nरैः"},{"r":"19.61","s":"ekabhuktopavāsādyairniyamaiḥkāyaśoṣaṇaiḥ || mūḍhāḥparokṣamicchaṃtimama\nmāyāvimohitāḥ","d":"एकभुक्तोपवासाद्यैर्नियमैःकायशोषणैः || मूढाःपरोक्षमिच्छंतिमम\nमायाविमोहिताः"},{"r":"19.62","s":"dehadaṃḍanamātreṇakāmuktiravivekinām || valmīkatā\nḍanādevamṛtaḥkutramahoragaḥ","d":"देहदंडनमात्रेणकामुक्तिरविवेकिनाम् || वल्मीकता\nडनादेवमृतःकुत्रमहोरगः"},{"r":"19.63","s":"jaṭābhārājinairyuktādāṃbhikāveṣadhāriṇaḥ\nbhramaṃtijñānivallokebhrāmayaṃtijanānapi","d":"जटाभाराजिनैर्युक्तादांभिकावेषधारिणः\nभ्रमंतिज्ञानिवल्लोकेभ्रामयंतिजनानपि"},{"r":"19.64","s":"saṃsārajasukhāsaktaṃbrahmajño'smītivādinam || karmabrahmobhayabhraṣṭaṃtaṃtyajedaṃtyajaṃya\nthā","d":"संसारजसुखासक्तंब्रह्मज्ञोऽस्मीतिवादिनम् || कर्मब्रह्मोभयभ्रष्टंतंत्यजेदंत्यजंय\nथा"},{"r":"19.65","s":"gṛhāraṇyasamālokegatavrīḍādigaṃbarāḥ|| caraṃtigardabhādyāścaviraktā\nstebhavaṃtikim","d":"गृहारण्यसमालोकेगतव्रीडादिगंबराः|| चरंतिगर्दभाद्याश्चविरक्ता\nस्तेभवंतिकिम्"},{"r":"19.66","s":"mṛdbhasmoddhūlanādevamuktāḥsyuryadimānavāḥ|| mṛdbhasmavā\nsīnityaṃśvāsākiṃmuktobhaviṣyati","d":"मृद्भस्मोद्धूलनादेवमुक्ताःस्युर्यदिमानवाः|| मृद्भस्मवा\nसीनित्यंश्वासाकिंमुक्तोभविष्यति"},{"r":"19.67","s":"tṛṇaparṇodakāhārāḥsatataṃvanavāsinaḥ\njaṃbūkākhumṛgādyāścatāpasāstebhavaṃtikim","d":"तृणपर्णोदकाहाराःसततंवनवासिनः\nजंबूकाखुमृगाद्याश्चतापसास्तेभवंतिकिम्"},{"r":"19.68","s":"ājanmamaraṇāṃtaṃcagaṃgāditaṭinīsthitāḥ || maṃḍūkamatsyapramukhā yoginastebhavaṃti\nkim","d":"आजन्ममरणांतंचगंगादितटिनीस्थिताः || मंडूकमत्स्यप्रमुखा योगिनस्तेभवंति\nकिम्"},{"r":"19.69","s":"pārāvatāḥśilāhārāḥkar̤hācidapicātakāḥ || napibaṃtimahītòyaṃ\nvratinastebhavaṃtikim","d":"पारावताःशिलाहाराःकर्̤हाचिदपिचातकाः || नपिबंतिमहीत्òयं\nव्रतिनस्तेभवंतिकिम्"},{"r":"19.70","s":"tasmādityādikaṃkarmalokaraṃjanakārakam || mokṣa\nsyakāraṇaṃ sākṣāttattvajñānaṃkhageśvara","d":"तस्मादित्यादिकंकर्मलोकरंजनकारकम् || मोक्ष\nस्यकारणं साक्षात्तत्त्वज्ञानंखगेश्वर"},{"r":"19.71","s":"ṣaḍdarśanamahākūpepatitāḥpaśavaḥkhaga || paramārthaṃnajānaṃtipaśupaśaniyaṃtritāḥ","d":"षड्दर्शनमहाकूपेपतिताःपशवःखग || परमार्थंनजानंतिपशुपशनियंत्रिताः"},{"r":"19.72","s":"vedaśāstrārṇaveghoreūhyamānāitastataḥ || ṣaḍūrminigrahagrastāstiṣṭhaṃti\nhikutārkikāḥ","d":"वेदशास्त्रार्णवेघोरेऊह्यमानाइतस्ततः || षडूर्मिनिग्रहग्रस्तास्तिष्ठंति\nहिकुतार्किकाः"},{"r":"19.73","s":"vedāgamapurāṇajñaḥ paramārthaṃ na vetti yaḥ || viḍaṃbakasya tasyaiva tatsarvaṃ kākabhāṣitam","d":"वेदागमपुराणज्ञः परमार्थं न वेत्ति यः || विडंबकस्य तस्यैव तत्सर्वं काकभाषितम्"},{"r":"19.74","s":"idaṃ jñānamidaṃ jñeyamiti ciṃtāsamākulāḥ || paṭhaṃtyaharniśaṃ śāstraṃ paratattvaparā\nṅmukhāḥ","d":"इदं ज्ञानमिदं ज्ञेयमिति चिंतासमाकुलाः || पठंत्यहर्निशं शास्त्रं परतत्त्वपरा\nङ्मुखाः"},{"r":"19.75","s":"vākyacchandonibandhena kāvyālaṃkāraśobhitāḥ || ciṃtayā duḥkhi\ntāmūḍhāstiṣṭhaṃtivyākuleṃdriyāḥ","d":"वाक्यच्छन्दोनिबन्धेन काव्यालंकारशोभिताः || चिंतया दुःखि\nतामूढास्तिष्ठंतिव्याकुलेंद्रियाः"},{"r":"19.76","s":"anyathāparamaṃtattvaṃjanāḥkliiyaṃtiyānyathā || anyathāśāstrasadbhāvovyākhyāṃkurvati\ncānyathā","d":"अन्यथापरमंतत्त्वंजनाःक्लिइयंतियान्यथा || अन्यथाशास्त्रसद्भावोव्याख्यांकुर्वति\nचान्यथा"},{"r":"19.77","s":"kathayaṃtyunmanībhāvaṃsvayaṃnānubhavaṃtica || ahaṃkāraratāḥkeci\ndupadeśādivarjitāḥ","d":"कथयंत्युन्मनीभावंस्वयंनानुभवंतिच || अहंकाररताःकेचि\nदुपदेशादिवर्जिताः"},{"r":"19.78","s":"paṭhaṃtivedaśāstrāṇibodhayaṃtiparasparam || najānaṃ\ntiparaṃtattvaṃdarvīpākarasaṃyathā","d":"पठंतिवेदशास्त्राणिबोधयंतिपरस्परम् || नजानं\nतिपरंतत्त्वंदर्वीपाकरसंयथा"},{"r":"19.79","s":"śirovahatipuṣpāṇigaṃdhaṃjānātināsikā || paṭhaṃtivedaśāstrāṇidurlabhobhāvabodha\nkaḥ","d":"शिरोवहतिपुष्पाणिगंधंजानातिनासिका || पठंतिवेदशास्त्राणिदुर्लभोभावबोध\nकः"},{"r":"19.80","s":"tattvamātmasthamajñātvāmūḍhaḥśāstreṣumuhyati || gopaḥkukṣigatechāgekū\npepaśyatidurmatiḥ","d":"तत्त्वमात्मस्थमज्ञात्वामूढःशास्त्रेषुमुह्यति || गोपःकुक्षिगतेछागेकू\nपेपश्यतिदुर्मतिः"},{"r":"19.81","s":"saṃsāramohanāśāyaśabdabodhonahikṣamaḥ || nanivarte\ntatimiraṃkadāciddīDefaultpavārtayā","d":"संसारमोहनाशायशब्दबोधोनहिक्षमः || ननिवर्ते\nततिमिरंकदाचिद्दीदेfऔल्त्पवार्तया"},{"r":"19.82","s":"prajñāhīnasyapaṭhanaṃyathāṃdhasyacadarpaṇam || a\ntaḥprajñāvatāṃśāstraṃtattvajñānasyalakṣaṇam","d":"प्रज्ञाहीनस्यपठनंयथांधस्यचदर्पणम् || अ\nतःप्रज्ञावतांशास्त्रंतत्त्वज्ञानस्यलक्षणम्"},{"r":"19.83","s":"idaṃjñānamidaṃjñeyaṃsarvaṃtuśrotumi\ncchati || divyavarṣasahasrāyuḥśāstrāṃtaṃnaivagacchati","d":"इदंज्ञानमिदंज्ञेयंसर्वंतुश्रोतुमि\nच्छति || दिव्यवर्षसहस्रायुःशास्त्रांतंनैवगच्छति"},{"r":"19.84","s":"anekānicaśāstrāṇisvalpāyurvighnakoṭayaḥ|| tasmātsāraṃvijānīyātkṣīraṃhaṃsaivāṃbhasi","d":"अनेकानिचशास्त्राणिस्वल्पायुर्विघ्नकोटयः|| तस्मात्सारंविजानीयात्क्षीरंहंसैवांभसि"},{"r":"19.85","s":"abhyasyavedaśāstrāṇitattvaṃjñātvāthabuddhimān || palālamivadhānyārthīsarvaśāstrāṇisaṃtyajet","d":"अभ्यस्यवेदशास्त्राणितत्त्वंज्ञात्वाथबुद्धिमान् || पलालमिवधान्यार्थीसर्वशास्त्राणिसंत्यजेत्"},{"r":"19.86","s":"yathāmṛtenatṛptasyanāhāreṇaprayojanam || tattvajñasyatathātāyainaśāstreṇaprayojanam","d":"यथामृतेनतृप्तस्यनाहारेणप्रयोजनम् || तत्त्वज्ञस्यतथातायैनशास्त्रेणप्रयोजनम्"},{"r":"19.87","s":"ṇavedādhyānānmuktirnaśāstrapaṭhanādapi || jñānādevahikaivalyaṃnānyathāvinatātma\nja","d":"णवेदाध्यानान्मुक्तिर्नशास्त्रपठनादपि || ज्ञानादेवहिकैवल्यंनान्यथाविनतात्म\nज"},{"r":"19.88","s":"nāśramaḥkāraṇaṃmukterdarśanāninakāraṇam || tathaivasarvakarmāṇijñānameva\nhikāraṇam","d":"नाश्रमःकारणंमुक्तेर्दर्शनानिनकारणम् || तथैवसर्वकर्माणिज्ञानमेव\nहिकारणम्"},{"r":"19.89","s":"muktidāguruvāgekāvidyāsarvāviḍaṃbakā || kāṣṭhabhārasahasreṣu\nhyekaṃsaṃjīvanaṃparam","d":"मुक्तिदागुरुवागेकाविद्यासर्वाविडंबका || काष्ठभारसहस्रेषु\nह्येकंसंजीवनंपरम्"},{"r":"19.90","s":"advaitaṃ hi śivaṃ proktaṃ kriyāyāsavivarjitam || guruvaktreṇa labhyeta nādhītāgamakoṭi\nbhiḥ","d":"अद्वैतं हि शिवं प्रोक्तं क्रियायासविवर्जितम् || गुरुवक्त्रेण लभ्येत नाधीतागमकोटि\nभिः"},{"r":"19.91","s":"āgamoktaṃ vivekotthaṃ dvidhā jñānaṃ pracakṣate || śabdabrahmāgamamayaṃ paraṃbra\nhma vivekajam","d":"आगमोक्तं विवेकोत्थं द्विधा ज्ञानं प्रचक्षते || शब्दब्रह्मागममयं परंब्र\nह्म विवेकजम्"},{"r":"19.92","s":"advaitaṃkecidicchaṃtidvaitamicchaṃticāpare || samaṃtattvaṃnajānaṃtidvaitādvaitavivarjita\nm","d":"अद्वैतंकेचिदिच्छंतिद्वैतमिच्छंतिचापरे || समंतत्त्वंनजानंतिद्वैताद्वैतविवर्जित\nम्"},{"r":"19.93","s":"dvepadebaṃdhamokṣāyanamametimametica || mametibadhyatejaṃturnamametipramu\ncyate","d":"द्वेपदेबंधमोक्षायनममेतिममेतिच || ममेतिबध्यतेजंतुर्नममेतिप्रमु\nच्यते"},{"r":"19.94","s":"tatkarmayannabaṃdhāyasāvidyāyāvimuktadā || āyāsāyāparaṃkarmavi\ndyānyāśilpanaipuṇam","d":"तत्कर्मयन्नबंधायसाविद्यायाविमुक्तदा || आयासायापरंकर्मवि\nद्यान्याशिल्पनैपुणम्"},{"r":"19.95","s":"yāvatkarmāṇidīyaṃteyāvatsaṃsāravāsanā || yāvadiṃdriyacāpatyaṃtāvattattvakathāku\ntaḥ","d":"यावत्कर्माणिदीयंतेयावत्संसारवासना || यावदिंद्रियचापत्यंतावत्तत्त्वकथाकु\nतः"},{"r":"19.96","s":"yāvaddehābhimānaścamamatāyāvadevahi || yāvatprayatnavego'stiyāvatsaṃ\nkalpakalpanā","d":"यावद्देहाभिमानश्चममतायावदेवहि || यावत्प्रयत्नवेगोऽस्तियावत्सं\nकल्पकल्पना"},{"r":"19.97","s":"yāvannomanasaḥsthairyaṃnayāvacchāstraciṃtanam || yāvannagurukā\nruṇyatāvattattvakathākutaḥ","d":"यावन्नोमनसःस्थैर्यंनयावच्छास्त्रचिंतनम् || यावन्नगुरुका\nरुण्यतावत्तत्त्वकथाकुतः"},{"r":"19.98","s":"tāvattapovrataṃtīrthaṃjapahaumārcanādikam || veda\nśāstrāgamakathāyāvattattvaṃnaviṃ‌dati","d":"तावत्तपोव्रतंतीर्थंजपहौमार्चनादिकम् || वेद\nशास्त्रागमकथायावत्तत्त्वंनविं‌दति"},{"r":"19.99","s":"tasmātsarvaprayatnenasarvāvasthāsusarvadā || tattvaniṣṭhobhavettākṣyaryadīcchenmokṣamā\ntmanaḥ","d":"तस्मात्सर्वप्रयत्नेनसर्वावस्थासुसर्वदा || तत्त्वनिष्ठोभवेत्ताक्ष्यर्यदीच्छेन्मोक्षमा\nत्मनः"},{"r":"19.100","s":"dharmajñānaprasūnasyasvargamokṣaphalasyaca || tāpatrayādisaṃtaptacchā\nyāṃmokṣataroḥśrayet","d":"धर्मज्ञानप्रसूनस्यस्वर्गमोक्षफलस्यच || तापत्रयादिसंतप्तच्छा\nयांमोक्षतरोःश्रयेत्"},{"r":"19.101","s":"tasmājjñānenātmatattvaṃvijñeyaṃśrīgurormukhāt || su\nkhenamucyatejaṃturghoraṃsaṃsārabaṃdhanāt","d":"तस्माज्ज्ञानेनात्मतत्त्वंविज्ञेयंश्रीगुरोर्मुखात् || सु\nखेनमुच्यतेजंतुर्घोरंसंसारबंधनात्"},{"r":"19.102","s":"tattvajñasyāṃtimaṃkṛtyaṃśṛṇuvakṣyāmi\nte'dhunā || yenamokṣamavāpnotibrahmanirvāṇasaṃjñakam\naṃtakāletupuruṣaāgategatasādhvasaḥ || chiṃdyādasaṃgāśastreṇaspṛhāṃdehenuyecatam\ngṛhātpravrajitodhīraḥpuṇyatīrthajalāplutaḥ || śucauviviktaāsīnovidhi\nvatkalpitāsane\nabhyasenmanasāśuddhaṃtrivṛdbrahmākṣaraṃparam || manoyacchejjita\nśvāsobrahmabījamavismaran\nniyaccheddhiṣayebhyokṣānmanasābuddhisārathiḥ\nmanaḥkarmabhirākṣiptaṃśubhārthedhārayeddhiyā\nahaṃ brahma paraṃ dhāma brahmāhaṃ paramaṃ padam || evaṃ samīkṣya cātmānamātmanyādhāya niṣka\nle\nomityekākṣaraṃ brahma vyāharanmāmanusmaran || yaḥ prayāti tyajandehaṃ sa\nyāti paramāṃ gatim\nna yatra dāṃbhikā yāṃti jñānavairāgyavarjitāḥ || sudhiya\nstāṃ gatiṃ yāṃti tānahaṃ kathayāmi te","d":"तत्त्वज्ञस्यांतिमंकृत्यंशृणुवक्ष्यामि\nतेऽधुना || येनमोक्षमवाप्नोतिब्रह्मनिर्वाणसंज्ञकम्\nअंतकालेतुपुरुषआगतेगतसाध्वसः || छिंद्यादसंगाशस्त्रेणस्पृहांदेहेनुयेचतम्\nगृहात्प्रव्रजितोधीरःपुण्यतीर्थजलाप्लुतः || शुचौविविक्तआसीनोविधि\nवत्कल्पितासने\nअभ्यसेन्मनसाशुद्धंत्रिवृद्ब्रह्माक्षरंपरम् || मनोयच्छेज्जित\nश्वासोब्रह्मबीजमविस्मरन्\nनियच्छेद्धिषयेभ्योक्षान्मनसाबुद्धिसारथिः\nमनःकर्मभिराक्षिप्तंशुभार्थेधारयेद्धिया\nअहं ब्रह्म परं धाम ब्रह्माहं परमं पदम् || एवं समीक्ष्य चात्मानमात्मन्याधाय निष्क\nले\nओमित्येकाक्षरं ब्रह्म व्याहरन्मामनुस्मरन् || यः प्रयाति त्यजन्देहं स\nयाति परमां गतिम्\nन यत्र दांभिका यांति ज्ञानवैराग्यवर्जिताः || सुधिय\nस्तां गतिं यांति तानहं कथयामि ते"},{"r":"19.102-c2","s":"nirmānamohājitasaṃgadoṣāadhyātmanityāvinivṛttakāmāḥ || dvaṃdairvimuktāḥsukha\nduḥkhasaṃjñairgacchaṃtyamūḍhāḥpadamavyayaṃtat\njñānahradesatyajalerāgadveṣamalāpa\nhe || yaḥsnātimānasetīrthesavaimokṣamavāpnuyāt\nprauḍhavairāgyamāsthāyabhajate\nmāmananyabhāk || pūrṇadṛṣṭiḥprasannātmā savaimokṣamavāpnuyāt\ntyaktvāgṛhaṃcayastīrthenivasenmaraṇotsukaḥ || mriyatemuktikṣetreṣusavaimokṣamavāpnuyā\nt||13||ayodhyāmadhurāmāyākāśīkāṃcī avaṃtikā|| purīdvārāvatījñeyāsaptaitāmo\nkṣadāyakāḥ\nititekathitaṃtākṣaryamokṣadharmaṃsanātanam || jñānavairāgyasahitaṃśru\ntvāmokṣamavāpnuyāt\nmokṣaṃgacchaṃtitattvajñādhārmikāḥsvargataṃnarāḥ|| pāpino\ndurgaṃtiyāṃtisaṃsaraṃtikhagādayaḥ\nityevaṃsarvaśāstrāṇāṃsāroddhāronirūpitaḥ || mayāteṣoḍaśādhyāyaiḥ kiṃbhūyaḥśrotumi\ncchasi","d":"निर्मानमोहाजितसंगदोषाअध्यात्मनित्याविनिवृत्तकामाः || द्वंदैर्विमुक्ताःसुख\nदुःखसंज्ञैर्गच्छंत्यमूढाःपदमव्ययंतत्\nज्ञानह्रदेसत्यजलेरागद्वेषमलाप\nहे || यःस्नातिमानसेतीर्थेसवैमोक्षमवाप्नुयात्\nप्रौढवैराग्यमास्थायभजते\nमामनन्यभाक् || पूर्णदृष्टिःप्रसन्नात्मा सवैमोक्षमवाप्नुयात्\nत्यक्त्वागृहंचयस्तीर्थेनिवसेन्मरणोत्सुकः || म्रियतेमुक्तिक्षेत्रेषुसवैमोक्षमवाप्नुया\nत्||13||अयोध्यामधुरामायाकाशीकांची अवंतिका|| पुरीद्वारावतीज्ञेयासप्तैतामो\nक्षदायकाः\nइतितेकथितंताक्षर्यमोक्षधर्मंसनातनम् || ज्ञानवैराग्यसहितंश्रु\nत्वामोक्षमवाप्नुयात्\nमोक्षंगच्छंतितत्त्वज्ञाधार्मिकाःस्वर्गतंनराः|| पापिनो\nदुर्गंतियांतिसंसरंतिखगादयः\nइत्येवंसर्वशास्त्राणांसारोद्धारोनिरूपितः || मयातेषोडशाध्यायैः किंभूयःश्रोतुमि\nच्छसि"},{"r":"19.102-c3","s":"sūtauvāca || evaṃśrutvāvacorājangaruḍobhagavanmukhāt || kṛtāṃja\nliruvācedaṃtaṃpraṇamyamuhurmuhuḥ\nbhagavandevadeveśaśrāvayitvāvacomṛtam\ntārito'haṃtvayānāthabhavasāgarataḥprabho\nsthitosmigatasaṃdehaḥkṛtārthosmi\nnasaṃśayaḥ||ityuktvāgaruḍastūṣṇīṃsthitvādhyānaparo'bhavat","d":"सूतौवाच || एवंश्रुत्वावचोराजन्गरुडोभगवन्मुखात् || कृतांज\nलिरुवाचेदंतंप्रणम्यमुहुर्मुहुः\nभगवन्देवदेवेशश्रावयित्वावचोमृतम्\nतारितोऽहंत्वयानाथभवसागरतःप्रभो\nस्थितोस्मिगतसंदेहःकृतार्थोस्मि\nनसंशयः||इत्युक्त्वागरुडस्तूष्णींस्थित्वाध्यानपरोऽभवत्"},{"r":"19.121","s":"smaraṇāddurga\ntihartāpūjanayajñenasadgaterdātā || yaḥparayānijabhaktyādadātimuktiṃsamāṃhariḥ\npātu","d":"स्मरणाद्दुर्ग\nतिहर्तापूजनयज्ञेनसद्गतेर्दाता || यःपरयानिजभक्त्याददातिमुक्तिंसमांहरिः\nपातु"}],"20":[{"r":"20.1","s":"cha || || śrīkṛṣṇārpaṇamastu || || cha\nśrīgaṇeśāyanamaḥ|| śrībhagavānuvāca || ityākhyātaṃmayātākṣyasarvamevaurdhvadaihika\nm || daśāhābhyaṃta reśrutvāsarvapāpaiḥpramucyate","d":"छ || || श्रीकृष्णार्पणमस्तु || || छ\nश्रीगणेशायनमः|| श्रीभगवानुवाच || इत्याख्यातंमयाताक्ष्यसर्वमेवौर्ध्वदैहिक\nम् || दशाहाभ्यंत रेश्रुत्वासर्वपापैःप्रमुच्यते"},{"r":"20.2","s":"idaṃcāmuṣmikaṃkarmapitṛmukti\npradāyakam || putravāṃchitadaṃcaivaparatrehasukhapradam","d":"इदंचामुष्मिकंकर्मपितृमुक्ति\nप्रदायकम् || पुत्रवांछितदंचैवपरत्रेहसुखप्रदम्"},{"r":"20.3","s":"idaṃkarmanakurvatiyenāsti\nkānarādhamāḥ || teṣāṃjalamapeyaṃ syātsurātulyaṃnasaṃśayaḥ","d":"इदंकर्मनकुर्वतियेनास्ति\nकानराधमाः || तेषांजलमपेयं स्यात्सुरातुल्यंनसंशयः"},{"r":"20.4","s":"devatāḥpitaraścaivanai\nvapaśyaṃtitadgṛham || bhavaṃtitaṣāṃkopenaputrāḥpautrāścadurgatāḥ","d":"देवताःपितरश्चैवनै\nवपश्यंतितद्गृहम् || भवंतितषांकोपेनपुत्राःपौत्राश्चदुर्गताः"},{"r":"20.5","s":"brāhmaṇāḥkṣa\ntriyāvaiśyāḥśūdrāścaiveta repiva || tecāṃḍālasamā jñeyāḥsarvapreta kriyāṃvinā","d":"ब्राह्मणाःक्ष\nत्रियावैश्याःशूद्राश्चैवेत रेपिव || तेचांडालसमा ज्ञेयाःसर्वप्रेत क्रियांविना"},{"r":"20.6","s":"pretakalpamidaṃpuṇyaṃśṛṇotiśrāvayecca yaḥ || ubhautaupāpanirmuktaudurgatiṃnaivagacchataḥ","d":"प्रेतकल्पमिदंपुण्यंशृणोतिश्रावयेच्च यः || उभौतौपापनिर्मुक्तौदुर्गतिंनैवगच्छतः"},{"r":"20.7","s":"mātāpitroścamaraṇesauparṇaṃśṛṇutetuyaḥ || pitaraumuktimāpannausutaḥsaṃtati\nmānbhavet","d":"मातापित्रोश्चमरणेसौपर्णंशृणुतेतुयः || पितरौमुक्तिमापन्नौसुतःसंतति\nमान्भवेत्"},{"r":"20.8","s":"naśrutaṃgāruḍaṃyenagayāśrāddhaṃcanokṛtam || vṛṣotsargaḥkṛtonaivana\ncamāsikavārṣike","d":"नश्रुतंगारुडंयेनगयाश्राद्धंचनोकृतम् || वृषोत्सर्गःकृतोनैवन\nचमासिकवार्षिके"},{"r":"20.9","s":"sakathaṃkathyateputraḥ kathaṃmucyehaṇatrayāt || mātaraṃpitaraṃ\ncaivakathaṃtārayituṃkṣamaḥ","d":"सकथंकथ्यतेपुत्रः कथंमुच्येहणत्रयात् || मातरंपितरं\nचैवकथंतारयितुंक्षमः"},{"r":"20.10","s":"tasmātsarvaprayatnenaśrotavyaṃgāruḍaṃkila || dharmārtha\nkāmamokṣāṇāṃdāyakaṃduḥkhanāśanam","d":"तस्मात्सर्वप्रयत्नेनश्रोतव्यंगारुडंकिल || धर्मार्थ\nकाममोक्षाणांदायकंदुःखनाशनम्"},{"r":"20.11","s":"purāṇaṃ gāruḍaṃpuṇyaṃpavitraṃpāpanāśanam\nśṛṇvatāṃkāmanāpūraṃśrotavyaṃsarvadaivahi","d":"पुराणं गारुडंपुण्यंपवित्रंपापनाशनम्\nशृण्वतांकामनापूरंश्रोतव्यंसर्वदैवहि"},{"r":"20.12","s":"brāhmaṇolabhatevidyāṃkṣatriyaḥpṛthi\nvīṃlabheta || vaiśyodhanikatāmetiśūdraḥśudhyatipātakāt","d":"ब्राह्मणोलभतेविद्यांक्षत्रियःपृथि\nवींलभेत || वैश्योधनिकतामेतिशूद्रःशुध्यतिपातकात्"},{"r":"20.13","s":"śrutvānānāni\ndeyānivācakāyākhilānica || pūrvoktaśayanādīninānyathāsaphalaṃbhavet","d":"श्रुत्वानानानि\nदेयानिवाचकायाखिलानिच || पूर्वोक्तशयनादीनिनान्यथासफलंभवेत्"},{"r":"20.14","s":"purāṇaṃpūjayetpūrvavācakaṃtadanaṃtaram || vastrālaṃkāragodānairdakṣiṇābhiścasādaram","d":"पुराणंपूजयेत्पूर्ववाचकंतदनंतरम् || वस्त्रालंकारगोदानैर्दक्षिणाभिश्चसादरम्"},{"r":"20.15","s":"annaiścahemadānaiścabhūmidānaiścabhūmibhiḥ || pūjayedvācakaṃbhaktyābahupuṇya\nphalāptaye","d":"अन्नैश्चहेमदानैश्चभूमिदानैश्चभूमिभिः || पूजयेद्वाचकंभक्त्याबहुपुण्य\nफलाप्तये"},{"r":"20.16","s":"vācakasyārcanenaivapūjito'haṃnasaṃśayaḥ || saṃtuṣṭetuṣṭitāṃyāmi\nvācakenātrasaṃśayaḥ","d":"वाचकस्यार्चनेनैवपूजितोऽहंनसंशयः || संतुष्टेतुष्टितांयामि\nवाचकेनात्रसंशयः"}],"21":[{"r":"21.1","s":"itiśrīgaruḍapurāṇeśravaṇaphalaṃ || āsīdvaktāpurāṇa\nsyaśrīśārdūlamahīpateḥ || jhuṃjhuṇūnagarasyāpimiśraḥśrīsukhalālajī","d":"इतिश्रीगरुडपुराणेश्रवणफलं || आसीद्वक्तापुराण\nस्यश्रीशार्दूलमहीपतेः || झुंझुणूनगरस्यापिमिश्रःश्रीसुखलालजी"},{"r":"21.2","s":"tasya\nśrīharinārāyaṇātmajastatsutenatu || māyānaunidhirāmeṇakṛto'yaṃsārasaṃgrahaḥ","d":"तस्य\nश्रीहरिनारायणात्मजस्तत्सुतेनतु || मायानौनिधिरामेणकृतोऽयंसारसंग्रहः"},{"r":"21.3","s":"prācīnairyatkṛtaḥpūrvaṃgāruḍaḥsārasaṃgrahaḥ || satunobuddhidaurbalyājjñātasta\nsmādayaṃkṛtaḥ","d":"प्राचीनैर्यत्कृतःपूर्वंगारुडःसारसंग्रहः || सतुनोबुद्धिदौर्बल्याज्ज्ञातस्त\nस्मादयंकृतः"},{"r":"21.4","s":"punaruktiṃparityajyakrameṇāyaṃmayākṛtaḥ || bālānāṃsukhabo\ndhāyanatupāṃḍityagarvataḥ","d":"पुनरुक्तिंपरित्यज्यक्रमेणायंमयाकृतः || बालानांसुखबो\nधायनतुपांडित्यगर्वतः"},{"r":"21.5","s":"atrāpramāṇaṃyatkiṃcitpramādallikhitaṃmayā || viddha\ndbhiḥsuvicāryevaśodhanīyo'nasūyibhiḥ","d":"अत्राप्रमाणंयत्किंचित्प्रमादल्लिखितंमया || विद्ध\nद्भिःसुविचार्येवशोधनीयोऽनसूयिभिः"},{"r":"21.6","s":"sāroddhāromayāmūrlairbahugraṃthairyathākṛtaḥ\ntathaivānekaṭīkābhiruddhṛtaḥsārasaṃgrahaḥ","d":"सारोद्धारोमयामूर्लैर्बहुग्रंथैर्यथाकृतः\nतथैवानेकटीकाभिरुद्धृतःसारसंग्रहः"},{"r":"21.7","s":"mahākhedānmayātaṃtrayathāsthānaṃniyo\njitaḥ || prājñaṃvināprayāsaṃmekojñāsyativimūḍhadhīḥ","d":"महाखेदान्मयातंत्रयथास्थानंनियो\nजितः || प्राज्ञंविनाप्रयासंमेकोज्ञास्यतिविमूढधीः"},{"r":"21.8","s":"vidvānevahijānāti\nvaddhajanapariśramam || nahivaṃdhyāvijānātigurvīṃ prasavavedanām","d":"विद्वानेवहिजानाति\nवद्धजनपरिश्रमम् || नहिवंध्याविजानातिगुर्वीं प्रसववेदनाम्"},{"r":"21.9","s":"yepūrvvasaṃ\ngrahemūḍhānaivajānaṃtiyogyatām || tekathaṃhibhaviṣyaṃtiharṣitāḥpaṭhane'syaca","d":"येपूर्व्वसं\nग्रहेमूढानैवजानंतियोग्यताम् || तेकथंहिभविष्यंतिहर्षिताःपठनेऽस्यच"},{"r":"21.10","s":"sāroddhāramimaṃmiśrāḥpaṭhaṃtunapaṭhaṃtuvā||mayātusvīyabodhāyakṛtametannasarvvaśaḥ","d":"सारोद्धारमिमंमिश्राःपठंतुनपठंतुवा||मयातुस्वीयबोधायकृतमेतन्नसर्व्वशः"},{"r":"21.11","s":"maṃgaḷaṃbhagavānviṣṇurmaṃgalaṃgaruḍadhvajaḥ || maṃgalaṃpuṃḍarīkākṣomaṃgalāyatanohrariḥ","d":"मंगऌअंभगवान्विष्णुर्मंगलंगरुडध्वजः || मंगलंपुंडरीकाक्षोमंगलायतनोह्ररिः"},{"r":"21.12","s":"lābhasteṣāṃjayasteṣāṃkutasteṣāṃparājayaḥ || yeṣāmiṃdīvaraśyāmohṛdaya\nsthojanārddanaḥ","d":"लाभस्तेषांजयस्तेषांकुतस्तेषांपराजयः || येषामिंदीवरश्यामोहृदय\nस्थोजनार्द्दनः"},{"r":"21.13","s":"rājānaḥparipālayaṃtuvasudhāṃdharmesthitāḥsarvvadāpṛthvīkāmadu\nghābhavatvaviralaṃvarṣaṃtukāleghanāḥ || īrṣyāmujjhatudurjanaḥparaguṇeṣvāsajjatāṃsajjanaḥ\nsatkāvyāmṛtavarṣiṇīkavimukhevāṇīciraṃnaṃdatu\nitiśrīgaruḍapurāṇe\nsvakṛtaślokāḥsamāptāḥ\niti saṭīkaṃ garuḍapurāṇaṃ samāptam","d":"राजानःपरिपालयंतुवसुधांधर्मेस्थिताःसर्व्वदापृथ्वीकामदु\nघाभवत्वविरलंवर्षंतुकालेघनाः || ईर्ष्यामुज्झतुदुर्जनःपरगुणेष्वासज्जतांसज्जनः\nसत्काव्यामृतवर्षिणीकविमुखेवाणीचिरंनंदतु\nइतिश्रीगरुडपुराणे\nस्वकृतश्लोकाःसमाप्ताः\nइति सटीकं गरुडपुराणं समाप्तम्"}]}