{"1":[{"r":"1.1","s":"atha yogānuśāsanam ||","d":"अथ योगानुशासनम् ||","t":"prathamaḥ pādaḥ"},{"r":"1.2","s":"yogaś cittavṛttinirodhaḥ ||","d":"योगश् चित्तवृत्तिनिरोधः ||"},{"r":"1.3","s":"tadā draṣṭuḥ svarūpe 'vasthānam ||","d":"तदा द्रष्टुः स्वरूपे ऽवस्थानम् ||"},{"r":"1.4","s":"vṛttisārūpyam itaratra ||","d":"वृत्तिसारूप्यम् इतरत्र ||"},{"r":"1.5","s":"vṛttayaḥ pañcatayyaḥ kliṣṭākliṣṭāḥ ||","d":"वृत्तयः पञ्चतय्यः क्लिष्टाक्लिष्टाः ||"},{"r":"1.6","s":"pramāṇaviparyayavikalpanidrāsmṛtayaḥ ||","d":"प्रमाणविपर्ययविकल्पनिद्रास्मृतयः ||"},{"r":"1.7","s":"pratyakṣānumānāgamāḥ pramāṇāni ||","d":"प्रत्यक्षानुमानागमाः प्रमाणानि ||"},{"r":"1.8","s":"viparyayo mithyājñānam atadrūpapratiṣṭham ||","d":"विपर्ययो मिथ्याज्ञानम् अतद्रूपप्रतिष्ठम् ||"},{"r":"1.9","s":"śabdajñānānupātī vastuśūnyo vikalpaḥ ||","d":"शब्दज्ञानानुपाती वस्तुशून्यो विकल्पः ||"},{"r":"1.10","s":"abhāvapratyayālambanā vṛttir nidrā ||","d":"अभावप्रत्ययालम्बना वृत्तिर् निद्रा ||"},{"r":"1.11","s":"anubhūtaviṣayāsaṃpramoṣaḥ smṛtiḥ ||","d":"अनुभूतविषयासंप्रमोषः स्मृतिः ||"},{"r":"1.12","s":"abhyāsavairāgyābhyāṃ tannirodhaḥ ||","d":"अभ्यासवैराग्याभ्यां तन्निरोधः ||"},{"r":"1.13","s":"tatra sthitau yatno 'bhyāsaḥ ||","d":"तत्र स्थितौ यत्नो ऽभ्यासः ||"},{"r":"1.14","s":"sa tu dīrghakālanairantaryasatkārāsevito dṛḍhabhūmiḥ ||","d":"स तु दीर्घकालनैरन्तर्यसत्कारासेवितो दृढभूमिः ||"},{"r":"1.15","s":"dṛṣṭānuśravikaviṣayavitṛṣṇasya vaśīkārasaṃjñā vairāgyam ||","d":"दृष्टानुश्रविकविषयवितृष्णस्य वशीकारसंज्ञा वैराग्यम् ||"},{"r":"1.16","s":"tat paraṃ puruṣakhyāter guṇavaitṛṣṇyam ||","d":"तत् परं पुरुषख्यातेर् गुणवैतृष्ण्यम् ||"},{"r":"1.17","s":"vitarkavicārānandāsmitārūpānugamāt saṃprajñātaḥ ||","d":"वितर्कविचारानन्दास्मितारूपानुगमात् संप्रज्ञातः ||"},{"r":"1.18","s":"virāmapratyayābhyāsapūrvaḥ saṃskāraśeṣo 'nyaḥ ||","d":"विरामप्रत्ययाभ्यासपूर्वः संस्कारशेषो ऽन्यः ||"},{"r":"1.19","s":"bhavapratyayo videhaprakṛtilayānām ||","d":"भवप्रत्ययो विदेहप्रकृतिलयानाम् ||"},{"r":"1.20","s":"śraddhāvīryasmṛtisamādhiprajñāpūrvaka itareṣām ||","d":"श्रद्धावीर्यस्मृतिसमाधिप्रज्ञापूर्वक इतरेषाम् ||"},{"r":"1.21","s":"tīvrasaṃvegānām āsannaḥ ||","d":"तीव्रसंवेगानाम् आसन्नः ||"},{"r":"1.22","s":"mṛdumadhyādhimātratvāt tato 'pi viśeṣaḥ ||","d":"मृदुमध्याधिमात्रत्वात् ततो ऽपि विशेषः ||"},{"r":"1.23","s":"īśvarapraṇidhānād vā ||","d":"ईश्वरप्रणिधानाद् वा ||"},{"r":"1.24","s":"kleśakarmavipākāśayair aparāmṛṣṭaḥ puruṣaviśeṣa īśvaraḥ ||","d":"क्लेशकर्मविपाकाशयैर् अपरामृष्टः पुरुषविशेष ईश्वरः ||"},{"r":"1.25","s":"tatra niratiśayaṃ sarvajñabījam ||","d":"तत्र निरतिशयं सर्वज्ञबीजम् ||"},{"r":"1.26","s":"pūrveṣām api guruḥ kālenānavacchedāt ||","d":"पूर्वेषाम् अपि गुरुः कालेनानवच्छेदात् ||"},{"r":"1.27","s":"tasya vācakaḥ praṇavaḥ ||","d":"तस्य वाचकः प्रणवः ||"},{"r":"1.28","s":"tajjapas tadarthabhāvanam ||","d":"तज्जपस् तदर्थभावनम् ||"},{"r":"1.29","s":"tataḥ pratyakcetanādhigamo 'py antarāyābhāvaś ca ||","d":"ततः प्रत्यक्चेतनाधिगमो ऽप्य् अन्तरायाभावश् च ||"},{"r":"1.30","s":"vyādhistyānasaṃśayapramādālasyāviratibhrāntidarśanālabdhabhūmikatvānavasthitatvāni cittavikṣepās te 'ntarāyāḥ ||","d":"व्याधिस्त्यानसंशयप्रमादालस्याविरतिभ्रान्तिदर्शनालब्धभूमिकत्वानवस्थितत्वानि चित्तविक्षेपास् ते ऽन्तरायाः ||"},{"r":"1.31","s":"duḥkhadaurmanasyāṅgamejayatvaśvāsapraśvāsā vikṣepasahabhuvaḥ ||","d":"दुःखदौर्मनस्याङ्गमेजयत्वश्वासप्रश्वासा विक्षेपसहभुवः ||"},{"r":"1.32","s":"tatpratiṣedhārtham ekatattvābhyāsaḥ ||","d":"तत्प्रतिषेधार्थम् एकतत्त्वाभ्यासः ||"},{"r":"1.33","s":"maitrīkaruṇāmuditopekṣāṇāṃ sukhaduḥkhapuṇyāpuṇyaviṣayāṇāṃ bhāvanātaś cittaprasādanam ||","d":"मैत्रीकरुणामुदितोपेक्षाणां सुखदुःखपुण्यापुण्यविषयाणां भावनातश् चित्तप्रसादनम् ||"},{"r":"1.34","s":"pracchardanavidhāraṇābhyāṃ vā prāṇasya ||","d":"प्रच्छर्दनविधारणाभ्यां वा प्राणस्य ||"},{"r":"1.35","s":"viṣayavatī vā pravṛttir utpannā manasaḥ sthitinibandhanī ||","d":"विषयवती वा प्रवृत्तिर् उत्पन्ना मनसः स्थितिनिबन्धनी ||"},{"r":"1.36","s":"viśokā vā jyotiṣmatī ||","d":"विशोका वा ज्योतिष्मती ||"},{"r":"1.37","s":"vītarāgaviṣayaṃ vā cittam ||","d":"वीतरागविषयं वा चित्तम् ||"},{"r":"1.38","s":"svapnanidrājñānālambanaṃ vā ||","d":"स्वप्ननिद्राज्ञानालम्बनं वा ||"},{"r":"1.39","s":"yathābhimatadhyānād vā ||","d":"यथाभिमतध्यानाद् वा ||"},{"r":"1.40","s":"paramāṇuparamamahattvānto 'sya vaśīkāraḥ ||","d":"परमाणुपरममहत्त्वान्तो ऽस्य वशीकारः ||"},{"r":"1.41","s":"kṣīṇavṛtter abhijātasyeva maṇer grahītṛgrahaṇagrāhyeṣu tatsthatadañjanatā samāpattiḥ ||","d":"क्षीणवृत्तेर् अभिजातस्येव मणेर् ग्रहीतृग्रहणग्राह्येषु तत्स्थतदञ्जनता समापत्तिः ||"},{"r":"1.42","s":"tatra śabdārthajñānavikalpaiḥ saṃkīrṇā savitarkā samāpattiḥ ||","d":"तत्र शब्दार्थज्ञानविकल्पैः संकीर्णा सवितर्का समापत्तिः ||"},{"r":"1.43","s":"smṛtipariśuddhau svarūpaśūnyevārthamātranirbhāsā nirvitarkā ||","d":"स्मृतिपरिशुद्धौ स्वरूपशून्येवार्थमात्रनिर्भासा निर्वितर्का ||"},{"r":"1.44","s":"etayaiva savicārā nirvicārā ca sūkṣmaviṣayā vyākhyātā ||","d":"एतयैव सविचारा निर्विचारा च सूक्ष्मविषया व्याख्याता ||"},{"r":"1.45","s":"sūkṣmaviṣayatvaṃ cāliṅgaparyavasānam ||","d":"सूक्ष्मविषयत्वं चालिङ्गपर्यवसानम् ||"},{"r":"1.46","s":"tā eva sabījaḥ samādhiḥ ||","d":"ता एव सबीजः समाधिः ||"},{"r":"1.47","s":"nirvicāravaiśāradye 'dhyātmaprasādaḥ ||","d":"निर्विचारवैशारद्ये ऽध्यात्मप्रसादः ||"},{"r":"1.48","s":"ṛtaṃbharā tatra prajñā ||","d":"ऋतंभरा तत्र प्रज्ञा ||"},{"r":"1.49","s":"śrutānumānaprajñābhyām anyaviṣayā viśeṣārthatvāt ||","d":"श्रुतानुमानप्रज्ञाभ्याम् अन्यविषया विशेषार्थत्वात् ||"},{"r":"1.50","s":"tajjaḥ saṃskāro 'nyasaṃskārapratibandhī ||","d":"तज्जः संस्कारो ऽन्यसंस्कारप्रतिबन्धी ||"},{"r":"1.51","s":"tasyāpi nirodhe sarvanirodhān nirbījaḥ samādhiḥ ||","d":"तस्यापि निरोधे सर्वनिरोधान् निर्बीजः समाधिः ||"}],"2":[{"r":"2.1","s":"tapaḥsvādhyāyeśvarapraṇidhānāni kriyāyogaḥ ||","d":"तपःस्वाध्यायेश्वरप्रणिधानानि क्रियायोगः ||","t":"dvitīyaḥ pādaḥ"},{"r":"2.2","s":"samādhibhāvanārthaḥ kleśatanūkaraṇārthaś ca ||","d":"समाधिभावनार्थः क्लेशतनूकरणार्थश् च ||"},{"r":"2.3","s":"avidyāsmitārāgadveṣābhiniveśāḥ kleśāḥ ||","d":"अविद्यास्मितारागद्वेषाभिनिवेशाः क्लेशाः ||"},{"r":"2.4","s":"avidyā kṣetram uttareṣāṃ prasuptatanuvicchinnodārāṇām ||","d":"अविद्या क्षेत्रम् उत्तरेषां प्रसुप्ततनुविच्छिन्नोदाराणाम् ||"},{"r":"2.5","s":"anityāśuciduḥkhānātmasu nityaśucisukhātmakhyātir avidyā ||","d":"अनित्याशुचिदुःखानात्मसु नित्यशुचिसुखात्मख्यातिर् अविद्या ||"},{"r":"2.6","s":"dṛgdarśanaśaktyor ekātmatevāsmitā ||","d":"दृग्दर्शनशक्त्योर् एकात्मतेवास्मिता ||"},{"r":"2.7","s":"sukhānuśayī rāgaḥ ||","d":"सुखानुशयी रागः ||"},{"r":"2.8","s":"duḥkhānuśayī dveṣaḥ ||","d":"दुःखानुशयी द्वेषः ||"},{"r":"2.9","s":"svarasavāhī viduṣo 'pi tathā rūḍho 'bhiniveśaḥ ||","d":"स्वरसवाही विदुषो ऽपि तथा रूढो ऽभिनिवेशः ||"},{"r":"2.10","s":"te pratiprasavaheyāḥ sūkṣmāḥ ||","d":"ते प्रतिप्रसवहेयाः सूक्ष्माः ||"},{"r":"2.11","s":"dhyānaheyās tadvṛttayaḥ ||","d":"ध्यानहेयास् तद्वृत्तयः ||"},{"r":"2.12","s":"kleśamūlaḥ karmāśayo dṛṣṭādṛṣṭajanmavedanīyaḥ ||","d":"क्लेशमूलः कर्माशयो दृष्टादृष्टजन्मवेदनीयः ||"},{"r":"2.13","s":"sati mūle tadvipāko jātyāyurbhogāḥ ||","d":"सति मूले तद्विपाको जात्यायुर्भोगाः ||"},{"r":"2.14","s":"te hlādaparitāpaphalāḥ puṇyāpuṇyahetutvāt ||","d":"ते ह्लादपरितापफलाः पुण्यापुण्यहेतुत्वात् ||"},{"r":"2.15","s":"pariṇāmatāpasaṃskāraduḥkhair guṇavṛttivirodhāc ca duḥkham eva sarvaṃ vivekinaḥ ||","d":"परिणामतापसंस्कारदुःखैर् गुणवृत्तिविरोधाच् च दुःखम् एव सर्वं विवेकिनः ||"},{"r":"2.16","s":"heyaṃ duḥkham anāgatam ||","d":"हेयं दुःखम् अनागतम् ||"},{"r":"2.17","s":"draṣṭṛdṛśyayoḥ saṃyogo heyahetuḥ ||","d":"द्रष्टृदृश्ययोः संयोगो हेयहेतुः ||"},{"r":"2.18","s":"prakāśakriyāsthitiśīlaṃ bhūtendriyātmakaṃ bhogāpavargārthaṃ dṛśyam ||","d":"प्रकाशक्रियास्थितिशीलं भूतेन्द्रियात्मकं भोगापवर्गार्थं दृश्यम् ||"},{"r":"2.19","s":"viśeṣāviśeṣaliṅgamātrāliṅgāni guṇaparvāṇi ||","d":"विशेषाविशेषलिङ्गमात्रालिङ्गानि गुणपर्वाणि ||"},{"r":"2.20","s":"draṣṭā dṛśimātraḥ śuddho 'pi pratyayānupaśyaḥ ||","d":"द्रष्टा दृशिमात्रः शुद्धो ऽपि प्रत्ययानुपश्यः ||"},{"r":"2.21","s":"tadartha eva dṛśyasyātmā ||","d":"तदर्थ एव दृश्यस्यात्मा ||"},{"r":"2.22","s":"kṛtārthaṃ prati naṣṭam apy anaṣṭaṃ tadanyasādhāraṇatvāt ||","d":"कृतार्थं प्रति नष्टम् अप्य् अनष्टं तदन्यसाधारणत्वात् ||"},{"r":"2.23","s":"svasvāmiśaktyoḥ svarūpopalabdhihetuḥ saṃyogaḥ ||","d":"स्वस्वामिशक्त्योः स्वरूपोपलब्धिहेतुः संयोगः ||"},{"r":"2.24","s":"tasya hetur avidyā ||","d":"तस्य हेतुर् अविद्या ||"},{"r":"2.25","s":"tadabhāvāt saṃyogābhāvo hānaṃ taddṛśeḥ kaivalyam ||","d":"तदभावात् संयोगाभावो हानं तद्दृशेः कैवल्यम् ||"},{"r":"2.26","s":"vivekakhyātir aviplavā hānopāyaḥ ||","d":"विवेकख्यातिर् अविप्लवा हानोपायः ||"},{"r":"2.27","s":"tasya saptadhā prāntabhūmiḥ prajñā ||","d":"तस्य सप्तधा प्रान्तभूमिः प्रज्ञा ||"},{"r":"2.28","s":"yogāṅgānuṣṭhānād aśuddhikṣaye jñānadīptir ā vivekakhyāteḥ ||","d":"योगाङ्गानुष्ठानाद् अशुद्धिक्षये ज्ञानदीप्तिर् आ विवेकख्यातेः ||"},{"r":"2.29","s":"yamaniyamāsanaprāṇāyāmapratyāhāradhāraṇādhyānasamādhayo 'ṣṭāv aṅgāni ||","d":"यमनियमासनप्राणायामप्रत्याहारधारणाध्यानसमाधयो ऽष्टाव् अङ्गानि ||"},{"r":"2.30","s":"ahiṃsāsatyāsteyabrahmacaryāparigrahā yamāḥ ||","d":"अहिंसासत्यास्तेयब्रह्मचर्यापरिग्रहा यमाः ||"},{"r":"2.31","s":"jātideśakālasamayānavacchinnāḥ sārvabhaumā mahāvratam ||","d":"जातिदेशकालसमयानवच्छिन्नाः सार्वभौमा महाव्रतम् ||"},{"r":"2.32","s":"śaucasaṃtoṣatapaḥsvādhyāyeśvarapraṇidhānāni niyamāḥ ||","d":"शौचसंतोषतपःस्वाध्यायेश्वरप्रणिधानानि नियमाः ||"},{"r":"2.33","s":"vitarkabādhane pratipakṣabhāvanam ||","d":"वितर्कबाधने प्रतिपक्षभावनम् ||"},{"r":"2.34","s":"vitarkā hiṃsādayaḥ kṛtakāritānumoditā lobhakrodhamohapūrvakā mṛdumadhyādhimātrā duḥkhājñānānantaphalā iti pratipakṣabhāvanam ||","d":"वितर्का हिंसादयः कृतकारितानुमोदिता लोभक्रोधमोहपूर्वका मृदुमध्याधिमात्रा दुःखाज्ञानानन्तफला इति प्रतिपक्षभावनम् ||"},{"r":"2.35","s":"ahiṃsāpratiṣṭhāyāṃ tatsaṃnidhau vairatyāgaḥ ||","d":"अहिंसाप्रतिष्ठायां तत्संनिधौ वैरत्यागः ||"},{"r":"2.36","s":"satyapratiṣṭhāyāṃ kriyāphalāśrayatvam ||","d":"सत्यप्रतिष्ठायां क्रियाफलाश्रयत्वम् ||"},{"r":"2.37","s":"asteyapratiṣṭhāyāṃ sarvaratnopasthānam ||","d":"अस्तेयप्रतिष्ठायां सर्वरत्नोपस्थानम् ||"},{"r":"2.38","s":"brahmacaryapratiṣṭhāyāṃ vīryalābhaḥ ||","d":"ब्रह्मचर्यप्रतिष्ठायां वीर्यलाभः ||"},{"r":"2.39","s":"aparigrahasthairye janmakathaṃtāsaṃbodhaḥ ||","d":"अपरिग्रहस्थैर्ये जन्मकथंतासंबोधः ||"},{"r":"2.40","s":"śaucāt svāṅgajugupsā parair asaṃsargaḥ ||","d":"शौचात् स्वाङ्गजुगुप्सा परैर् असंसर्गः ||"},{"r":"2.41","s":"sattvaśuddhisaumanasyaikāgryendriyajayātmadarśanayogyatvāni ca ||","d":"सत्त्वशुद्धिसौमनस्यैकाग्र्येन्द्रियजयात्मदर्शनयोग्यत्वानि च ||"},{"r":"2.42","s":"saṃtoṣād anuttamaḥ sukhalābhaḥ ||","d":"संतोषाद् अनुत्तमः सुखलाभः ||"},{"r":"2.43","s":"kāyendriyasiddhir aśuddhikṣayāt tapasaḥ ||","d":"कायेन्द्रियसिद्धिर् अशुद्धिक्षयात् तपसः ||"},{"r":"2.44","s":"svādhyāyād iṣṭadevatāsaṃprayogaḥ ||","d":"स्वाध्यायाद् इष्टदेवतासंप्रयोगः ||"},{"r":"2.45","s":"samādhisiddhir īśvarapraṇidhānāt ||","d":"समाधिसिद्धिर् ईश्वरप्रणिधानात् ||"},{"r":"2.46","s":"sthirasukham āsanam ||","d":"स्थिरसुखम् आसनम् ||"},{"r":"2.47","s":"prayatnaśaithilyānantasamāpattibhyām ||","d":"प्रयत्नशैथिल्यानन्तसमापत्तिभ्याम् ||"},{"r":"2.48","s":"tato dvandvānabhighātaḥ ||","d":"ततो द्वन्द्वानभिघातः ||"},{"r":"2.49","s":"tasmin sati śvāsapraśvāsayor gativicchedaḥ prāṇāyāmaḥ ||","d":"तस्मिन् सति श्वासप्रश्वासयोर् गतिविच्छेदः प्राणायामः ||"},{"r":"2.50","s":"bāhyābhyantarastambhavṛttir deśakālasaṃkhyābhiḥ paridṛṣṭo dīrghasūkṣmaḥ ||","d":"बाह्याभ्यन्तरस्तम्भवृत्तिर् देशकालसंख्याभिः परिदृष्टो दीर्घसूक्ष्मः ||"},{"r":"2.51","s":"bāhyābhyantaraviṣayākṣepī caturthaḥ ||","d":"बाह्याभ्यन्तरविषयाक्षेपी चतुर्थः ||"},{"r":"2.52","s":"tataḥ kṣīyate prakāśāvaraṇam ||","d":"ततः क्षीयते प्रकाशावरणम् ||"},{"r":"2.53","s":"dhāraṇāsu ca yogyatā manasaḥ ||","d":"धारणासु च योग्यता मनसः ||"},{"r":"2.54","s":"svaviṣayāsaṃprayoge cittasvarūpānukāra ivendriyāṇāṃ pratyāhāraḥ ||","d":"स्वविषयासंप्रयोगे चित्तस्वरूपानुकार इवेन्द्रियाणां प्रत्याहारः ||"},{"r":"2.55","s":"tataḥ paramā vaśyatendriyāṇām ||","d":"ततः परमा वश्यतेन्द्रियाणाम् ||"}],"3":[{"r":"3.1","s":"deśabandhaś cittasya dhāraṇā ||","d":"देशबन्धश् चित्तस्य धारणा ||","t":"tṛtīyaḥ pādaḥ"},{"r":"3.2","s":"tatra pratyayaikatānatā dhyānam ||","d":"तत्र प्रत्ययैकतानता ध्यानम् ||"},{"r":"3.3","s":"tad evārthamātranirbhāsaṃ svarūpaśūnyam iva samādhiḥ ||","d":"तद् एवार्थमात्रनिर्भासं स्वरूपशून्यम् इव समाधिः ||"},{"r":"3.4","s":"trayam ekatra saṃyamaḥ ||","d":"त्रयम् एकत्र संयमः ||"},{"r":"3.5","s":"tajjayāt prajñālokaḥ ||","d":"तज्जयात् प्रज्ञालोकः ||"},{"r":"3.6","s":"tasya bhūmiṣu viniyogaḥ ||","d":"तस्य भूमिषु विनियोगः ||"},{"r":"3.7","s":"trayam antaraṅgaṃ pūrvebhyaḥ ||","d":"त्रयम् अन्तरङ्गं पूर्वेभ्यः ||"},{"r":"3.8","s":"tad api bahiraṅgaṃ nirbījasya ||","d":"तद् अपि बहिरङ्गं निर्बीजस्य ||"},{"r":"3.9","s":"vyutthānanirodhasaṃskārayor abhibhavaprādurbhāvau nirodhakṣaṇacittānvayo nirodhapariṇāmaḥ ||","d":"व्युत्थाननिरोधसंस्कारयोर् अभिभवप्रादुर्भावौ निरोधक्षणचित्तान्वयो निरोधपरिणामः ||"},{"r":"3.10","s":"tasya praśāntavāhitā saṃskārāt ||","d":"तस्य प्रशान्तवाहिता संस्कारात् ||"},{"r":"3.11","s":"sarvārthataikāgratayoḥ kṣayodayau cittasya samādhipariṇāmaḥ ||","d":"सर्वार्थतैकाग्रतयोः क्षयोदयौ चित्तस्य समाधिपरिणामः ||"},{"r":"3.12","s":"tataḥ punaḥ śāntoditau tulyapratyayau cittasyaikāgratāpariṇāmaḥ ||","d":"ततः पुनः शान्तोदितौ तुल्यप्रत्ययौ चित्तस्यैकाग्रतापरिणामः ||"},{"r":"3.13","s":"etena bhūtendriyeṣu dharmalakṣaṇāvasthāpariṇāmā vyākhyātāḥ ||","d":"एतेन भूतेन्द्रियेषु धर्मलक्षणावस्थापरिणामा व्याख्याताः ||"},{"r":"3.14","s":"śāntoditāvyapadeśyadharmānupātī dharmī ||","d":"शान्तोदिताव्यपदेश्यधर्मानुपाती धर्मी ||"},{"r":"3.15","s":"kramānyatvaṃ pariṇāmānyatve hetuḥ ||","d":"क्रमान्यत्वं परिणामान्यत्वे हेतुः ||"},{"r":"3.16","s":"pariṇāmatrayasaṃyamād atītānāgatajñānam ||","d":"परिणामत्रयसंयमाद् अतीतानागतज्ञानम् ||"},{"r":"3.17","s":"śabdārthapratyayānām itaretarādhyāsāt saṃkaras tatpravibhāgasaṃyamāt sarvabhūtarutajñānam ||","d":"शब्दार्थप्रत्ययानाम् इतरेतराध्यासात् संकरस् तत्प्रविभागसंयमात् सर्वभूतरुतज्ञानम् ||"},{"r":"3.18","s":"saṃskārasākṣātkaraṇāt pūrvajātijñānam ||","d":"संस्कारसाक्षात्करणात् पूर्वजातिज्ञानम् ||"},{"r":"3.19","s":"pratyayasya paracittajñānam ||","d":"प्रत्ययस्य परचित्तज्ञानम् ||"},{"r":"3.20","s":"na ca tat sālambanaṃ tasyāviṣayībhūtatvāt ||","d":"न च तत् सालम्बनं तस्याविषयीभूतत्वात् ||"},{"r":"3.21","s":"kāyarūpasaṃyamāt tadgrāhyaśaktistambhe cakṣuḥprakāśāsaṃprayoge 'ntardhānam ||","d":"कायरूपसंयमात् तद्ग्राह्यशक्तिस्तम्भे चक्षुःप्रकाशासंप्रयोगे ऽन्तर्धानम् ||"},{"r":"3.22","s":"sopakramaṃ nirupakramaṃ ca karma tatsaṃyamād aparāntajñānam ariṣṭebhyo vā ||","d":"सोपक्रमं निरुपक्रमं च कर्म तत्संयमाद् अपरान्तज्ञानम् अरिष्टेभ्यो वा ||"},{"r":"3.23","s":"maitryādiṣu balāni ||","d":"मैत्र्यादिषु बलानि ||"},{"r":"3.24","s":"baleṣu hastibalādīni ||","d":"बलेषु हस्तिबलादीनि ||"},{"r":"3.25","s":"pravṛttyālokanyāsāt sūkṣmavyavahitaviprakṛṣṭajñānam ||","d":"प्रवृत्त्यालोकन्यासात् सूक्ष्मव्यवहितविप्रकृष्टज्ञानम् ||"},{"r":"3.26","s":"bhuvanajñānaṃ sūrye saṃyamāt ||","d":"भुवनज्ञानं सूर्ये संयमात् ||"},{"r":"3.27","s":"candre tārāvyūhajñānam ||","d":"चन्द्रे ताराव्यूहज्ञानम् ||"},{"r":"3.28","s":"dhruve tadgatijñānam ||","d":"ध्रुवे तद्गतिज्ञानम् ||"},{"r":"3.29","s":"nābhicakre kāyavyūhajñānam ||","d":"नाभिचक्रे कायव्यूहज्ञानम् ||"},{"r":"3.30","s":"kaṇṭhakūpe kṣutpipāsānivṛttiḥ ||","d":"कण्ठकूपे क्षुत्पिपासानिवृत्तिः ||"},{"r":"3.31","s":"kūrmanāḍyāṃ sthairyam ||","d":"कूर्मनाड्यां स्थैर्यम् ||"},{"r":"3.32","s":"mūrdhajyotiṣi siddhadarśanam ||","d":"मूर्धज्योतिषि सिद्धदर्शनम् ||"},{"r":"3.33","s":"prātibhād vā sarvam ||","d":"प्रातिभाद् वा सर्वम् ||"},{"r":"3.34","s":"hṛdaye cittasaṃvit ||","d":"हृदये चित्तसंवित् ||"},{"r":"3.35","s":"sattvapuruṣayor atyantāsaṃkīrṇayoḥ pratyayāviśeṣo bhogaḥ parārthāt svārthasaṃyamāt puruṣajñānam ||","d":"सत्त्वपुरुषयोर् अत्यन्तासंकीर्णयोः प्रत्ययाविशेषो भोगः परार्थात् स्वार्थसंयमात् पुरुषज्ञानम् ||"},{"r":"3.36","s":"tataḥ prātibhaśrāvaṇavedanādarśāsvādavārtā jāyante ||","d":"ततः प्रातिभश्रावणवेदनादर्शास्वादवार्ता जायन्ते ||"},{"r":"3.37","s":"te samādhāv upasargā vyutthāne siddhayaḥ ||","d":"ते समाधाव् उपसर्गा व्युत्थाने सिद्धयः ||"},{"r":"3.38","s":"bandhakāraṇaśaithilyāt pracārasaṃvedanāc ca cittasya paraśarīrāveśaḥ ||","d":"बन्धकारणशैथिल्यात् प्रचारसंवेदनाच् च चित्तस्य परशरीरावेशः ||"},{"r":"3.39","s":"udānajayāj jalapaṅkakaṇṭakādiṣv asaṅga utkrāntiś ca ||","d":"उदानजयाज् जलपङ्ककण्टकादिष्व् असङ्ग उत्क्रान्तिश् च ||"},{"r":"3.40","s":"samānajayāj jvalanam ||","d":"समानजयाज् ज्वलनम् ||"},{"r":"3.41","s":"śrotrākāśayoḥ saṃbandhasaṃyamād divyaṃ śrotram ||","d":"श्रोत्राकाशयोः संबन्धसंयमाद् दिव्यं श्रोत्रम् ||"},{"r":"3.42","s":"kāyākāśayoḥ saṃbandhasaṃyamāl laghutūlasamāpatteś cākāśagamanam ||","d":"कायाकाशयोः संबन्धसंयमाल् लघुतूलसमापत्तेश् चाकाशगमनम् ||"},{"r":"3.43","s":"bahir akalpitā vṛttir mahāvidehā tataḥ prakāśāvaraṇakṣayaḥ ||","d":"बहिर् अकल्पिता वृत्तिर् महाविदेहा ततः प्रकाशावरणक्षयः ||"},{"r":"3.44","s":"sthūlasvarūpasūkṣmānvayārthavattvasaṃyamād bhūtajayaḥ ||","d":"स्थूलस्वरूपसूक्ष्मान्वयार्थवत्त्वसंयमाद् भूतजयः ||"},{"r":"3.45","s":"tato 'ṇimādiprādurbhāvaḥ kāyasaṃpat taddharmānabhighātaś ca ||","d":"ततो ऽणिमादिप्रादुर्भावः कायसंपत् तद्धर्मानभिघातश् च ||"},{"r":"3.46","s":"rūpalāvaṇyabalavajrasaṃhananatvāni kāyasaṃpat ||","d":"रूपलावण्यबलवज्रसंहननत्वानि कायसंपत् ||"},{"r":"3.47","s":"grahaṇasvarūpāsmitānvayārthavattvasaṃyamād indriyajayaḥ ||","d":"ग्रहणस्वरूपास्मितान्वयार्थवत्त्वसंयमाद् इन्द्रियजयः ||"},{"r":"3.48","s":"tato manojavitvaṃ vikaraṇabhāvaḥ pradhānajayaś ca ||","d":"ततो मनोजवित्वं विकरणभावः प्रधानजयश् च ||"},{"r":"3.49","s":"sattvapuruṣānyatākhyātimātrasya sarvabhāvādhiṣṭhātṛtvaṃ sarvajñātṛtvaṃ ca ||","d":"सत्त्वपुरुषान्यताख्यातिमात्रस्य सर्वभावाधिष्ठातृत्वं सर्वज्ञातृत्वं च ||"},{"r":"3.50","s":"tadvairāgyād api doṣabījakṣaye kaivalyam ||","d":"तद्वैराग्याद् अपि दोषबीजक्षये कैवल्यम् ||"},{"r":"3.51","s":"sthānyupanimantraṇe saṅgasmayākaraṇaṃ punar aniṣṭaprasaṅgāt ||","d":"स्थान्युपनिमन्त्रणे सङ्गस्मयाकरणं पुनर् अनिष्टप्रसङ्गात् ||"},{"r":"3.52","s":"kṣaṇatatkramayoḥ saṃyamād vivekajaṃ jñānam ||","d":"क्षणतत्क्रमयोः संयमाद् विवेकजं ज्ञानम् ||"},{"r":"3.53","s":"jātilakṣaṇadeśair anyatānavacchedāt tulyayos tataḥ pratipattiḥ ||","d":"जातिलक्षणदेशैर् अन्यतानवच्छेदात् तुल्ययोस् ततः प्रतिपत्तिः ||"},{"r":"3.54","s":"tārakaṃ sarvaviṣayaṃ sarvathāviṣayam akramaṃ ceti vivekajaṃ jñānam ||","d":"तारकं सर्वविषयं सर्वथाविषयम् अक्रमं चेति विवेकजं ज्ञानम् ||"},{"r":"3.55","s":"sattvapuruṣayoḥ śuddhisāmye kaivalyam iti ||","d":"सत्त्वपुरुषयोः शुद्धिसाम्ये कैवल्यम् इति ||"}],"4":[{"r":"4.1","s":"janmauṣadhimantratapaḥsamādhijāḥ siddhayaḥ ||","d":"जन्मौषधिमन्त्रतपःसमाधिजाः सिद्धयः ||","t":"caturthaḥ pādaḥ"},{"r":"4.2","s":"jātyantarapariṇāmaḥ prakṛtyāpūrāt ||","d":"जात्यन्तरपरिणामः प्रकृत्यापूरात् ||"},{"r":"4.3","s":"nimittam aprayojakaṃ prakṛtīnāṃ varaṇabhedas tu tataḥ kṣetrikavat ||","d":"निमित्तम् अप्रयोजकं प्रकृतीनां वरणभेदस् तु ततः क्षेत्रिकवत् ||"},{"r":"4.4","s":"nirmāṇacittāny asmitāmātrāt ||","d":"निर्माणचित्तान्य् अस्मितामात्रात् ||"},{"r":"4.5","s":"pravṛttibhede prayojakaṃ cittam ekam anekeṣām ||","d":"प्रवृत्तिभेदे प्रयोजकं चित्तम् एकम् अनेकेषाम् ||"},{"r":"4.6","s":"tatra dhyānajam anāśayam ||","d":"तत्र ध्यानजम् अनाशयम् ||"},{"r":"4.7","s":"karmāśuklākṛṣṇaṃ yoginas trividham itareṣām ||","d":"कर्माशुक्लाकृष्णं योगिनस् त्रिविधम् इतरेषाम् ||"},{"r":"4.8","s":"tatas tadvipākānuguṇānām evābhivyaktir vāsanānām ||","d":"ततस् तद्विपाकानुगुणानाम् एवाभिव्यक्तिर् वासनानाम् ||"},{"r":"4.9","s":"jātideśakālavyavahitānām apy ānantaryaṃ smṛtisaṃskārayor ekarūpatvāt ||","d":"जातिदेशकालव्यवहितानाम् अप्य् आनन्तर्यं स्मृतिसंस्कारयोर् एकरूपत्वात् ||"},{"r":"4.10","s":"tāsām anāditvaṃ cāśiṣo nityatvāt ||","d":"तासाम् अनादित्वं चाशिषो नित्यत्वात् ||"},{"r":"4.11","s":"hetuphalāśrayālambanaiḥ saṃgṛhītatvād eṣām abhāve tadabhāvaḥ ||","d":"हेतुफलाश्रयालम्बनैः संगृहीतत्वाद् एषाम् अभावे तदभावः ||"},{"r":"4.12","s":"atītānāgataṃ svarūpato 'sty adhvabhedād dharmāṇām ||","d":"अतीतानागतं स्वरूपतो ऽस्त्य् अध्वभेदाद् धर्माणाम् ||"},{"r":"4.13","s":"te vyaktasūkṣmā guṇātmānaḥ ||","d":"ते व्यक्तसूक्ष्मा गुणात्मानः ||"},{"r":"4.14","s":"pariṇāmaikatvād vastutattvam ||","d":"परिणामैकत्वाद् वस्तुतत्त्वम् ||"},{"r":"4.15","s":"vastusāmye cittabhedāt tayor vibhaktaḥ panthāḥ ||","d":"वस्तुसाम्ये चित्तभेदात् तयोर् विभक्तः पन्थाः ||"},{"r":"4.16","s":"na caikacittatantraṃ vastu tadapramāṇakaṃ tadā kiṃ syāt ||","d":"न चैकचित्ततन्त्रं वस्तु तदप्रमाणकं तदा किं स्यात् ||"},{"r":"4.17","s":"taduparāgāpekṣitvāc cittasya vastu jñātājñātam ||","d":"तदुपरागापेक्षित्वाच् चित्तस्य वस्तु ज्ञाताज्ञातम् ||"},{"r":"4.18","s":"sadā jñātāś cittavṛttayas tatprabhoḥ puruṣasyāpariṇāmitvāt ||","d":"सदा ज्ञाताश् चित्तवृत्तयस् तत्प्रभोः पुरुषस्यापरिणामित्वात् ||"},{"r":"4.19","s":"na tat svābhāsaṃ dṛśyatvāt ||","d":"न तत् स्वाभासं दृश्यत्वात् ||"},{"r":"4.20","s":"ekasamaye cobhayānavadhāraṇam ||","d":"एकसमये चोभयानवधारणम् ||"},{"r":"4.21","s":"cittāntaradṛśye buddhibuddher atiprasaṅgaḥ smṛtisaṃkaraś ca ||","d":"चित्तान्तरदृश्ये बुद्धिबुद्धेर् अतिप्रसङ्गः स्मृतिसंकरश् च ||"},{"r":"4.22","s":"citer apratisaṃkramāyās tadākārāpattau svabuddhisaṃvedanam ||","d":"चितेर् अप्रतिसंक्रमायास् तदाकारापत्तौ स्वबुद्धिसंवेदनम् ||"},{"r":"4.23","s":"draṣṭṛdṛśyoparaktaṃ cittaṃ sarvārtham ||","d":"द्रष्टृदृश्योपरक्तं चित्तं सर्वार्थम् ||"},{"r":"4.24","s":"tad asaṃkhyeyavāsanābhiś citram api parārthaṃ saṃhatyakāritvāt ||","d":"तद् असंख्येयवासनाभिश् चित्रम् अपि परार्थं संहत्यकारित्वात् ||"},{"r":"4.25","s":"viśeṣadarśina ātmabhāvabhāvanānivṛttiḥ ||","d":"विशेषदर्शिन आत्मभावभावनानिवृत्तिः ||"},{"r":"4.26","s":"tadā vivekanimnaṃ kaivalyaprāgbhāraṃ cittam ||","d":"तदा विवेकनिम्नं कैवल्यप्राग्भारं चित्तम् ||"},{"r":"4.27","s":"tacchidreṣu pratyayāntarāṇi saṃskārebhyaḥ ||","d":"तच्छिद्रेषु प्रत्ययान्तराणि संस्कारेभ्यः ||"},{"r":"4.28","s":"hānam eṣāṃ kleśavad uktam ||","d":"हानम् एषां क्लेशवद् उक्तम् ||"},{"r":"4.29","s":"prasaṃkhyāne 'py akusīdasya sarvathā vivekakhyāter dharmameghaḥ samādhiḥ ||","d":"प्रसंख्याने ऽप्य् अकुसीदस्य सर्वथा विवेकख्यातेर् धर्ममेघः समाधिः ||"},{"r":"4.30","s":"tataḥ kleśakarmanivṛttiḥ ||","d":"ततः क्लेशकर्मनिवृत्तिः ||"},{"r":"4.31","s":"tadā sarvāvaraṇamalāpetasya jñānasyānantyāj jñeyam alpam ||","d":"तदा सर्वावरणमलापेतस्य ज्ञानस्यानन्त्याज् ज्ञेयम् अल्पम् ||"},{"r":"4.32","s":"tataḥ kṛtārthānāṃ pariṇāmakramasamāptir guṇānām ||","d":"ततः कृतार्थानां परिणामक्रमसमाप्तिर् गुणानाम् ||"},{"r":"4.33","s":"kṣaṇapratiyogī pariṇāmāparāntanirgrāhyaḥ kramaḥ ||","d":"क्षणप्रतियोगी परिणामापरान्तनिर्ग्राह्यः क्रमः ||"},{"r":"4.34","s":"puruṣārthaśūnyānāṃ guṇānāṃ pratiprasavaḥ kaivalyaṃ svarūpapratiṣṭhā vā citiśaktir iti ||","d":"पुरुषार्थशून्यानां गुणानां प्रतिप्रसवः कैवल्यं स्वरूपप्रतिष्ठा वा चितिशक्तिर् इति ||"}]}