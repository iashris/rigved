{"0":[{"r":"0.0.0","s":"vaiśeṣikasūtram","d":"वैशेषिकसूत्रम्"}],"1":[{"r":"1.1.1","s":"athāto dharmaṃ vyākhyāsyāmaḥ |","d":"अथातो धर्मं व्याख्यास्यामः |"},{"r":"1.1.2","s":"yato 'bhyudayaniḥśreyasasiddhiḥ sa dharmaḥ |","d":"यतो ऽभ्युदयनिःश्रेयससिद्धिः स धर्मः |"},{"r":"1.1.3","s":"tadvacanād āmnāyaprāmāṇyam (U,V,BhV āmnāyasya prāmāṇyam) |","d":"तद्वचनाद् आम्नायप्रामाण्यम् (उ,व्,भ्व् आम्नायस्य प्रामाण्यम्) |"},{"r":"1.1.4","s":"pṛthivy āpas tejo vāyur ākāśaṃ kālo dig ātmā mana iti dravyāṇi |","d":"पृथिव्य् आपस् तेजो वायुर् आकाशं कालो दिग् आत्मा मन इति द्रव्याणि |"},{"r":"1.1.5","s":"rūparasagandhasparśāḥ saṃkhyāḥ parimāṇāni pṛthaktvaṃ saṃyogavibhāgau paratvāparatve buddhayaḥ sukhaduḥkhe icchādveṣau prayatnaś ca guṇāḥ |","d":"रूपरसगन्धस्पर्शाः संख्याः परिमाणानि पृथक्त्वं संयोगविभागौ परत्वापरत्वे बुद्धयः सुखदुःखे इच्छाद्वेषौ प्रयत्नश् च गुणाः |"},{"r":"1.1.6","s":"utkṣepaṇam avakṣepaṇam ākuñcanaṃ prasāraṇaṃ gamanam iti karmāṇi |","d":"उत्क्षेपणम् अवक्षेपणम् आकुञ्चनं प्रसारणं गमनम् इति कर्माणि |"},{"r":"1.1.7","s":"sad anityaṃ dravyavat kāryaṃ kāraṇaṃ sāmānyaviśeṣavad iti dravyaguṇakarmaṇām aviśeṣaḥ |","d":"सद् अनित्यं द्रव्यवत् कार्यं कारणं सामान्यविशेषवद् इति द्रव्यगुणकर्मणाम् अविशेषः |"},{"r":"1.1.8","s":"dravyāṇi dravyāntaram ārabhante |","d":"द्रव्याणि द्रव्यान्तरम् आरभन्ते |"},{"r":"1.1.9","s":"guṇāś ca guṇāntaram |","d":"गुणाश् च गुणान्तरम् |"},{"r":"1.1.10","s":"karma karmasādhyaṃ na vidyate |","d":"कर्म कर्मसाध्यं न विद्यते |"},{"r":"1.1.11","s":"kāryāvirodhi dravyaṃ kāraṇāvirodhi ca |","d":"कार्याविरोधि द्रव्यं कारणाविरोधि च |"},{"r":"1.1.12","s":"ubhaytathā guṇaḥ |","d":"उभय्तथा गुणः |"},{"r":"1.1.13","s":"kāryavirodhi karma |","d":"कार्यविरोधि कर्म |"},{"r":"1.1.14","s":"kriyāvad guṇavat samavāyikāraṇam iti dravyalakṣaṇam |","d":"क्रियावद् गुणवत् समवायिकारणम् इति द्रव्यलक्षणम् |"},{"r":"1.1.15","s":"dravyāśrayy aguṇavān saṃyogavibhāgeṣv akāraṇam anapekṣa iti guṇalakṣaṇam |","d":"द्रव्याश्रय्य् अगुणवान् संयोगविभागेष्व् अकारणम् अनपेक्ष इति गुणलक्षणम् |"},{"r":"1.1.16","s":"ekadravyam aguṇaṃ saṃyogavibhāgeṣv anapekṣaṃ kāraṇam iti karmalakṣaṇam |","d":"एकद्रव्यम् अगुणं संयोगविभागेष्व् अनपेक्षं कारणम् इति कर्मलक्षणम् |"},{"r":"1.1.17","s":"dravyaguṇakarmaṇāṃ dravyaṃ kāraṇaṃ sāmānyam |","d":"द्रव्यगुणकर्मणां द्रव्यं कारणं सामान्यम् |"},{"r":"1.1.18","s":"tathā guṇaḥ |","d":"तथा गुणः |"},{"r":"1.1.19","s":"saṃyogavibhāgānāṃ karma |","d":"संयोगविभागानां कर्म |"},{"r":"1.1.20","s":"na dravyāṇāṃ vyatirekāt |","d":"न द्रव्याणां व्यतिरेकात् |"},{"r":"1.1.21","s":"guṇavaidharmyān na karmaṇāṃ |","d":"गुणवैधर्म्यान् न कर्मणां |"},{"r":"1.1.22","s":"dravyāṇāṃ dravyaṃ kāryaṃ sāmānyam |","d":"द्रव्याणां द्रव्यं कार्यं सामान्यम् |"},{"r":"1.1.23","s":"dvitvaprabhṛtayaś ca saṃkhyāḥ pṛthaktvaṃ saṃyogavibhāgāś ca |","d":"द्वित्वप्रभृतयश् च संख्याः पृथक्त्वं संयोगविभागाश् च |"},{"r":"1.1.24","s":"asamavāyāt sāmānyaṃ karma kāryaṃ na vidyate |","d":"असमवायात् सामान्यं कर्म कार्यं न विद्यते |"},{"r":"1.1.25","s":"saṃyogānāṃ dravyam |","d":"संयोगानां द्रव्यम् |"},{"r":"1.1.26","s":"rūpānāṃ rūpam |","d":"रूपानां रूपम् |"},{"r":"1.1.27","s":"gurutvaprayatnasaṃyogānām utkṣepaṇam |","d":"गुरुत्वप्रयत्नसंयोगानाम् उत्क्षेपणम् |"},{"r":"1.1.28","s":"saṃyogavibhāgāḥ karmaṇām |","d":"संयोगविभागाः कर्मणाम् |"},{"r":"1.1.29","s":"kāraṇasāmānye dravyakarmaṇāṃ karmākāraṇam uktam |","d":"कारणसामान्ये द्रव्यकर्मणां कर्माकारणम् उक्तम् |"},{"r":"1.2.1","s":"kāraṇābhāvāt kāryābhāvaḥ |","d":"कारणाभावात् कार्याभावः |"},{"r":"1.2.2","s":"na tu kāryābhavāt kāraṇābhāvaḥ |","d":"न तु कार्याभवात् कारणाभावः |"},{"r":"1.2.3","s":"sāmānyaṃ viśeṣa iti buddhyapekṣam |","d":"सामान्यं विशेष इति बुद्ध्यपेक्षम् |"},{"r":"1.2.4","s":"bhāvaḥ sāmānyam eva |","d":"भावः सामान्यम् एव |"},{"r":"1.2.5","s":"dravyatvaṃ guṇatvaṃ karmatvaṃ ca sāmānyāni viśeṣāś ca |","d":"द्रव्यत्वं गुणत्वं कर्मत्वं च सामान्यानि विशेषाश् च |"},{"r":"1.2.6","s":"anyatrāntyebhyo viśeṣebhyaḥ |","d":"अन्यत्रान्त्येभ्यो विशेषेभ्यः |"},{"r":"1.2.7","s":"sad iti yato dravyaguṇakarmasu |","d":"सद् इति यतो द्रव्यगुणकर्मसु |"},{"r":"1.2.8","s":"dravyaguṇakarmabhyo 'rthāntaraṃ sattā |","d":"द्रव्यगुणकर्मभ्यो ऽर्थान्तरं सत्ता |"},{"r":"1.2.9","s":"ekadravyavattvān na dravyam |","d":"एकद्रव्यवत्त्वान् न द्रव्यम् |"},{"r":"1.2.10","s":"guṇakarmasu ca bhāvān na karma na guṇaḥ |","d":"गुणकर्मसु च भावान् न कर्म न गुणः |"},{"r":"1.2.11","s":"sāmānyaviśeṣābhāvāc ca |","d":"सामान्यविशेषाभावाच् च |"},{"r":"1.2.12","s":"ekadravyavattvena dravyatvam uktam |","d":"एकद्रव्यवत्त्वेन द्रव्यत्वम् उक्तम् |"},{"r":"1.2.13","s":"sāmānyaviśeṣābhāvena ca |","d":"सामान्यविशेषाभावेन च |"},{"r":"1.2.14","s":"guṇe bhāvād guṇatvam uktam |","d":"गुणे भावाद् गुणत्वम् उक्तम् |"},{"r":"1.2.15","s":"sāmānyaviśeṣābhāvāc ca |","d":"सामान्यविशेषाभावाच् च |"},{"r":"1.2.16","s":"karmaṇi bhāvāt karmatvam uktam |","d":"कर्मणि भावात् कर्मत्वम् उक्तम् |"},{"r":"1.2.17","s":"sāmānyaviśeṣābhāvāc ca |","d":"सामान्यविशेषाभावाच् च |"},{"r":"1.2.18","s":"salliṅgāviśeṣād viśeṣaliṅgābhāvāc caiko bhāvaḥ |","d":"सल्लिङ्गाविशेषाद् विशेषलिङ्गाभावाच् चैको भावः |"}],"2":[{"r":"2.1.1","s":"rūparasagandhasparśavatī pṛthivī |","d":"रूपरसगन्धस्पर्शवती पृथिवी |"},{"r":"2.1.2","s":"rūparasasparśavatya āpo dravāḥ snigdhāś ca |","d":"रूपरसस्पर्शवत्य आपो द्रवाः स्निग्धाश् च |"},{"r":"2.1.3","s":"tejo rūpasparśavat |","d":"तेजो रूपस्पर्शवत् |"},{"r":"2.1.4","s":"vāyuḥ sparśavān |","d":"वायुः स्पर्शवान् |"},{"r":"2.1.5","s":"ta ākāśe na vidyante |","d":"त आकाशे न विद्यन्ते |"},{"r":"2.1.6","s":"sarpirjatumadhūcchiṣṭānāṃ pārthivānām agnisaṃyogād dravatādbhiḥ sāmānyam |","d":"सर्पिर्जतुमधूच्छिष्टानां पार्थिवानाम् अग्निसंयोगाद् द्रवताद्भिः सामान्यम् |"},{"r":"2.1.7","s":"trapusīsaloharajatasuvarṇānāṃ taijasānām agnisaṃyogād dravatādbhiḥ sāmānyam |","d":"त्रपुसीसलोहरजतसुवर्णानां तैजसानाम् अग्निसंयोगाद् द्रवताद्भिः सामान्यम् |"},{"r":"2.1.8","s":"viṣāṇī kakudmān prāntevāladhiḥ sāsnāvān iti gotve dṛṣṭaṃ liṅgam |","d":"विषाणी ककुद्मान् प्रान्तेवालधिः सास्नावान् इति गोत्वे दृष्टं लिङ्गम् |"},{"r":"2.1.9","s":"sparśaś ca |","d":"स्पर्शश् च |"},{"r":"2.1.10","s":"na ca dṛṣṭānāṃ sparśa ity adṛṣṭaliṅgo vāyuḥ |","d":"न च दृष्टानां स्पर्श इत्य् अदृष्टलिङ्गो वायुः |"},{"r":"2.1.11","s":"adravyavattvād dravyam (C,V,BhV U adravyavattvena) |","d":"अद्रव्यवत्त्वाद् द्रव्यम् (च्,व्,भ्व् उ अद्रव्यवत्त्वेन) |"},{"r":"2.1.12","s":"kriyāvattvād guṇavattvāc ca (V omits) |","d":"क्रियावत्त्वाद् गुणवत्त्वाच् च (व् ओमित्स्) |"},{"r":"2.1.13","s":"adravyavattvena nityatvam uktam (C,BhV) (V adravyatvenānityam, U adravyatvena) |","d":"अद्रव्यवत्त्वेन नित्यत्वम् उक्तम् (च्,भ्व्) (व् अद्रव्यत्वेनानित्यम्, उ अद्रव्यत्वेन) |"},{"r":"2.1.14","s":"vāyor vāyusaṃmūrcchanaṃ nānātve liṅgam |","d":"वायोर् वायुसंमूर्च्छनं नानात्वे लिङ्गम् |"},{"r":"2.1.15","s":"vāyor iti sati snnikarṣe pratyakṣābhāvād dṛṣṭaṃ liṅgaṃ na vidyate |","d":"वायोर् इति सति स्न्निकर्षे प्रत्यक्षाभावाद् दृष्टं लिङ्गं न विद्यते |"},{"r":"2.1.16","s":"sāmānyatodṛṣṭāc cāviśeṣaḥ |","d":"सामान्यतोदृष्टाच् चाविशेषः |"},{"r":"2.1.17","s":"tasmād āgamikam |","d":"तस्माद् आगमिकम् |"},{"r":"2.1.18","s":"saṃjñākarma tv asmadviśiṣtānāṃ liṅgam |","d":"संज्ञाकर्म त्व् अस्मद्विशिष्तानां लिङ्गम् |"},{"r":"2.1.19","s":"pratyakṣapūrvakatvāt saṃjñākarmaṇaḥ |","d":"प्रत्यक्षपूर्वकत्वात् संज्ञाकर्मणः |"},{"r":"2.1.20","s":"niṣkramaṇaṃ praveśanam ity ākāśasya liṅgam |","d":"निष्क्रमणं प्रवेशनम् इत्य् आकाशस्य लिङ्गम् |"},{"r":"2.1.21","s":"tad aliṅgam ekadravyavattvāt karmaṇaḥ |","d":"तद् अलिङ्गम् एकद्रव्यवत्त्वात् कर्मणः |"},{"r":"2.1.22","s":"kāraṇāntarānukṜptivaidharmyāc ca |","d":"कारणान्तरानुकॄप्तिवैधर्म्याच् च |"},{"r":"2.1.23","s":"saṃyogād abhāvaḥ karmaṇaḥ |","d":"संयोगाद् अभावः कर्मणः |"},{"r":"2.1.24","s":"kāraṇaguṇapūrvaḥ kārye guṇo dṛṣṭaḥ kāryāntarāprādurbhāvāc ca śabdaḥ sparśavatām aguṇaḥ |","d":"कारणगुणपूर्वः कार्ये गुणो दृष्टः कार्यान्तराप्रादुर्भावाच् च शब्दः स्पर्शवताम् अगुणः |"},{"r":"2.1.25","s":"paratra samavāyāt pratyakṣatvāc ca nātmaguṇo na manoguṇaḥ |","d":"परत्र समवायात् प्रत्यक्षत्वाच् च नात्मगुणो न मनोगुणः |"},{"r":"2.1.26","s":"liṅgam ākāśasya |","d":"लिङ्गम् आकाशस्य |"},{"r":"2.1.27","s":"dravyatvanityatve vāyunā vyākhyāte |\n28 tattvaṃ bhāvena |","d":"द्रव्यत्वनित्यत्वे वायुना व्याख्याते |\n28 तत्त्वं भावेन |"},{"r":"2.2.1","s":"puṣpavastrayoḥ sati sannikarṣe gandhāntarāprādurbhāvo vastre gandhābhāvaliṅgam |","d":"पुष्पवस्त्रयोः सति सन्निकर्षे गन्धान्तराप्रादुर्भावो वस्त्रे गन्धाभावलिङ्गम् |"},{"r":"2.2.2","s":"etenāpsūṣṇatā vyākhyātā |","d":"एतेनाप्सूष्णता व्याख्याता |"},{"r":"2.2.3","s":"vyavasthitaḥ pṛthivyāṃ gandhaḥ |","d":"व्यवस्थितः पृथिव्यां गन्धः |"},{"r":"2.2.4","s":"tejasy uṣṇatā |","d":"तेजस्य् उष्णता |"},{"r":"2.2.5","s":"apsu śītatā |","d":"अप्सु शीतता |"},{"r":"2.2.6","s":"aparasmin paraṃ yugapad ayugapac ciraṃ kṣipram iti kālaliṅgāni |","d":"अपरस्मिन् परं युगपद् अयुगपच् चिरं क्षिप्रम् इति काललिङ्गानि |"},{"r":"2.2.7","s":"dravyatvanityatve vāyunā vyākhyāte |","d":"द्रव्यत्वनित्यत्वे वायुना व्याख्याते |"},{"r":"2.2.8","s":"tattvaṃ bhāvena |","d":"तत्त्वं भावेन |"},{"r":"2.2.9","s":"kāryaviśeṣeṇa nānātvam |","d":"कार्यविशेषेण नानात्वम् |"},{"r":"2.2.10","s":"nityeṣv abhāvād anityeṣu bhāvāt |","d":"नित्येष्व् अभावाद् अनित्येषु भावात् |"},{"r":"2.2.11","s":"kāraṇe kālākhyā |","d":"कारणे कालाख्या |"},{"r":"2.2.12","s":"ita idam iti yatas tad diśo liṅgam |","d":"इत इदम् इति यतस् तद् दिशो लिङ्गम् |"},{"r":"2.2.13","s":"dravyatvanityatve vāyunā vyākhyāte |","d":"द्रव्यत्वनित्यत्वे वायुना व्याख्याते |"},{"r":"2.2.14","s":"tattvaṃ bhāvena |","d":"तत्त्वं भावेन |"},{"r":"2.2.15","s":"kāryaviśeṣeṇa nānātvam |","d":"कार्यविशेषेण नानात्वम् |"},{"r":"2.2.16","s":"ādityasaṃyogād bhūtapūrvād bhaviṣyato bhūtāc ca prācī |","d":"आदित्यसंयोगाद् भूतपूर्वाद् भविष्यतो भूताच् च प्राची |"},{"r":"2.2.17","s":"tathā dakṣiṇā pratīcy udīci ca |","d":"तथा दक्षिणा प्रतीच्य् उदीचि च |"},{"r":"2.2.18","s":"etena digantarāṇi vyākhyātāni |","d":"एतेन दिगन्तराणि व्याख्यातानि |"},{"r":"2.2.19","s":"sāmānyapratyakṣād viśeṣāpratyakṣād viśeṣasmṛteś ca saṃśayaḥ |","d":"सामान्यप्रत्यक्षाद् विशेषाप्रत्यक्षाद् विशेषस्मृतेश् च संशयः |"},{"r":"2.2.20","s":"dṛṣṭam adṛṣṭām |","d":"दृष्टम् अदृष्टाम् |"},{"r":"2.2.21","s":"dṛṣṭaṃ ca dṛṣṭāvat |","d":"दृष्टं च दृष्टावत् |"},{"r":"2.2.22","s":"dṛṣṭaṃ yathādṛṣṭām ayathādṛṣṭām ubhayathādṛṣṭatvāt |","d":"दृष्टं यथादृष्टाम् अयथादृष्टाम् उभयथादृष्टत्वात् |"},{"r":"2.2.23","s":"vidyāvidyātaś ca saṃśayaḥ |","d":"विद्याविद्यातश् च संशयः |"},{"r":"2.2.24","s":"śrotragrahaṇo yo 'rthaḥ sa śabdaḥ |","d":"श्रोत्रग्रहणो यो ऽर्थः स शब्दः |"},{"r":"2.2.25","s":"tasmin dravyaṃ karma guṇa iti saṃśayaḥ |","d":"तस्मिन् द्रव्यं कर्म गुण इति संशयः |"},{"r":"2.2.26","s":"tulyajātīyeṣv arthāntarabhūteṣu ca viśeṣasyobhayathā dṛṣṭatvāt |","d":"तुल्यजातीयेष्व् अर्थान्तरभूतेषु च विशेषस्योभयथा दृष्टत्वात् |"},{"r":"2.2.27","s":"ekadravyavattvān na dravyam |","d":"एकद्रव्यवत्त्वान् न द्रव्यम् |"},{"r":"2.2.28","s":"acākṣuṣatvān na karma |","d":"अचाक्षुषत्वान् न कर्म |"},{"r":"2.2.29","s":"guṇasya sato 'pavargaḥ karmabhiḥ sādharmyam |","d":"गुणस्य सतो ऽपवर्गः कर्मभिः साधर्म्यम् |"},{"r":"2.2.30","s":"sato liṅgābhāvāt |","d":"सतो लिङ्गाभावात् |"},{"r":"2.2.31","s":"nityavaidharmyāt |","d":"नित्यवैधर्म्यात् |"},{"r":"2.2.32","s":"kāryatvāt |","d":"कार्यत्वात् |"},{"r":"2.2.33","s":"abhāvāt |","d":"अभावात् |"},{"r":"2.2.34","s":"kāraṇo vikārāt |","d":"कारणो विकारात् |"},{"r":"2.2.35","s":"doṣāt |","d":"दोषात् |"},{"r":"2.2.36","s":"saṃyogād vibhāgāc chabdāc ca śabdaniṣpatteḥ |","d":"संयोगाद् विभागाच् छब्दाच् च शब्दनिष्पत्तेः |"},{"r":"2.2.37","s":"liṅgāc cānityaḥ |","d":"लिङ्गाच् चानित्यः |"},{"r":"2.2.38","s":"dvayos tu pravṛttyor abhāvāt |","d":"द्वयोस् तु प्रवृत्त्योर् अभावात् |"},{"r":"2.2.39","s":"saṃkhyābhāvāt |","d":"संख्याभावात् |"},{"r":"2.2.40","s":"prathamāśabdāt |","d":"प्रथमाशब्दात् |"},{"r":"2.2.41","s":"sampratipattibhāvāc ca |","d":"सम्प्रतिपत्तिभावाच् च |"},{"r":"2.2.42","s":"sandigdhāḥ satibahutve |","d":"सन्दिग्धाः सतिबहुत्वे |"},{"r":"2.2.43","s":"saṃkhyābhāvaḥ sāmānyataḥ |","d":"संख्याभावः सामान्यतः |"}],"3":[{"r":"3.1.1","s":"prasiddhā indriyārthāḥ |","d":"प्रसिद्धा इन्द्रियार्थाः |"},{"r":"3.1.2","s":"indriyārthaprasiddhir indriyārthebhyo 'rthāntaratve hetuḥ |","d":"इन्द्रियार्थप्रसिद्धिर् इन्द्रियार्थेभ्यो ऽर्थान्तरत्वे हेतुः |"},{"r":"3.1.3","s":"so 'napadeśaḥ |","d":"सो ऽनपदेशः |"},{"r":"3.1.4","s":"kāraṇājñānāt |","d":"कारणाज्ञानात् |"},{"r":"3.1.5","s":"kāryājñānāt |","d":"कार्याज्ञानात् |"},{"r":"3.1.6","s":"ajñānāc ca |","d":"अज्ञानाच् च |"},{"r":"3.1.7","s":"anya eva hetur ity anapadeśaḥ |","d":"अन्य एव हेतुर् इत्य् अनपदेशः |"},{"r":"3.1.8","s":"saṃyogi samavāyy ekārthasamavāyi virodhi ca, kāryaṃ kāryāntarasya, kāraṇaṃ kāraṇāntarasya, virodhy abhūtaṃ bhūtasya, bhūtam abhūtasya, abhūtam abhūtasya, bhūtaṃ bhūtasya |","d":"संयोगि समवाय्य् एकार्थसमवायि विरोधि च, कार्यं कार्यान्तरस्य, कारणं कारणान्तरस्य, विरोध्य् अभूतं भूतस्य, भूतम् अभूतस्य, अभूतम् अभूतस्य, भूतं भूतस्य |"},{"r":"3.1.9","s":"prasiddhapūrvakatvād apadeśasya |","d":"प्रसिद्धपूर्वकत्वाद् अपदेशस्य |"},{"r":"3.1.10","s":"aprasiddho 'napadeśaḥ |","d":"अप्रसिद्धो ऽनपदेशः |"},{"r":"3.1.11","s":"asan sandigdhaś cānapadeśaḥ |","d":"असन् सन्दिग्धश् चानपदेशः |"},{"r":"3.1.12","s":"viṣāṇī tasmād aśvo viṣāṇī tasmād gaur iti ca |","d":"विषाणी तस्माद् अश्वो विषाणी तस्माद् गौर् इति च |"},{"r":"3.1.13","s":"ātmendriyamano'rthasannikarṣād yan niṣpadyate tad anyat |","d":"आत्मेन्द्रियमनोऽर्थसन्निकर्षाद् यन् निष्पद्यते तद् अन्यत् |"},{"r":"3.1.14","s":"pravṛttinivṛttī ca pratyagātmani dṛṣṭe paratra liṅgam |","d":"प्रवृत्तिनिवृत्ती च प्रत्यगात्मनि दृष्टे परत्र लिङ्गम् |"},{"r":"3.2.1","s":"ātmendriyārthasannikarṣe jñānasyābhāvo bhāvaś ca manaso liṅgam |","d":"आत्मेन्द्रियार्थसन्निकर्षे ज्ञानस्याभावो भावश् च मनसो लिङ्गम् |"},{"r":"3.2.2","s":"dravyatvanityatve vāyunā vyākhyāte |","d":"द्रव्यत्वनित्यत्वे वायुना व्याख्याते |"},{"r":"3.2.3","s":"prayatnāyaugapadyāj jñānāyaugapadyāc caikaṃ manaḥ |","d":"प्रयत्नायौगपद्याज् ज्ञानायौगपद्याच् चैकं मनः |"},{"r":"3.2.4","s":"prāṇāpānanimeṣonmeṣajīvanamanogatīndriyāntaravikārāḥ sukhaduḥkhe icchādveṣau prayatnaś cety ātmaliṅgāni |","d":"प्राणापाननिमेषोन्मेषजीवनमनोगतीन्द्रियान्तरविकाराः सुखदुःखे इच्छाद्वेषौ प्रयत्नश् चेत्य् आत्मलिङ्गानि |"},{"r":"3.2.5","s":"dravyatvanityatve vāyunā vyākhyāte |","d":"द्रव्यत्वनित्यत्वे वायुना व्याख्याते |"},{"r":"3.2.6","s":"yajñadatta iti sati sannikarṣe pratyakṣābhāvād dṛṣṭaṃ liṅgaṃ na vidyate |","d":"यज्ञदत्त इति सति सन्निकर्षे प्रत्यक्षाभावाद् दृष्टं लिङ्गं न विद्यते |"},{"r":"3.2.7","s":"sāmānyatodṛṣṭāc cāviśeṣaḥ |","d":"सामान्यतोदृष्टाच् चाविशेषः |"},{"r":"3.2.8","s":"tasmād āgamikam |","d":"तस्माद् आगमिकम् |"},{"r":"3.2.9","s":"aham iti śabdavyatirekān nāgamikam |","d":"अहम् इति शब्दव्यतिरेकान् नागमिकम् |"},{"r":"3.2.10","s":"yadi ca dṛṣṭapratyakṣo 'haṃ devadatto 'haṃ yajñadatta iti |","d":"यदि च दृष्टप्रत्यक्षो ऽहं देवदत्तो ऽहं यज्ञदत्त इति |"},{"r":"3.2.11","s":"devadatto gacchati viṣṇumitro gacchatīti copacārāc charīrapratyakṣaḥ |","d":"देवदत्तो गच्छति विष्णुमित्रो गच्छतीति चोपचाराच् छरीरप्रत्यक्षः |"},{"r":"3.2.12","s":"sandigdhas tūpacāraḥ |","d":"सन्दिग्धस् तूपचारः |"},{"r":"3.2.13","s":"aham iti pratyagātmani bhāvāt paratrābhāvād arthāntarapratyakṣaḥ |","d":"अहम् इति प्रत्यगात्मनि भावात् परत्राभावाद् अर्थान्तरप्रत्यक्षः |"},{"r":"3.2.14","s":"na tu śarīraviśeṣād yajñadattaviṣṇumitrayor jñānaviśeṣaḥ |","d":"न तु शरीरविशेषाद् यज्ञदत्तविष्णुमित्रयोर् ज्ञानविशेषः |"},{"r":"3.2.15","s":"sukhaduḥkhajñānaniṣpattyaviśeṣād aikātmyam |","d":"सुखदुःखज्ञाननिष्पत्त्यविशेषाद् ऐकात्म्यम् |"},{"r":"3.2.16","s":"nānā vyavasthātaḥ |","d":"नाना व्यवस्थातः |"},{"r":"3.2.17","s":"śāstrasāmarthyāc ca |","d":"शास्त्रसामर्थ्याच् च |"}],"4":[{"r":"4.1.1","s":"sad akāraṇavat tan nityam |","d":"सद् अकारणवत् तन् नित्यम् |"},{"r":"4.1.2","s":"tasya kāryaṃ liṅgam |","d":"तस्य कार्यं लिङ्गम् |"},{"r":"4.1.3","s":"kāraṇabhāvād dhi kāryabhāvaḥ |","d":"कारणभावाद् धि कार्यभावः |"},{"r":"4.1.4","s":"anityam iti ca viśeṣapratiṣedhabhāvaḥ |","d":"अनित्यम् इति च विशेषप्रतिषेधभावः |"},{"r":"4.1.5","s":"avidyā ca |","d":"अविद्या च |"},{"r":"4.1.6","s":"mahaty anekadravyavattvād rūpāc copalabdhiḥ |","d":"महत्य् अनेकद्रव्यवत्त्वाद् रूपाच् चोपलब्धिः |"},{"r":"4.1.7","s":"adravyavattvāt paramāṇāv anupalabdhiḥ |","d":"अद्रव्यवत्त्वात् परमाणाव् अनुपलब्धिः |"},{"r":"4.1.8","s":"rūpasaṃskārābhāvād vāyāv anupalabdhiḥ |","d":"रूपसंस्काराभावाद् वायाव् अनुपलब्धिः |"},{"r":"4.1.9","s":"anekadravyeṇa dravyeṇa samavāyād rūpaviśeṣāc copalabdhiḥ |","d":"अनेकद्रव्येण द्रव्येण समवायाद् रूपविशेषाच् चोपलब्धिः |"},{"r":"4.1.10","s":"etena rasagandhasparśeṣu jñānaṃ vyākhyātam |","d":"एतेन रसगन्धस्पर्शेषु ज्ञानं व्याख्यातम् |"},{"r":"4.1.11","s":"tadabhāvād avyabhicāraḥ |","d":"तदभावाद् अव्यभिचारः |"},{"r":"4.1.12","s":"saṃkhyāḥ parimāṇāni pṛthaktvaṃ saṃyogavibhāgau paratvāparatve karma ca rūpidravyasamavāyāc cākṣuṣāṇi |","d":"संख्याः परिमाणानि पृथक्त्वं संयोगविभागौ परत्वापरत्वे कर्म च रूपिद्रव्यसमवायाच् चाक्षुषाणि |"},{"r":"4.1.13","s":"arūpiṣv acākṣuṣatvāt |","d":"अरूपिष्व् अचाक्षुषत्वात् |"},{"r":"4.1.14","s":"etena guṇatve bhāve ca sarvendriyajñānaṃ vyākhyātam |","d":"एतेन गुणत्वे भावे च सर्वेन्द्रियज्ञानं व्याख्यातम् |"},{"r":"4.2.1","s":"pratyakṣāpratyakṣāṇām apratyakṣatvāt saṃyogasya pañcātmakaṃ na vidyate |","d":"प्रत्यक्षाप्रत्यक्षाणाम् अप्रत्यक्षत्वात् संयोगस्य पञ्चात्मकं न विद्यते |"},{"r":"4.2.2","s":"guṇāntarāprādurbhāvāc ca tryātmakam api na |","d":"गुणान्तराप्रादुर्भावाच् च त्र्यात्मकम् अपि न |"},{"r":"4.2.3","s":"ātmasaṃyogas tv avipratiṣiddho mithaḥ pañcānām |","d":"आत्मसंयोगस् त्व् अविप्रतिषिद्धो मिथः पञ्चानाम् |"},{"r":"4.2.4","s":"anekadeśapūrvakatvāt |","d":"अनेकदेशपूर्वकत्वात् |"},{"r":"4.2.5","s":"dharmaviśeṣāt |","d":"धर्मविशेषात् |"},{"r":"4.2.6","s":"kāryaviśeṣāt |","d":"कार्यविशेषात् |"},{"r":"4.2.7","s":"samākhyābhāvāt |","d":"समाख्याभावात् |"},{"r":"4.2.8","s":"saṃjñādimattvāt |","d":"संज्ञादिमत्त्वात् |"},{"r":"4.2.9","s":"santy ayonijā vedaliṅgāc ca |","d":"सन्त्य् अयोनिजा वेदलिङ्गाच् च |"}],"5":[{"r":"5.1.1","s":"ātmasaṃyogaprayatnābhyāṃ haste karma |","d":"आत्मसंयोगप्रयत्नाभ्यां हस्ते कर्म |"},{"r":"5.1.2","s":"tathā musalakarma hastasaṃyogāc ca |","d":"तथा मुसलकर्म हस्तसंयोगाच् च |"},{"r":"5.1.3","s":"abhighātaje musalakarmaṇi vyatirekād akāraṇaṃ hastasaṃyogaḥ |","d":"अभिघातजे मुसलकर्मणि व्यतिरेकाद् अकारणं हस्तसंयोगः |"},{"r":"5.1.4","s":"tathātmasaṃyogo hastamusalakarmaṇi |","d":"तथात्मसंयोगो हस्तमुसलकर्मणि |"},{"r":"5.1.5","s":"musalābhighātāt tu musalasaṃyogād dhaste karma |","d":"मुसलाभिघातात् तु मुसलसंयोगाद् धस्ते कर्म |"},{"r":"5.1.6","s":"tathātmakarma hastasaṃyogāc ca |","d":"तथात्मकर्म हस्तसंयोगाच् च |"},{"r":"5.1.7","s":"saṃyogābhāve gurutvāt patanam |","d":"संयोगाभावे गुरुत्वात् पतनम् |"},{"r":"5.1.8","s":"nodanaviśeṣābhāvād nordhvaṃ na tiryag gamanam |","d":"नोदनविशेषाभावाद् नोर्ध्वं न तिर्यग् गमनम् |"},{"r":"5.1.9","s":"prayatnaviśeṣān nodanaviśeṣaḥ |","d":"प्रयत्नविशेषान् नोदनविशेषः |"},{"r":"5.1.10","s":"nodanaviśeṣād udasanaviśeṣaḥ |","d":"नोदनविशेषाद् उदसनविशेषः |"},{"r":"5.1.11","s":"hastakarmaṇā dārakakarma vyākhyātam |","d":"हस्तकर्मणा दारककर्म व्याख्यातम् |"},{"r":"5.1.12","s":"tathā dagdhasya visphoṭanam |","d":"तथा दग्धस्य विस्फोटनम् |"},{"r":"5.1.13","s":"prayatnābhāve gurutvāt suptasya patanam |","d":"प्रयत्नाभावे गुरुत्वात् सुप्तस्य पतनम् |"},{"r":"5.1.14","s":"tṛṇakarma vāyusaṃyogāt |","d":"तृणकर्म वायुसंयोगात् |"},{"r":"5.1.15","s":"maṇigamanaṃ sūcyabhisarpaṇam ity adṛṣṭakāritāni |","d":"मणिगमनं सूच्यभिसर्पणम् इत्य् अदृष्टकारितानि |"},{"r":"5.1.16","s":"iṣāv ayugapat saṃyogaviśeṣāḥ karmānyatve hetuḥ |","d":"इषाव् अयुगपत् संयोगविशेषाः कर्मान्यत्वे हेतुः |"},{"r":"5.1.17","s":"nodanād ādyam iṣoḥ karma karmakāritāc ca saṃskārād uttaraṃ tathottaram uttaraṃ ca |","d":"नोदनाद् आद्यम् इषोः कर्म कर्मकारिताच् च संस्काराद् उत्तरं तथोत्तरम् उत्तरं च |"},{"r":"5.1.18","s":"saṃskārābhāve gurutvāt patanam |","d":"संस्काराभावे गुरुत्वात् पतनम् |"},{"r":"5.2.1","s":"nodanād abhighātāt saṃyuktasaṃyogāc ca pṛthivyāṃ karma |","d":"नोदनाद् अभिघातात् संयुक्तसंयोगाच् च पृथिव्यां कर्म |"},{"r":"5.2.2","s":"tad viśeṣeṇādṛṣṭakāritam |","d":"तद् विशेषेणादृष्टकारितम् |"},{"r":"5.2.3","s":"apāṃ saṃyogābhāve gurutvāt patanam |","d":"अपां संयोगाभावे गुरुत्वात् पतनम् |"},{"r":"5.2.4","s":"tad viśeṣeṇādṛṣṭakāritam |","d":"तद् विशेषेणादृष्टकारितम् |"},{"r":"5.2.5","s":"dravatvāt syandanam |","d":"द्रवत्वात् स्यन्दनम् |"},{"r":"5.2.6","s":"nāḍyā vāyusaṃyogād ārohaṇam |","d":"नाड्या वायुसंयोगाद् आरोहणम् |"},{"r":"5.2.7","s":"nodanāt pīḍanāt saṃyuktasaṃyogāc ca |","d":"नोदनात् पीडनात् संयुक्तसंयोगाच् च |"},{"r":"5.2.8","s":"vṛkṣābhisarpaṇam ity adṛṣṭakāritam |","d":"वृक्षाभिसर्पणम् इत्य् अदृष्टकारितम् |"},{"r":"5.2.9","s":"apāṃ saṅghāto vilayanaṃ ca tejasaḥ saṃyogāt |","d":"अपां सङ्घातो विलयनं च तेजसः संयोगात् |"},{"r":"5.2.10","s":"tatrāvasphūrjathur liṅgam |","d":"तत्रावस्फूर्जथुर् लिङ्गम् |"},{"r":"5.2.11","s":"vaidikaṃ ca |","d":"वैदिकं च |"},{"r":"5.2.12","s":"apāṃ saṃyogād vibhāgāc ca stanayitnuḥ |","d":"अपां संयोगाद् विभागाच् च स्तनयित्नुः |"},{"r":"5.2.13","s":"pṛthivīkarmaṇā tejaḥkarma vāyukarma ca vyākhyātam |","d":"पृथिवीकर्मणा तेजःकर्म वायुकर्म च व्याख्यातम् |"},{"r":"5.2.14","s":"agner ūrdhvajvalanaṃ vāyoś ca tiryagpavanam aṇumanasoś cādyaṃ karmety adṛṣṭakāritāni |","d":"अग्नेर् ऊर्ध्वज्वलनं वायोश् च तिर्यग्पवनम् अणुमनसोश् चाद्यं कर्मेत्य् अदृष्टकारितानि |"},{"r":"5.2.15","s":"hastakarmaṇā manasaḥ karma vyākhyātam |","d":"हस्तकर्मणा मनसः कर्म व्याख्यातम् |"},{"r":"5.2.16","s":"ātmendriyamano'rthasannikarṣāt sukhaduḥkhe tadanārambhaḥ |","d":"आत्मेन्द्रियमनोऽर्थसन्निकर्षात् सुखदुःखे तदनारम्भः |"},{"r":"5.2.17","s":"ātmasthe manasi saśarīrasya sukhaduḥkhābhāvaḥ sa yogaḥ |","d":"आत्मस्थे मनसि सशरीरस्य सुखदुःखाभावः स योगः |"},{"r":"5.2.18","s":"kāyakarmaṇātmakarma vyākhyātam |","d":"कायकर्मणात्मकर्म व्याख्यातम् |"},{"r":"5.2.19","s":"apasarpaṇam upasarpaṇam aśitapītasaṃyogaḥ kāryāntarasaṃyogāś cety adṛṣṭakāritāni |","d":"अपसर्पणम् उपसर्पणम् अशितपीतसंयोगः कार्यान्तरसंयोगाश् चेत्य् अदृष्टकारितानि |"},{"r":"5.2.20","s":"tadabhāve saṃyogābhāvo 'prādurbhāvaḥ sa mokṣaḥ |","d":"तदभावे संयोगाभावो ऽप्रादुर्भावः स मोक्षः |"},{"r":"5.2.21","s":"dravyaguṇakarmavaidharmyād bhāvābhāvamātraṃ tamaḥ |","d":"द्रव्यगुणकर्मवैधर्म्याद् भावाभावमात्रं तमः |"},{"r":"5.2.22","s":"tejaso dravyāntareṇāvaraṇāc ca |","d":"तेजसो द्रव्यान्तरेणावरणाच् च |"},{"r":"5.2.23","s":"dikkālāv ākāśaṃ ca kriyāvadbhyo vaidharmyān niṣkriyāṇi |","d":"दिक्कालाव् आकाशं च क्रियावद्भ्यो वैधर्म्यान् निष्क्रियाणि |"},{"r":"5.2.24","s":"etena karmāṇi guṇāś ca vyākhyātāḥ |","d":"एतेन कर्माणि गुणाश् च व्याख्याताः |"},{"r":"5.2.25","s":"niṣkriyāṇāṃ samavāyaḥ karmabhyaḥ pratiṣiddhaḥ |","d":"निष्क्रियाणां समवायः कर्मभ्यः प्रतिषिद्धः |"},{"r":"5.2.26","s":"kāraṇaṃ tv asamavāyino guṇāḥ |","d":"कारणं त्व् असमवायिनो गुणाः |"},{"r":"5.2.27","s":"guṇair dig vyākhyātā |","d":"गुणैर् दिग् व्याख्याता |"},{"r":"5.2.28","s":"kāraṇena kālaḥ |","d":"कारणेन कालः |"}],"6":[{"r":"6.1.1","s":"buddhipūrvā vākyakṛtir vede |","d":"बुद्धिपूर्वा वाक्यकृतिर् वेदे |"},{"r":"6.1.2","s":"na cāsmadbuddhibhyo liṅgam ṛṣeḥ |","d":"न चास्मद्बुद्धिभ्यो लिङ्गम् ऋषेः |"},{"r":"6.1.3","s":"tathā brāhmaṇe saṃjñākarmasiddhir liṅgam |","d":"तथा ब्राह्मणे संज्ञाकर्मसिद्धिर् लिङ्गम् |"},{"r":"6.1.4","s":"buddhipūrvo dadātiḥ |","d":"बुद्धिपूर्वो ददातिः |"},{"r":"6.1.5","s":"tathā pratigrahaḥ |","d":"तथा प्रतिग्रहः |"},{"r":"6.1.6","s":"tayoḥ kramo yathānitaretarāṅgabhūtānām |","d":"तयोः क्रमो यथानितरेतराङ्गभूतानाम् |"},{"r":"6.1.7","s":"ātmaguṇeṣv ātmāntaraguṇānām akāraṇatvāt |","d":"आत्मगुणेष्व् आत्मान्तरगुणानाम् अकारणत्वात् |"},{"r":"6.1.8","s":"aduṣṭabhojanāt samabhivyāhārato 'bhyudayaḥ |","d":"अदुष्टभोजनात् समभिव्याहारतो ऽभ्युदयः |"},{"r":"6.1.9","s":"tad duṣṭabhojane na vidyate |","d":"तद् दुष्टभोजने न विद्यते |"},{"r":"6.1.10","s":"duṣṭaṃ hiṃsāyām |","d":"दुष्टं हिंसायाम् |"},{"r":"6.1.11","s":"samabhivyāhārato doṣaḥ |","d":"समभिव्याहारतो दोषः |"},{"r":"6.1.12","s":"tad aduṣṭe na vidyate |","d":"तद् अदुष्टे न विद्यते |"},{"r":"6.1.13","s":"viśiṣṭe pravṛttiḥ |","d":"विशिष्टे प्रवृत्तिः |"},{"r":"6.1.14","s":"same hīne cāpravṛttiḥ |","d":"समे हीने चाप्रवृत्तिः |"},{"r":"6.1.15","s":"etena hīnasamaviśiṣtadhārmikebhyaḥ parādānaṃ vyākhyātam |","d"