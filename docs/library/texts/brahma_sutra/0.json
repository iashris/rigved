:"sahakāritvena ca |","d":"सहकारित्वेन च |"},{"r":"3.4.34","s":"sarvathāpi ta evobhayaliṅgāt |","d":"सर्वथापि त एवोभयलिङ्गात् |"},{"r":"3.4.35","s":"anabhibhavaṃ ca darśayati |","d":"अनभिभवं च दर्शयति |"},{"r":"3.4.36","s":"antarā cāpi tu taddṛṣṭeḥ |","d":"अन्तरा चापि तु तद्दृष्टेः |"},{"r":"3.4.37","s":"api smaryate |","d":"अपि स्मर्यते |"},{"r":"3.4.38","s":"viśeṣānugrahaś ca |","d":"विशेषानुग्रहश् च |"},{"r":"3.4.39","s":"atas tv itarajjyāyo liṅgāc ca |","d":"अतस् त्व् इतरज्ज्यायो लिङ्गाच् च |"},{"r":"3.4.40","s":"tadbhūtasya tu nātadbhāvo jaiminer api niyamāt tadrūpābhāvebhyaḥ |","d":"तद्भूतस्य तु नातद्भावो जैमिनेर् अपि नियमात् तद्रूपाभावेभ्यः |"},{"r":"3.4.41","s":"na cādhikārikam api patanānumānāt tadayogāt |","d":"न चाधिकारिकम् अपि पतनानुमानात् तदयोगात् |"},{"r":"3.4.42","s":"upapūrvam apīty eke bhāvamaśanavat tad uktam |","d":"उपपूर्वम् अपीत्य् एके भावमशनवत् तद् उक्तम् |"},{"r":"3.4.43","s":"bahis tūbhayathāpi smṛter ācārāc ca |","d":"बहिस् तूभयथापि स्मृतेर् आचाराच् च |"},{"r":"3.4.44","s":"svāminaḥ phalaśruter ity ātreyaḥ |","d":"स्वामिनः फलश्रुतेर् इत्य् आत्रेयः |"},{"r":"3.4.45","s":"ārtvijyam ity auḍulomiḥ tasmai hi parikrīyate |","d":"आर्त्विज्यम् इत्य् औडुलोमिः तस्मै हि परिक्रीयते |"},{"r":"3.4.46","s":"sahakāryantaravidhiḥ pakṣeṇa tṛtīyaṃ tadvato vidhyādivat |","d":"सहकार्यन्तरविधिः पक्षेण तृतीयं तद्वतो विध्यादिवत् |"},{"r":"3.4.47","s":"kṛtsnabhāvāt tu gṛhiṇopasaṃhāraḥ |","d":"कृत्स्नभावात् तु गृहिणोपसंहारः |"},{"r":"3.4.48","s":"maunavad itareṣām apy upadeśāt |","d":"मौनवद् इतरेषाम् अप्य् उपदेशात् |"},{"r":"3.4.49","s":"anāviṣkurvann anvayāt |","d":"अनाविष्कुर्वन्न् अन्वयात् |"},{"r":"3.4.50","s":"aihikam aprastutapratibandhe taddarśanāt |","d":"ऐहिकम् अप्रस्तुतप्रतिबन्धे तद्दर्शनात् |"},{"r":"3.4.51","s":"evaṃ muktiphalāniyamas tadavasthāvadhṛtes tadavasthāvadhṛteḥ |","d":"एवं मुक्तिफलानियमस् तदवस्थावधृतेस् तदवस्थावधृतेः |"}],"4.1":[{"r":"4.1.1","s":"āvṛttir asakṛdupadeśāt |","d":"आवृत्तिर् असकृदुपदेशात् |"},{"r":"4.1.2","s":"liṅgāc ca |","d":"लिङ्गाच् च |"},{"r":"4.1.3","s":"ātmeti tūpagacchanti grāhayanti ca |","d":"आत्मेति तूपगच्छन्ति ग्राहयन्ति च |"},{"r":"4.1.4","s":"na pratīke na hi saḥ |","d":"न प्रतीके न हि सः |"},{"r":"4.1.5","s":"brahmadṛṣṭir utkarṣāt |","d":"ब्रह्मदृष्टिर् उत्कर्षात् |"},{"r":"4.1.6","s":"ādityādimatayaś cāṅga upapatteḥ |","d":"आदित्यादिमतयश् चाङ्ग उपपत्तेः |"},{"r":"4.1.7","s":"āsīnaḥ saṃbhavāt |","d":"आसीनः संभवात् |"},{"r":"4.1.8","s":"dhyānāc ca |","d":"ध्यानाच् च |"},{"r":"4.1.9","s":"acalatvaṃ cāpekṣya |","d":"अचलत्वं चापेक्ष्य |"},{"r":"4.1.10","s":"smaranti ca |","d":"स्मरन्ति च |"},{"r":"4.1.11","s":"yatraikāgratā tatrāviśeṣāt |","d":"यत्रैकाग्रता तत्राविशेषात् |"},{"r":"4.1.12","s":"āprayāṇāt tatrāpi hi dṛṣṭam |","d":"आप्रयाणात् तत्रापि हि दृष्टम् |"},{"r":"4.1.13","s":"tadadhigama uttarapūrvāghayor aśleṣavināśau tadvyapadeśāt |","d":"तदधिगम उत्तरपूर्वाघयोर् अश्लेषविनाशौ तद्व्यपदेशात् |"},{"r":"4.1.14","s":"itarasyāpy evam asaṃśleṣaḥ pāte tu |","d":"इतरस्याप्य् एवम् असंश्लेषः पाते तु |"},{"r":"4.1.15","s":"anārabdhakārye eva tu pūrve tadavadheḥ |","d":"अनारब्धकार्ये एव तु पूर्वे तदवधेः |"},{"r":"4.1.16","s":"agnihotrādi tu tatkāryāyaiva taddarśanāt |","d":"अग्निहोत्रादि तु तत्कार्यायैव तद्दर्शनात् |"},{"r":"4.1.17","s":"ato 'nyāpi hy ekeṣām ubhayoḥ |","d":"अतो ऽन्यापि ह्य् एकेषाम् उभयोः |"},{"r":"4.1.18","s":"yad eva vidyayeti hi |","d":"यद् एव विद्ययेति हि |"},{"r":"4.1.19","s":"bhogena tv itare kṣapayitvātha saṃpadyate |","d":"भोगेन त्व् इतरे क्षपयित्वाथ संपद्यते |"}],"4.2":[{"r":"4.2.1","s":"vāṅmanasi darśanāc chabdāc ca |","d":"वाङ्मनसि दर्शनाच् छब्दाच् च |"},{"r":"4.2.2","s":"ata eva sarvāṇyanu |","d":"अत एव सर्वाण्यनु |"},{"r":"4.2.3","s":"tanmanaḥ prāṇa uttarāt |","d":"तन्मनः प्राण उत्तरात् |"},{"r":"4.2.4","s":"so 'dhyakṣe tadupagamādibhyaḥ |","d":"सो ऽध्यक्षे तदुपगमादिभ्यः |"},{"r":"4.2.5","s":"bhūteṣu tacchruteḥ |","d":"भूतेषु तच्छ्रुतेः |"},{"r":"4.2.6","s":"naikasmin darśayato hi |","d":"नैकस्मिन् दर्शयतो हि |"},{"r":"4.2.7","s":"samānā cāsṛtyupakramād amṛtatvaṃ cānupoṣya |","d":"समाना चासृत्युपक्रमाद् अमृतत्वं चानुपोष्य |"},{"r":"4.2.8","s":"tadāpīteḥ saṃsāravyapadeśāt |","d":"तदापीतेः संसारव्यपदेशात् |"},{"r":"4.2.9","s":"sūkṣmaṃ pramāṇataś ca tathopalabdheḥ |","d":"सूक्ष्मं प्रमाणतश् च तथोपलब्धेः |"},{"r":"4.2.10","s":"nopamardenātaḥ |","d":"नोपमर्देनातः |"},{"r":"4.2.11","s":"asyaiva copapatter ūṣmā |","d":"अस्यैव चोपपत्तेर् ऊष्मा |"},{"r":"4.2.12","s":"pratiṣedhād iti cen na śārīrāt spaṣṭo hyekeṣām |","d":"प्रतिषेधाद् इति चेन् न शारीरात् स्पष्टो ह्येकेषाम् |"},{"r":"4.2.13","s":"smaryate ca |","d":"स्मर्यते च |"},{"r":"4.2.14","s":"tāni pare tathā hy āha |","d":"तानि परे तथा ह्य् आह |"},{"r":"4.2.15","s":"avibhāgo vacanāt |","d":"अविभागो वचनात् |"},{"r":"4.2.16","s":"tadokograjvalanaṃ tatprakāśitadvāro vidyāsāmarthyāt taccheṣagatyanusmṛtiyogāc |","d":"तदोकोग्रज्वलनं तत्प्रकाशितद्वारो विद्यासामर्थ्यात् तच्छेषगत्यनुस्मृतियोगाच् |"},{"r":"4.2.17","s":"raśmyanusārī |","d":"रश्म्यनुसारी |"},{"r":"4.2.18","s":"niśi neti cen na sambandhasya yāvaddehabhāvitvād darśayati ca |","d":"निशि नेति चेन् न सम्बन्धस्य यावद्देहभावित्वाद् दर्शयति च |"},{"r":"4.2.19","s":"ataś cāyane 'pi dakṣiṇe |","d":"अतश् चायने ऽपि दक्षिणे |"},{"r":"4.2.20","s":"yoginaḥ prati smaryete smārte caite |","d":"योगिनः प्रति स्मर्येते स्मार्ते चैते |"}],"4.3":[{"r":"4.3.1","s":"arcirādinā tatprathiteḥ |","d":"अर्चिरादिना तत्प्रथितेः |"},{"r":"4.3.2","s":"vāyumabdādaviśeṣaviśeṣābhyām |","d":"वायुमब्दादविशेषविशेषाभ्याम् |"},{"r":"4.3.3","s":"taṭito 'dhi varuṇaḥ saṃbandhāt |","d":"तटितो ऽधि वरुणः संबन्धात् |"},{"r":"4.3.4","s":"ātivāhikās talliṅgāt |","d":"आतिवाहिकास् तल्लिङ्गात् |"},{"r":"4.3.5","s":"vaidyutenaiva tatas tacchruteḥ |","d":"वैद्युतेनैव ततस् तच्छ्रुतेः |"},{"r":"4.3.6","s":"kāryaṃ bādarirasya gatyupapatteḥ |","d":"कार्यं बादरिरस्य गत्युपपत्तेः |"},{"r":"4.3.7","s":"viśeṣitatvāc ca |","d":"विशेषितत्वाच् च |"},{"r":"4.3.8","s":"sāmīpyāt tu tadvyapadeśaḥ |","d":"सामीप्यात् तु तद्व्यपदेशः |"},{"r":"4.3.9","s":"kāryātyaye tadadhyakṣeṇa sahātaḥ param abhidhānāt |","d":"कार्यात्यये तदध्यक्षेण सहातः परम् अभिधानात् |"},{"r":"4.3.10","s":"smṛteś ca |","d":"स्मृतेश् च |"},{"r":"4.3.11","s":"paraṃ jaiminir mukhyatvāt |","d":"परं जैमिनिर् मुख्यत्वात् |"},{"r":"4.3.12","s":"darśanāc ca |","d":"दर्शनाच् च |"},{"r":"4.3.13","s":"na ca kārye pratyabhisandhiḥ |","d":"न च कार्ये प्रत्यभिसन्धिः |"},{"r":"4.3.14","s":"apratīkālambanān nayatīti bādarāyaṇa ubhayathā ca doṣāt tatkratuś ca |","d":"अप्रतीकालम्बनान् नयतीति बादरायण उभयथा च दोषात् तत्क्रतुश् च |"},{"r":"4.3.15","s":"viśeṣaṃ ca darśayati |","d":"विशेषं च दर्शयति |"}],"4.4":[{"r":"4.4.1","s":"saṃpadyāvirbhāvaḥ svena śabdāt |","d":"संपद्याविर्भावः स्वेन शब्दात् |"},{"r":"4.4.2","s":"muktaḥ pratijñānāt |","d":"मुक्तः प्रतिज्ञानात् |"},{"r":"4.4.3","s":"ātmā prakaraṇāt |","d":"आत्मा प्रकरणात् |"},{"r":"4.4.4","s":"avibhāgena dṛṣṭatvāt |","d":"अविभागेन दृष्टत्वात् |"},{"r":"4.4.5","s":"brāhmeṇa jaiminir upanyāsādibhyaḥ |","d":"ब्राह्मेण जैमिनिर् उपन्यासादिभ्यः |"},{"r":"4.4.6","s":"cititanmātreṇa tadātmakatvād ity auḍulomiḥ |","d":"चितितन्मात्रेण तदात्मकत्वाद् इत्य् औडुलोमिः |"},{"r":"4.4.7","s":"evam apy upanyāsāt pūrvabhāvād avirodhaṃ bādarāyaṇaḥ |","d":"एवम् अप्य् उपन्यासात् पूर्वभावाद् अविरोधं बादरायणः |"},{"r":"4.4.8","s":"saṃkalpād eva tacchruteḥ |","d":"संकल्पाद् एव तच्छ्रुतेः |"},{"r":"4.4.9","s":"ata eva cānanyādhipatiḥ |","d":"अत एव चानन्याधिपतिः |"},{"r":"4.4.10","s":"abhāvaṃ bādarir āha hy evam |","d":"अभावं बादरिर् आह ह्य् एवम् |"},{"r":"4.4.11","s":"bhāvaṃ jaiminir vikalpāmananāt |","d":"भावं जैमिनिर् विकल्पामननात् |"},{"r":"4.4.12","s":"dvādaśāhavad ubhayavidhaṃ bādarāyaṇo 'taḥ |","d":"द्वादशाहवद् उभयविधं बादरायणो ऽतः |"},{"r":"4.4.13","s":"tanvabhāve sandhyavad upapatteḥ |","d":"तन्वभावे सन्ध्यवद् उपपत्तेः |"},{"r":"4.4.14","s":"bhāve jāgradvat |","d":"भावे जाग्रद्वत् |"},{"r":"4.4.15","s":"pradīpavadāveśas tathā hi darśayati |","d":"प्रदीपवदावेशस् तथा हि दर्शयति |"},{"r":"4.4.16","s":"svāpyayasaṃpatyor anyatarāpekṣam āviṣkṛtaṃ hi |","d":"स्वाप्ययसंपत्योर् अन्यतरापेक्षम् आविष्कृतं हि |"},{"r":"4.4.17","s":"jagadvyāpāravarjaṃ prakaraṇād asaṃnihitatvāc ca |","d":"जगद्व्यापारवर्जं प्रकरणाद् असंनिहितत्वाच् च |"},{"r":"4.4.18","s":"pratyakṣopadeśād iti cen nādhikārikamaṇḍalasthokteḥ |","d":"प्रत्यक्षोपदेशाद् इति चेन् नाधिकारिकमण्डलस्थोक्तेः |"},{"r":"4.4.19","s":"vikārāvarti ca tathā hi sthitim āha |","d":"विकारावर्ति च तथा हि स्थितिम् आह |"},{"r":"4.4.20","s":"darśayataś caivaṃ pratyakṣānumāne |","d":"दर्शयतश् चैवं प्रत्यक्षानुमाने |"},{"r":"4.4.21","s":"bhogamātrasāmyaliṅgāc ca |","d":"भोगमात्रसाम्यलिङ्गाच् च |"},{"r":"4.4.22","s":"anāvṛttiḥ śabdād anāvṛttiḥ śabdāt |","d":"अनावृत्तिः शब्दाद् अनावृत्तिः शब्दात् |"}]}