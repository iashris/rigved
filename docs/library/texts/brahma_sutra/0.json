{"r":"2.4.6","s":"aṇavaś ca |","d":"अणवश् च |"},{"r":"2.4.7","s":"śreṣṭhaś ca |","d":"श्रेष्ठश् च |"},{"r":"2.4.8","s":"na vāyukriye pṛthagupadeśāt |","d":"न वायुक्रिये पृथगुपदेशात् |"},{"r":"2.4.9","s":"cakṣurādivat tu tatsahaśiṣṭyādibhyaḥ |","d":"चक्षुरादिवत् तु तत्सहशिष्ट्यादिभ्यः |"},{"r":"2.4.10","s":"akaraṇatvāc ca na doṣas tathā hi darśayati |","d":"अकरणत्वाच् च न दोषस् तथा हि दर्शयति |"},{"r":"2.4.11","s":"pañcavṛttir manovat vyapadiśyate |","d":"पञ्चवृत्तिर् मनोवत् व्यपदिश्यते |"},{"r":"2.4.12","s":"aṇuś ca |","d":"अणुश् च |"},{"r":"2.4.13","s":"jyotir ādyadhiṣṭhānaṃ tu tadāmananātprāṇavatā śabdāt |","d":"ज्योतिर् आद्यधिष्ठानं तु तदामननात्प्राणवता शब्दात् |"},{"r":"2.4.14","s":"tasya ca nityatvāt |","d":"तस्य च नित्यत्वात् |"},{"r":"2.4.15","s":"ta indriyāṇi tadvyapadeśād anyatra śreṣṭhāt |","d":"त इन्द्रियाणि तद्व्यपदेशाद् अन्यत्र श्रेष्ठात् |"},{"r":"2.4.16","s":"bhedaśruter vailakṣaṇyāc ca |","d":"भेदश्रुतेर् वैलक्षण्याच् च |"},{"r":"2.4.17","s":"saṃjñāmūrtikḷptis tu trivṛtkurvata upadeśāt |","d":"संज्ञामूर्तिकॢप्तिस् तु त्रिवृत्कुर्वत उपदेशात् |"},{"r":"2.4.18","s":"māṃsādi bhaumaṃ yathāśabdamitarayoś ca |","d":"मांसादि भौमं यथाशब्दमितरयोश् च |"},{"r":"2.4.19","s":"vaiśeṣyāt tu tadvādas tadvādaḥ |","d":"वैशेष्यात् तु तद्वादस् तद्वादः |"}],"3.1":[{"r":"3.1.1","s":"tadantarapratipattau raṃhati saṃpariṣvaktaḥ praśnanirūpaṇābhyām |","d":"तदन्तरप्रतिपत्तौ रंहति संपरिष्वक्तः प्रश्ननिरूपणाभ्याम् |"},{"r":"3.1.2","s":"tryātmakatvāt tu bhūyastvāt |","d":"त्र्यात्मकत्वात् तु भूयस्त्वात् |"},{"r":"3.1.3","s":"prāṇagateś ca |","d":"प्राणगतेश् च |"},{"r":"3.1.4","s":"agnyādiśruter iti cen na bhāktatvāt |","d":"अग्न्यादिश्रुतेर् इति चेन् न भाक्तत्वात् |"},{"r":"3.1.5","s":"prathame 'śravaṇād iti cen na tā eva hy upapatteḥ |","d":"प्रथमे ऽश्रवणाद् इति चेन् न ता एव ह्य् उपपत्तेः |"},{"r":"3.1.6","s":"aśrutatvād iti cen neṣṭādikāriṇāṃ pratīteḥ |","d":"अश्रुतत्वाद् इति चेन् नेष्टादिकारिणां प्रतीतेः |"},{"r":"3.1.7","s":"bhāktaṃ vānātmavittvāt tathā hi darśayati |","d":"भ