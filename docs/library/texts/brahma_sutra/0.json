{"1.1":[{"r":"1.1.1","s":"athāto brahmajijñāsā |","d":"अथातो ब्रह्मजिज्ञासा |"},{"r":"1.1.2","s":"janmādyasya yataḥ |","d":"जन्माद्यस्य यतः |"},{"r":"1.1.3","s":"śāstrayonitvāt |","d":"शास्त्रयोनित्वात् |"},{"r":"1.1.4","s":"tat tu samanvayāt |","d":"तत् तु समन्वयात् |"},{"r":"1.1.5","s":"īkṣater nāśabdam |","d":"ईक्षतेर् नाशब्दम् |"},{"r":"1.1.6","s":"gauṇaś cen nātmaśabdāt |","d":"गौणश् चेन् नात्मशब्दात् |"},{"r":"1.1.7","s":"tanniṣṭhasya mokṣopadeśāt |","d":"तन्निष्ठस्य मोक्षोपदेशात् |"},{"r":"1.1.8","s":"heyatvāvacanāc ca |","d":"हेयत्वावचनाच् च |"},{"r":"1.1.9","s":"pratijñāvirodhāt |","d":"प्रतिज्ञाविरोधात् |"},{"r":"1.1.10","s":"svāpyayāt |","d":"स्वाप्ययात् |"},{"r":"1.1.11","s":"gatisāmānyāt |","d":"गतिसामान्यात् |"},{"r":"1.1.12","s":"śrutatvāc ca |","d":"श्रुतत्वाच् च |"},{"r":"1.1.13","s":"ānandamayo 'bhyāsāt |","d":"आनन्दमयो ऽभ्यासात् |"},{"r":"1.1.14","s":"vikāraśabdān neti cen na prācuryāt |","d":"विकारशब्दान् नेति चेन् न प्राचुर्यात् |"},{"r":"1.1.15","s":"taddhetuvyapadeśāc ca |","d":"तद्धेतुव्यपदेशाच् च |"},{"r":"1.1.16","s":"māntravarṇikameva ca gīyate |","d":"मान्त्रवर्णिकमेव च गीयते |"},{"r":"1.1.17","s":"netaro 'nupapatteḥ |","d":"नेतरो ऽनुपपत्तेः |"},{"r":"1.1.18","s":"bhedavyapadeśāc ca |","d":"भेदव्यपदेशाच् च |"},{"r":"1.1.19","s":"kāmāc ca nānumānāpekṣā |","d":"कामाच् च नानुमानापेक्षा |"},{"r":"1.1.20","s":"asminn asya ca tadyogaṃ śāsti |","d":"अस्मिन्न् अस्य च तद्योगं शास्ति |"},{"r":"1.1.21","s":"antas taddharmopadeśāt |","d":"अन्तस् तद्धर्मोपदेशात् |"},{"r":"1.1.22","s":"bhedavyapadeśāc cānyaḥ |","d":"भेदव्यपदेशाच् चान्यः |"},{"r":"1.1.23","s":"ākāśas talliṅgāt |","d":"आकाशस् तल्लिङ्गात् |"},{"r":"1.1.24","s":"ata eva prāṇaḥ |","d":"अत एव प्राणः |"},{"r":"1.1.25","s":"jyotiś caraṇābhidhānāt |","d":"ज्योतिश् चरणाभिधानात् |"},{"r":"1.1.26","s":"chando 'bhidhānān neti cen na tathā ceto'rpaṇanigadāt tathā hi darśanam |","d":"छन्दो ऽभिधानान् नेति चेन् न तथा चेतोऽर्पणनिगदात् तथा हि दर्शनम् |"},{"r":"1.1.27","s":"bhūtādipādavyapadeśopapatteś caivam |","d":"भूतादिपादव्यपदेशोपपत्तेश् चैवम् |"},{"r":"1.1.28","s":"upadeśabhedān neti cen nobhayasminn apy avirodhāt |","d":"उपदेशभेदान् नेति चेन् नोभयस्मिन्न् अप्य् अविरोधात् |"},{"r":"1.1.29","s":"prāṇas tathānugamāt |","d":"प्राणस् तथानुगमात् |"},{"r":"1.1.30","s":"na vaktur ātmopadeśād iti ced adhyātmasaṃbandhabhūmā hy asmin |","d":"न वक्तुर् आत्मोपदेशाद् इति चेद् अध्यात्मसंबन्धभूमा ह्य् अस्मिन् |"},{"r":"1.1.31","s":"śāstradṛṣṭyā tūpadeśo vāmadevavat |","d":"शास्त्रदृष्ट्या तूपदेशो वामदेववत् |"},{"r":"1.1.32","s":"jīvamukhyaprāṇaliṅgān neti cen nopāsātraividhyādāśritatvād iha tadyogāt |","d":"जीवमुख्यप्राणलिङ्गान् नेति चेन् नोपासात्रैविध्यादाश्रितत्वाद् इह तद्योगात् |"}],"1.2":[{"r":"1.2.1","s":"sarvatra prasiddhopadeśāt |","d":"सर्वत्र प्रसिद्धोपदेशात् |"},{"r":"1.2.2","s":"vivakṣitaguṇopapatteś ca |","d":"विवक्षितगुणोपपत्तेश् च |"},{"r":"1.2.3","s":"anupapattes tu na śārīraḥ |","d":"अनुपपत्तेस् तु न शारीरः |"},{"r":"1.2.4","s":"karmakartṛvyapadeśāc ca |","d":"कर्मकर्तृव्यपदेशाच् च |"},{"r":"1.2.5","s":"śabdaviśeṣāt |","d":"शब्दविशेषात् |"},{"r":"1.2.6","s":"smṛteś ca |","d":"स्मृतेश् च |"},{"r":"1.2.7","s":"arbhakaustvāt tadvyapadeśāc ca neti cen na nicāyyatvād evaṃ vyomavac ca |","d":"अर्भकौस्त्वात् तद्व्यपदेशाच् च नेति चेन् न निचाय्यत्वाद् एवं व्योमवच् च |"},{"r":"1.2.8","s":"saṃbhogaprāptir iti cen na vaiśeṣyāt |","d":"संभोगप्राप्तिर् इति चेन् न वैशेष्यात् |"},{"r":"1.2.9","s":"attā carācaragrahaṇāt |","d":"अत्ता चराचरग्रहणात् |"},{"r":"1.2.10","s":"prakaraṇāc ca |","d":"प्रकरणाच् च |"},{"r":"1.2.11","s":"guhāṃ praviṣṭāv ātmānau hi taddarśanāt |","d":"गुहां प्रविष्टाव् आत्मानौ हि तद्दर्शनात् |"},{"r":"1.2.12","s":"viśeṣaṇāc ca |","d":"विशेषणाच् च |"},{"r":"1.2.13","s":"antara upapatteḥ |","d":"अन्तर उपपत्तेः |"},{"r":"1.2.14","s":"sthānādivyapadeśāc ca |","d":"स्थानादिव्यपदेशाच् च |"},{"r":"1.2.15","s":"sukhaviśiṣṭābhidhānād eva ca |","d":"सुखविशिष्टाभिधानाद् एव च |"},{"r":"1.2.16","s":"ata eva ca sa brahma |","d":"अत एव च स ब्रह्म |"},{"r":"1.2.17","s":"śrutopaniṣatkagatyabhidhānāc ca |","d":"श्रुतोपनिषत्कगत्यभिधानाच् च |"},{"r":"1.2.18","s":"anavasthiter asaṃbhavāc ca netaraḥ |","d":"अनवस्थितेर् असंभवाच् च नेतरः |"},{"r":"1.2.19","s":"antaryāmyadhidaivādhilokādiṣu taddharmavyapadeśāt |","d":"अन्तर्याम्यधिदैवाधिलोकादिषु तद्धर्मव्यपदेशात् |"},{"r":"1.2.20","s":"na ca smārtam ataddharmābhilāpāc chārīraś ca |","d":"न च स्मार्तम् अतद्धर्माभिलापाच् छारीरश् च |"},{"r":"1.2.21","s":"ubhaye 'pi hi bhedenainam adhīyate |","d":"उभये ऽपि हि भेदेनैनम् अधीयते |"},{"r":"1.2.22","s":"adṛśyatvādiguṇako dharmokteḥ |","d":"अदृश्यत्वादिगुणको धर्मोक्तेः |"},{"r":"1.2.23","s":"viśeṣaṇabhedavyapadeśābhyāṃ ca netarau |","d":"विशेषणभेदव्यपदेशाभ्यां च नेतरौ |"},{"r":"1.2.24","s":"rūpopanyāsāc ca |","d":"रूपोपन्यासाच् च |"},{"r":"1.2.25","s":"vaiśvānaraḥ sādhāraṇaśabdaviśeṣāt |","d":"वैश्वानरः साधारणशब्दविशेषात् |"},{"r":"1.2.26","s":"smaryamāṇam anumānaṃ syād iti |","d":"स्मर्यमाणम् अनुमानं स्याद् इति |"},{"r":"1.2.27","s":"śabdādibhyo 'ntaḥpratiṣṭhānāc ca neti cen na tathā dṛṣṭyupadeśād asambhavāt puruṣamapi cainam adhīyate |","d":"शब्दादिभ्यो ऽन्तःप्रतिष्ठानाच् च नेति चेन् न तथा दृष्ट्युपदेशाद् असम्भवात् पुरुषमपि चैनम् अधीयते |"},{"r":"1.2.28","s":"ata eva na devatā bhūtaṃ ca |","d":"अत एव न देवता भूतं च |"},{"r":"1.2.29","s":"sākṣād apy avirodhaṃ jaiminiḥ |","d":"साक्षाद् अप्य् अविरोधं जैमिनिः |"},{"r":"1.2.30","s":"abhivyakter ity āśmarathyaḥ |","d":"अभिव्यक्तेर् इत्य् आश्मरथ्यः |"},{"r":"1.2.31","s":"anusmṛter bādariḥ |","d":"अनुस्मृतेर् बादरिः |"},{"r":"1.2.32","s":"saṃpatter iti jaiminis tathā hi darśayati |","d":"संपत्तेर् इति जैमिनिस् तथा हि दर्शयति |"},{"r":"1.2.33","s":"āmananti cainam asmin |","d":"आमनन्ति चैनम् अस्मिन् |"}],"1.3":[{"r":"1.3.1","s":"dyubhvādyāyatanaṃ svaśabdāt |","d":"द्युभ्वाद्यायतनं स्वशब्दात् |"},{"r":"1.3.2","s":"muktopasṛpyavyapadeśāc ca |","d":"मुक्तोपसृप्यव्यपदेशाच् च |"},{"r":"1.3.3","s":"nānumānam atacchabdāt prāṇabhṛc ca |","d":"नानुमानम् अतच्छब्दात् प्राणभृच् च |"},{"r":"1.3.4","s":"bhedavyapadeśāt |","d":"भेदव्यपदेशात् |"},{"r":"1.3.5","s":"prakaraṇāt |","d":"प्रकरणात् |"},{"r":"1.3.6","s":"sthityadanābhyāṃ ca |","d":"स्थित्यदनाभ्यां च |"},{"r":"1.3.7","s":"bhūmā saṃprasādād adhyupadeśāt |","d":"भूमा संप्रसादाद् अध्युपदेशात् |"},{"r":"1.3.8","s":"dharmopapatteś ca |","d":"धर्मोपपत्तेश् च |"},{"r":"1.3.9","s":"akṣaram ambarāntadhṛteḥ |","d":"अक्षरम् अम्बरान्तधृतेः |"},{"r":"1.3.10","s":"sā ca praśāsanāt |","d":"सा च प्रशासनात् |"},{"r":"1.3.11","s":"anyabhāvavyāvṛtteśca |","d":"अन्यभावव्यावृत्तेश्च |"},{"r":"1.3.12","s":"īkṣatikarmavyapadeśāt saḥ |","d":"ईक्षतिकर्मव्यपदेशात् सः |"},{"r":"1.3.13","s":"dahara uttarebhyaḥ |","d":"दहर उत्तरेभ्यः |"},{"r":"1.3.14","s":"gatiśabdābhyāṃ tathā hi dṛṣṭaṃ liṅgaṃ ca |","d":"गतिशब्दाभ्यां तथा हि दृष्टं लिङ्गं च |"},{"r":"1.3.15","s":"dhṛteś ca mahimno 'syāsminn upalabdheḥ |","d":"धृतेश् च महिम्नो ऽस्यास्मिन्न् उपलब्धेः |"},{"r":"1.3.16","s":"prasiddheś ca |","d":"प्रसिद्धेश् च |"},{"r":"1.3.17","s":"itaraparāmarśāt sa iti cen nāsaṃbhavāt |","d":"इतरपरामर्शात् स इति चेन् नासंभवात् |"},{"r":"1.3.18","s":"uttarāc ced āvirbhūtasvarūpas tu |","d":"उत्तराच् चेद् आविर्भूतस्वरूपस् तु |"},{"r":"1.3.19","s":"anyārthaś ca parāmarśaḥ |","d":"अन्यार्थश् च परामर्शः |"},{"r":"1.3.20","s":"alpaśruter iti cet tad uktam |","d":"अल्पश्रुतेर् इति चेत् तद् उक्तम् |"},{"r":"1.3.21","s":"anukṛtes tasya ca |","d":"अनुकृतेस् तस्य च |"},{"r":"1.3.22","s":"api ca smaryate |","d":"अपि च स्मर्यते |"},{"r":"1.3.23","s":"śabdād eva pramitaḥ |","d":"शब्दाद् एव प्रमितः |"},{"r":"1.3.24","s":"hṛdyapekṣayā tu manuṣyādhikāratvāt |","d":"हृद्यपेक्षया तु मनुष्याधिकारत्वात् |"},{"r":"1.3.25","s":"tadupary api bādarāyaṇaḥ saṃbhavāt |","d":"तदुपर्य् अपि बादरायणः संभवात् |"},{"r":"1.3.26","s":"virodhaḥ karmaṇīti cen nānekapratipatter darśanāt |","d":"विरोधः कर्मणीति चेन् नानेकप्रतिपत्तेर् दर्शनात् |"},{"r":"1.3.27","s":"śabda iti cen nātaḥ prabhavāt pratyakṣānumānābhyām |","d":"शब्द इति चेन् नातः प्रभवात् प्रत्यक्षानुमानाभ्याम् |"},{"r":"1.3.28","s":"ata eva ca nit